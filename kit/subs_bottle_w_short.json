[{"s": 0.0, "e": 0.846, "t": "What if you never"}, {"s": 0.846, "e": 2.083, "t": "washed your reusable water"}, {"s": 2.083, "e": 2.937, "t": "bottle?"}, {"s": 7.521, "e": 8.929, "t": "Reusable bottles are great"}, {"s": 8.929, "e": 9.867, "t": "for the planet and"}, {"s": 9.867, "e": 11.019, "t": "save money too."}, {"s": 11.019, "e": 11.873, "t": "It's just water,"}, {"s": 11.873, "e": 12.47, "t": "right?"}, {"s": 12.47, "e": 13.537, "t": "Many people just refill"}, {"s": 13.537, "e": 14.561, "t": "it again and again"}, {"s": 14.561, "e": 15.414, "t": "for weeks."}, {"s": 19.998, "e": 21.15, "t": "But here's the twist."}, {"s": 21.15, "e": 22.43, "t": "Your mouth adds bacteria"}, {"s": 22.43, "e": 23.454, "t": "with every sip,"}, {"s": 23.454, "e": 24.435, "t": "and some lab tests"}, {"s": 24.435, "e": 25.545, "t": "found millions of germs"}, {"s": 25.545, "e": 26.526, "t": "on bottles that weren't"}, {"s": 26.526, "e": 27.251, "t": "washed."}, {"s": 27.251, "e": 28.446, "t": "Wash it every day!"}, {"s": 28.446, "e": 29.598, "t": "Use hot soapy water"}, {"s": 29.598, "e": 30.537, "t": "and a bottle brush,"}, {"s": 30.537, "e": 31.305, "t": "and let it dry"}, {"s": 31.305, "e": 32.115, "t": "fully."}, {"s": 32.115, "e": 33.182, "t": "Narrow necks and straw"}, {"s": 33.182, "e": 34.163, "t": "lids are the hardest"}, {"s": 34.163, "e": 35.102, "t": "spots to clean,"}, {"s": 35.102, "e": 35.827, "t": "so give them extra"}, {"s": 35.827, "e": 36.809, "t": "attention."}, {"s": 41.393, "e": 42.033, "t": "When did you last"}, {"s": 42.033, "e": 42.971, "t": "wash yours?"}, {"s": 42.971, "e": 43.782, "t": "Comment below,"}, {"s": 43.782, "e": 44.934, "t": "and subscribe for more!"}]