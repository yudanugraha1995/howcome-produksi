[{"s": 0.56, "e": 0.86, "t": "Oops,"}, {"s": 1.06, "e": 2.24, "t": "you swallowed a watermelon"}, {"s": 2.36, "e": 2.74, "t": "seed!"}, {"s": 2.98, "e": 3.96, "t": "What if a watermelon"}, {"s": 4.059, "e": 5.14, "t": "grew in your stomach?"}, {"s": 5.46, "e": 6.14, "t": "Relax,"}, {"s": 6.26, "e": 7.32, "t": "your stomach is dark,"}, {"s": 7.42, "e": 8.14, "t": "full of acid,"}, {"s": 8.22, "e": 9.34, "t": "and has no soil."}, {"s": 9.5, "e": 10.58, "t": "The seed just slides"}, {"s": 10.6, "e": 11.4, "t": "through and leaves in"}, {"s": 11.44, "e": 12.16, "t": "a day or so."}, {"s": 16.604, "e": 17.384, "t": "Plot twist!"}, {"s": 17.524, "e": 18.384, "t": "In many countries,"}, {"s": 18.484, "e": 19.624, "t": "people snack on roasted"}, {"s": 19.684, "e": 20.584, "t": "watermelon seeds,"}, {"s": 20.664, "e": 21.484, "t": "and they're packed with"}, {"s": 21.504, "e": 22.044, "t": "protein."}, {"s": 22.204, "e": 22.824, "t": "Do you spit them"}, {"s": 22.924, "e": 24.004, "t": "out or swallow them?"}, {"s": 24.204, "e": 24.644, "t": "Tell me in the"}, {"s": 24.684, "e": 25.244, "t": "comments!"}]