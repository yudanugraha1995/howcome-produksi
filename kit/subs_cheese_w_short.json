[{"s": 0.0, "e": 0.846, "t": "What if you ate"}, {"s": 0.846, "e": 2.51, "t": "cheese every single day?"}, {"s": 6.414, "e": 7.438, "t": "It's on pizza,"}, {"s": 7.438, "e": 9.443, "t": "burgers and sandwiches everywhere."}, {"s": 9.443, "e": 10.425, "t": "Cheese is loaded with"}, {"s": 10.425, "e": 11.747, "t": "calcium and protein,"}, {"s": 11.747, "e": 12.857, "t": "which help build strong"}, {"s": 12.857, "e": 14.137, "t": "bones and muscles."}, {"s": 14.137, "e": 15.801, "t": "Hard cheeses like parmesan"}, {"s": 15.801, "e": 16.825, "t": "are also very low"}, {"s": 16.825, "e": 17.849, "t": "in lactose."}, {"s": 21.753, "e": 22.947, "t": "But here's the twist."}, {"s": 22.947, "e": 23.843, "t": "Big studies found that"}, {"s": 23.843, "e": 24.483, "t": "people who eat a"}, {"s": 24.483, "e": 25.678, "t": "little cheese daily didn't"}, {"s": 25.678, "e": 26.531, "t": "have a higher heart"}, {"s": 26.531, "e": 27.043, "t": "risk,"}, {"s": 27.043, "e": 28.281, "t": "and some aged cheeses"}, {"s": 28.281, "e": 29.561, "t": "even contain good bacteria"}, {"s": 29.561, "e": 30.371, "t": "for your gut."}, {"s": 30.371, "e": 31.395, "t": "But cheese is also"}, {"s": 31.395, "e": 32.334, "t": "high in salt and"}, {"s": 32.334, "e": 33.315, "t": "saturated fat,"}, {"s": 33.315, "e": 35.065, "t": "so portion size matters."}, {"s": 35.065, "e": 35.918, "t": "One portion is about"}, {"s": 35.918, "e": 36.771, "t": "the size of three"}, {"s": 36.771, "e": 37.582, "t": "dice."}, {"s": 41.486, "e": 42.894, "t": "Mozzarella or cheddar?"}, {"s": 42.894, "e": 43.747, "t": "Comment below,"}, {"s": 43.747, "e": 44.942, "t": "and subscribe for more!"}]