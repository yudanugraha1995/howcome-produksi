[{"s": 0.0, "e": 0.96, "t": "Why does bread go"}, {"s": 1.04, "e": 1.8, "t": "stale?"}, {"s": 2.567, "e": 3.447, "t": "Most people think it"}, {"s": 3.567, "e": 4.807, "t": "just dries out."}, {"s": 5.414, "e": 6.494, "t": "But here's the surprising"}, {"s": 6.574, "e": 7.214, "t": "part:"}, {"s": 7.294, "e": 8.894, "t": "the starch inside slowly"}, {"s": 8.974, "e": 10.974, "t": "crystallizes and turns hard,"}, {"s": 11.054, "e": 11.854, "t": "even when the bread"}, {"s": 11.934, "e": 13.054, "t": "keeps its water."}, {"s": 13.134, "e": 14.094, "t": "That's why bread goes"}, {"s": 14.134, "e": 15.214, "t": "stale faster in the"}, {"s": 15.294, "e": 15.894, "t": "fridge!"}, {"s": 16.661, "e": 18.021, "t": "Toast or fresh?"}, {"s": 18.181, "e": 18.741, "t": "Comment,"}, {"s": 18.821, "e": 19.781, "t": "and subscribe!"}]