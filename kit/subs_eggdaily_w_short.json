[{"s": 0.0, "e": 0.675, "t": "What if you ate"}, {"s": 0.675, "e": 1.955, "t": "an egg every single"}, {"s": 1.955, "e": 2.51, "t": "day?"}, {"s": 3.566, "e": 4.206, "t": "It's one of the"}, {"s": 4.206, "e": 5.486, "t": "cheapest breakfasts on the"}, {"s": 5.486, "e": 6.254, "t": "planet."}, {"s": 6.254, "e": 7.278, "t": "One egg has about"}, {"s": 7.278, "e": 8.771, "t": "six grams of protein,"}, {"s": 8.771, "e": 9.966, "t": "plus vitamin D,"}, {"s": 9.966, "e": 11.331, "t": "B12 and choline for"}, {"s": 11.331, "e": 12.313, "t": "your brain."}, {"s": 12.313, "e": 13.337, "t": "The yolk holds most"}, {"s": 13.337, "e": 14.489, "t": "of those vitamins,"}, {"s": 14.489, "e": 15.769, "t": "so skipping it means"}, {"s": 15.769, "e": 17.219, "t": "skipping the good stuff."}, {"s": 18.275, "e": 19.598, "t": "But here's the twist."}, {"s": 19.598, "e": 20.537, "t": "Eggs were feared for"}, {"s": 20.537, "e": 22.457, "t": "their cholesterol for decades,"}, {"s": 22.457, "e": 23.779, "t": "but research now shows"}, {"s": 23.779, "e": 24.761, "t": "that for most healthy"}, {"s": 24.761, "e": 25.486, "t": "people,"}, {"s": 25.486, "e": 26.339, "t": "one egg a day"}, {"s": 26.339, "e": 27.491, "t": "doesn't raise heart disease"}, {"s": 27.491, "e": 28.174, "t": "risk."}, {"s": 28.174, "e": 29.198, "t": "For most people,"}, {"s": 29.198, "e": 30.435, "t": "the saturated fat in"}, {"s": 30.435, "e": 31.502, "t": "foods like bacon and"}, {"s": 31.502, "e": 33.593, "t": "butter affects blood cholesterol"}, {"s": 33.593, "e": 34.275, "t": "more than the egg"}, {"s": 34.275, "e": 35.171, "t": "itself."}, {"s": 35.171, "e": 36.281, "t": "If you have diabetes"}, {"s": 36.281, "e": 37.561, "t": "or high cholesterol,"}, {"s": 37.561, "e": 39.097, "t": "ask your doctor first."}, {"s": 40.153, "e": 41.219, "t": "Are you team boiled"}, {"s": 41.219, "e": 42.542, "t": "or team fried?"}, {"s": 42.542, "e": 43.523, "t": "Comment below,"}, {"s": 43.523, "e": 44.931, "t": "and subscribe for more!"}]