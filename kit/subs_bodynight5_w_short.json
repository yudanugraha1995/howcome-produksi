[{"s": 0.0, "e": 0.633, "t": "What if you could"}, {"s": 0.633, "e": 1.571, "t": "watch your body while"}, {"s": 1.571, "e": 2.553, "t": "you sleep?"}, {"s": 4.865, "e": 5.377, "t": "Every night,"}, {"s": 5.377, "e": 6.358, "t": "it does some very"}, {"s": 6.358, "e": 7.51, "t": "strange things."}, {"s": 7.51, "e": 8.065, "t": "One,"}, {"s": 8.065, "e": 9.601, "t": "your brain cleans itself,"}, {"s": 9.601, "e": 10.71, "t": "flushing out waste while"}, {"s": 10.71, "e": 11.777, "t": "you're deep asleep."}, {"s": 11.777, "e": 12.459, "t": "Two,"}, {"s": 12.459, "e": 13.654, "t": "your muscles go nearly"}, {"s": 13.654, "e": 15.062, "t": "paralyzed during dreams,"}, {"s": 15.062, "e": 15.745, "t": "so you don't act"}, {"s": 15.745, "e": 16.854, "t": "them out."}, {"s": 16.854, "e": 17.451, "t": "Three,"}, {"s": 17.451, "e": 18.475, "t": "you lose water just"}, {"s": 18.475, "e": 19.798, "t": "from breathing and sweating,"}, {"s": 19.798, "e": 20.31, "t": "so you wake up"}, {"s": 20.31, "e": 21.462, "t": "a little lighter."}, {"s": 23.774, "e": 25.139, "t": "But here's the twist."}, {"s": 25.139, "e": 25.779, "t": "Four,"}, {"s": 25.779, "e": 27.017, "t": "your body temperature drops"}, {"s": 27.017, "e": 28.169, "t": "by about one degree"}, {"s": 28.169, "e": 29.235, "t": "Celsius."}, {"s": 29.235, "e": 29.833, "t": "Five,"}, {"s": 29.833, "e": 30.942, "t": "that sudden falling feeling"}, {"s": 30.942, "e": 31.881, "t": "is called a hypnic"}, {"s": 31.881, "e": 32.35, "t": "jerk,"}, {"s": 32.35, "e": 33.075, "t": "and most people get"}, {"s": 33.075, "e": 34.142, "t": "it sometimes."}, {"s": 34.142, "e": 34.91, "t": "And you're actually a"}, {"s": 34.91, "e": 35.721, "t": "little taller in the"}, {"s": 35.721, "e": 36.318, "t": "morning,"}, {"s": 36.318, "e": 37.086, "t": "because your spine gets"}, {"s": 37.086, "e": 38.665, "t": "a break from gravity."}, {"s": 40.977, "e": 41.617, "t": "Have you ever felt"}, {"s": 41.617, "e": 42.769, "t": "that falling jerk?"}, {"s": 42.769, "e": 43.707, "t": "Comment below,"}, {"s": 43.707, "e": 44.944, "t": "and subscribe for more!"}]