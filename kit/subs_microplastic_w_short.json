[{"s": 0.0, "e": 1.102, "t": "What if you microwaved"}, {"s": 1.102, "e": 2.169, "t": "food in plastic every"}, {"s": 2.169, "e": 2.894, "t": "day?"}, {"s": 7.142, "e": 8.507, "t": "Leftovers in plastic tubs"}, {"s": 8.507, "e": 9.403, "t": "are a classic quick"}, {"s": 9.403, "e": 10.171, "t": "lunch."}, {"s": 10.171, "e": 11.75, "t": "It's super convenient."}, {"s": 11.75, "e": 12.774, "t": "Lots of containers even"}, {"s": 12.774, "e": 14.182, "t": "say microwave safe."}, {"s": 18.43, "e": 19.625, "t": "But here's the twist."}, {"s": 19.625, "e": 20.35, "t": "Heat can make some"}, {"s": 20.35, "e": 21.758, "t": "plastics release chemicals and"}, {"s": 21.758, "e": 22.867, "t": "tiny particles into your"}, {"s": 22.867, "e": 23.55, "t": "food,"}, {"s": 23.55, "e": 24.531, "t": "so experts say use"}, {"s": 24.531, "e": 26.707, "t": "glass or ceramic instead!"}, {"s": 26.707, "e": 28.03, "t": "Microwave safe usually means"}, {"s": 28.03, "e": 29.481, "t": "the container won't melt,"}, {"s": 29.481, "e": 30.206, "t": "not that nothing leaks"}, {"s": 30.206, "e": 31.401, "t": "into food."}, {"s": 31.401, "e": 32.382, "t": "One study found some"}, {"s": 32.382, "e": 33.833, "t": "plastic containers released millions"}, {"s": 33.833, "e": 34.857, "t": "of tiny particles in"}, {"s": 34.857, "e": 35.753, "t": "just three minutes of"}, {"s": 35.753, "e": 36.819, "t": "microwaving."}, {"s": 41.067, "e": 41.835, "t": "Do you microwave in"}, {"s": 41.835, "e": 42.646, "t": "plastic?"}, {"s": 42.646, "e": 43.542, "t": "Comment below,"}, {"s": 43.542, "e": 44.95, "t": "and subscribe for more!"}]