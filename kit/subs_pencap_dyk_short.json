[{"s": 0.0, "e": 1.12, "t": "Why do pen caps"}, {"s": 1.2, "e": 2.48, "t": "have a tiny hole?"}, {"s": 3.313, "e": 4.193, "t": "Most people think it"}, {"s": 4.353, "e": 5.153, "t": "stops the ink from"}, {"s": 5.233, "e": 5.953, "t": "drying out."}, {"s": 6.866, "e": 7.986, "t": "But here's the surprising"}, {"s": 8.066, "e": 8.706, "t": "part:"}, {"s": 8.786, "e": 9.706, "t": "the hole is a"}, {"s": 9.826, "e": 10.786, "t": "safety feature."}, {"s": 10.946, "e": 11.986, "t": "If a child swallows"}, {"s": 12.066, "e": 12.706, "t": "the cap,"}, {"s": 12.786, "e": 13.986, "t": "air can still pass"}, {"s": 14.186, "e": 14.586, "t": "through!"}, {"s": 15.379, "e": 16.019, "t": "Do you chew on"}, {"s": 16.099, "e": 16.899, "t": "pen caps?"}, {"s": 17.059, "e": 17.539, "t": "Comment,"}, {"s": 17.619, "e": 18.659, "t": "and subscribe!"}]