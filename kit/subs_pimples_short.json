[{"s": 0.7, "e": 1.5, "t": "A big pimple,"}, {"s": 1.84, "e": 2.86, "t": "right on your nose,"}, {"s": 3.1, "e": 4.0, "t": "the day before a"}, {"s": 4.04, "e": 4.38, "t": "party."}, {"s": 4.64, "e": 5.46, "t": "What if you popped"}, {"s": 5.56, "e": 6.6, "t": "every single pimple?"}, {"s": 6.8, "e": 7.66, "t": "Is it really that"}, {"s": 7.68, "e": 8.46, "t": "bad for your skin?"}, {"s": 8.9, "e": 9.64, "t": "A pimple is a"}, {"s": 9.7, "e": 10.96, "t": "pore clogged with oil,"}, {"s": 11.18, "e": 11.74, "t": "dead skin,"}, {"s": 11.84, "e": 12.62, "t": "and bacteria."}, {"s": 12.82, "e": 13.76, "t": "Your body sends white"}, {"s": 13.78, "e": 14.66, "t": "blood cells to fight"}, {"s": 14.7, "e": 14.78, "t": "it,"}, {"s": 14.94, "e": 15.62, "t": "and that's the pus"}, {"s": 15.7, "e": 16.06, "t": "you see."}, {"s": 16.94, "e": 17.72, "t": "Here's the problem."}, {"s": 17.88, "e": 18.6, "t": "When you squeeze,"}, {"s": 18.7, "e": 19.46, "t": "you can push that"}, {"s": 19.5, "e": 20.96, "t": "gunk and bacteria deeper"}, {"s": 21.02, "e": 21.76, "t": "into your skin."}, {"s": 21.94, "e": 23.06, "t": "That means more swelling,"}, {"s": 23.24, "e": 23.94, "t": "more redness,"}, {"s": 24.04, "e": 25.16, "t": "and sometimes a scar"}, {"s": 25.2, "e": 26.0, "t": "or a dark spot"}, {"s": 26.02, "e": 27.1, "t": "that stays for months."}, {"s": 27.38, "e": 28.38, "t": "Skin doctors say it's"}, {"s": 28.42, "e": 29.0, "t": "better to leave it"}, {"s": 29.04, "e": 29.48, "t": "alone,"}, {"s": 29.68, "e": 30.8, "t": "use a warm compress,"}, {"s": 30.9, "e": 31.48, "t": "or stick on a"}, {"s": 31.52, "e": 32.22, "t": "pimple patch."}, {"s": 32.44, "e": 33.02, "t": "And if a pimple"}, {"s": 33.08, "e": 34.06, "t": "is big and painful,"}, {"s": 34.34, "e": 35.02, "t": "see a doctor."}, {"s": 36.78, "e": 37.5, "t": "Plot twist!"}, {"s": 37.68, "e": 38.68, "t": "Blackheads aren't dirt at"}, {"s": 38.78, "e": 39.02, "t": "all."}, {"s": 39.22, "e": 40.12, "t": "That black color is"}, 