[{"s": 0.5, "e": 0.78, "t": "Ahh!"}, {"s": 1.02, "e": 1.8, "t": "Freezing water,"}, {"s": 1.98, "e": 2.58, "t": "first thing in the"}, {"s": 2.62, "e": 3.0, "t": "morning."}, {"s": 3.18, "e": 3.74, "t": "What if you took"}, {"s": 3.8, "e": 5.0, "t": "a cold shower every"}, {"s": 5.14, "e": 5.78, "t": "single day?"}, {"s": 5.9, "e": 6.86, "t": "Would it change anything,"}, {"s": 7.02, "e": 7.54, "t": "or is it just"}, {"s": 7.58, "e": 8.38, "t": "pain for nothing?"}, {"s": 8.56, "e": 9.68, "t": "Cold showers are all"}, {"s": 9.74, "e": 10.36, "t": "over the internet."}, {"s": 10.52, "e": 11.2, "t": "More energy,"}, {"s": 11.38, "e": 11.9, "t": "less fat,"}, {"s": 12.06, "e": 12.86, "t": "a tougher mind."}, {"s": 12.98, "e": 13.84, "t": "But what does real"}, {"s": 13.96, "e": 14.62, "t": "science say?"}, {"s": 14.98, "e": 15.86, "t": "The first seconds are"}, {"s": 15.92, "e": 16.44, "t": "a shock."}, {"s": 16.6, "e": 17.16, "t": "You gasp,"}, {"s": 17.3, "e": 17.94, "t": "breathe fast,"}, {"s": 18.02, "e": 19.06, "t": "and your heart races."}, {"s": 19.2, "e": 20.16, "t": "That's the cold shock"}, {"s": 20.2, "e": 20.7, "t": "response,"}, {"s": 20.9, "e": 21.64, "t": "so be careful if"}, {"s": 21.68, "e": 22.6, "t": "you have heart problems."}, {"s": 22.76, "e": 22.761, "t": "Now the real test."}, {"s": 22.8, "e": 22.821, "t": "In the Netherlands,"}, {"s": 22.821, "e": 24.22, "t": "about three thousand people"}, {"s": 24.26, "e": 25.34, "t": "ended their hot shower"}, {"s": 25.38, "e": 26.28, "t": "with cold water for"}, {"s": 26.34, "e": 26.72, "t": "a month."}, {"s": 26.88, "e": 27.78, "t": "The cold groups took"}, {"s": 27.82, "e": 29.14, "t": "about thirty percent fewer"}, {"s": 29.16, "e": 30.2, "t": "sick days off work."}, {"s": 30.3, "e": 31.02, "t": "But they didn't get"}, {"s": 31.1, "e": 32.02, "t": "sick less often."}, {"s": 32.14, "e": 32.96, "t": "They just felt okay"}, {"s": 33.02, "e": 33.94, "t": "enough to keep going."}, {"s": 34.06, "e": 35.06, "t": "People also said they"}, {"s": 35.08, "e": 35.96, "t": "felt more energy,"}, {"s": 36.08, "e": 36.94, "t": "and many kept doing"}, {"s": 36.98, "e": 37.74, "t": "it after the study"}, {"s": 37.8, "e": 38.16, "t": "ended."}, {"s": 39.052, "e": 39.892, "t": "Plot twist!"}, {"s": 40.012, "e": 40.752, "t": "It didn't matter how"}, {"s": 40.792, "e": 41.452, "t": "long they stayed in"}, {"s": 41.492, "e": 41.992, "t": "the cold."}, {"s": 42.112, "e": 43.252, "t": "Thirty seconds worked about"}, {"s": 43.292, "e": 44.172, "t": "as well as ninety."}, {"s": 44.352, "e": 44.852, "t": "So you don't need"}, {"s": 44.872, "e": 46.072, "t": "to freeze for ages."}, {"s": 46.252, "e": 47.132, "t": "Just finish your normal"}, {"s": 47.232, "e": 48.132, "t": "shower with a quick"}, {"s": 48.192, "e": 49.332, "t": "cold blast of water."}, {"s": 49.632, "e": 50.732, "t": "Team cold shower or"}, {"s": 50.852, "e": 51.792, "t": "team warm shower?"}, {"s": 51.932, "e": 52.332, "t": "Tell me in the"}, {"s": 52.372, "e": 52.792, "t": "comments,"}, {"s": 52.852, "e": 53.952, "t": "and subscribe for more"}, {"s": 53.992, "e": 54.672, "t": "HowCome!"}]