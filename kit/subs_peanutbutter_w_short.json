[{"s": 0.0, "e": 0.761, "t": "What if you ate"}, {"s": 0.761, "e": 1.913, "t": "peanut butter every single"}, {"s": 1.913, "e": 2.51, "t": "day?"}, {"s": 6.414, "e": 7.011, "t": "It's one of the"}, {"s": 7.011, "e": 8.121, "t": "most loved spreads in"}, {"s": 8.121, "e": 8.931, "t": "America."}, {"s": 8.931, "e": 10.126, "t": "Two tablespoons give you"}, {"s": 10.126, "e": 11.15, "t": "about seven grams of"}, {"s": 11.15, "e": 12.345, "t": "protein and healthy fats"}, {"s": 12.345, "e": 13.582, "t": "that keep you full."}, {"s": 13.582, "e": 15.203, "t": "Peanuts also have fiber,"}, {"s": 15.203, "e": 17.038, "t": "magnesium and vitamin E."}, {"s": 20.942, "e": 22.179, "t": "But here's the twist."}, {"s": 22.179, "e": 23.63, "t": "Those same two tablespoons"}, {"s": 23.63, "e": 24.739, "t": "have nearly two hundred"}, {"s": 24.739, "e": 25.465, "t": "calories,"}, {"s": 25.465, "e": 26.531, "t": "and many brands add"}, {"s": 26.531, "e": 27.214, "t": "sugar,"}, {"s": 27.214, "e": 28.75, "t": "salt and oils."}, {"s": 28.75, "e": 29.817, "t": "Experts say pick a"}, {"s": 29.817, "e": 30.841, "t": "jar with just peanuts"}, {"s": 30.841, "e": 31.822, "t": "and a little salt,"}, {"s": 31.822, "e": 32.675, "t": "and stir the oil"}, {"s": 32.675, "e": 33.571, "t": "back in."}, {"s": 33.571, "e": 34.297, "t": "And it's easy to"}, {"s": 34.297, "e": 35.15, "t": "eat way more than"}, {"s": 35.15, "e": 36.345, "t": "two tablespoons straight from"}, {"s": 36.345, "e": 37.326, "t": "the jar!"}, {"s": 41.23, "e": 42.723, "t": "Crunchy or smooth?"}, {"s": 42.723, "e": 43.662, "t": "Comment below,"}, {"s": 43.662, "e": 44.942, "t": "and subscribe for more!"}]