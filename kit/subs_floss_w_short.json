[{"s": 0.0, "e": 0.846, "t": "What if you never"}, {"s": 0.846, "e": 1.913, "t": "flossed?"}, {"s": 7.121, "e": 8.059, "t": "Lots of people only"}, {"s": 8.059, "e": 9.041, "t": "floss right before a"}, {"s": 9.041, "e": 10.107, "t": "dentist appointment."}, {"s": 10.107, "e": 11.43, "t": "Your toothbrush can't reach"}, {"s": 11.43, "e": 12.411, "t": "between your teeth."}, {"s": 12.411, "e": 13.649, "t": "That's exactly where food"}, {"s": 13.649, "e": 14.545, "t": "and plaque love to"}, {"s": 14.545, "e": 15.355, "t": "hide."}, {"s": 20.563, "e": 21.843, "t": "But here's the twist."}, {"s": 21.843, "e": 22.739, "t": "Plaque left there can"}, {"s": 22.739, "e": 23.849, "t": "harden into tartar,"}, {"s": 23.849, "e": 24.787, "t": "and gum disease can"}, {"s": 24.787, "e": 25.854, "t": "sneak in without any"}, {"s": 25.854, "e": 26.409, "t": "pain,"}, {"s": 26.409, "e": 27.134, "t": "and it's even been"}, {"s": 27.134, "e": 28.713, "t": "linked to heart disease!"}, {"s": 28.713, "e": 30.377, "t": "The American Dental Association"}, {"s": 30.377, "e": 31.443, "t": "says clean between your"}, {"s": 31.443, "e": 32.766, "t": "teeth once a day."}, {"s": 32.766, "e": 34.089, "t": "Water flossers and tiny"}, {"s": 34.089, "e": 35.155, "t": "brushes between the teeth"}, {"s": 35.155, "e": 36.222, "t": "count too."}, {"s": 41.43, "e": 42.113, "t": "Do you floss every"}, {"s": 42.113, "e": 42.795, "t": "day?"}, {"s": 42.795, "e": 43.691, "t": "Comment below,"}, {"s": 43.691, "e": 44.928, "t": "and subscribe for more!"}]