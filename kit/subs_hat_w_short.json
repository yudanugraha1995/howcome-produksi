[{"s": 0.0, "e": 0.675, "t": "What if you wore"}, {"s": 0.675, "e": 2.169, "t": "a hat every day?"}, {"s": 7.721, "e": 8.787, "t": "Baseball caps are worn"}, {"s": 8.787, "e": 9.811, "t": "by millions of people"}, {"s": 9.811, "e": 10.579, "t": "every day."}, {"s": 10.579, "e": 11.219, "t": "People say it makes"}, {"s": 11.219, "e": 12.414, "t": "you go bald."}, {"s": 12.414, "e": 13.097, "t": "This myth has been"}, {"s": 13.097, "e": 13.779, "t": "around for a long"}, {"s": 13.779, "e": 14.505, "t": "time."}, {"s": 20.057, "e": 21.294, "t": "But here's the twist."}, {"s": 21.294, "e": 22.403, "t": "That's a myth!"}, {"s": 22.403, "e": 23.598, "t": "Hats don't cause hair"}, {"s": 23.598, "e": 24.707, "t": "loss unless they're super"}, {"s": 24.707, "e": 25.39, "t": "tight and pull your"}, {"s": 25.39, "e": 25.902, "t": "hair,"}, {"s": 25.902, "e": 26.798, "t": "and they actually protect"}, {"s": 26.798, "e": 28.377, "t": "your scalp from sunburn!"}, {"s": 28.377, "e": 29.273, "t": "Most hair loss comes"}, {"s": 29.273, "e": 30.041, "t": "from genes,"}, {"s": 30.041, "e": 31.193, "t": "hormones and age,"}, {"s": 31.193, "e": 32.302, "t": "not your cap."}, {"s": 32.302, "e": 33.198, "t": "Wash your hat often"}, {"s": 33.198, "e": 33.795, "t": "though,"}, {"s": 33.795, "e": 34.777, "t": "because sweat and oil"}, {"s": 34.777, "e": 35.331, "t": "build up on the"}, {"s": 35.331, "e": 36.057, "t": "band."}, {"s": 41.609, "e": 42.761, "t": "Do you wear hats?"}, {"s": 42.761, "e": 43.699, "t": "Comment below,"}, {"s": 43.699, "e": 44.936, "t": "and subscribe for more!"}]