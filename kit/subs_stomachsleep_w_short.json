[{"s": 0.0, "e": 0.803, "t": "What if you slept"}, {"s": 0.803, "e": 1.699, "t": "on your stomach every"}, {"s": 1.699, "e": 2.297, "t": "night?"}, {"s": 2.839, "e": 3.692, "t": "Lots of people love"}, {"s": 3.692, "e": 4.46, "t": "it."}, {"s": 5.002, "e": 6.325, "t": "But here's the twist."}, {"s": 6.325, "e": 7.221, "t": "To breathe,"}, {"s": 7.221, "e": 7.903, "t": "you have to turn"}, {"s": 7.903, "e": 8.629, "t": "your head to the"}, {"s": 8.629, "e": 9.866, "t": "side for hours,"}, {"s": 9.866, "e": 10.805, "t": "which twists your neck"}, {"s": 10.805, "e": 11.999, "t": "and flattens the natural"}, {"s": 11.999, "e": 13.535, "t": "curve of your spine."}, {"s": 13.535, "e": 14.261, "t": "That's why it's called"}, {"s": 14.261, "e": 15.285, "t": "the hardest position on"}, {"s": 15.285, "e": 16.223, "t": "your back."}, {"s": 16.765, "e": 17.96, "t": "How do you sleep?"}, {"s": 17.96, "e": 18.856, "t": "Comment below,"}, {"s": 18.856, "e": 20.178, "t": "and subscribe for more!"}]