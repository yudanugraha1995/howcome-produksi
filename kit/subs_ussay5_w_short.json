[{"s": 0.0, "e": 0.846, "t": "What if you only"}, {"s": 0.846, "e": 1.998, "t": "spoke American English for"}, {"s": 1.998, "e": 2.894, "t": "a day?"}, {"s": 4.806, "e": 6.427, "t": "These phrases confuse visitors"}, {"s": 6.427, "e": 7.579, "t": "all the time."}, {"s": 7.579, "e": 8.262, "t": "One,"}, {"s": 8.262, "e": 9.286, "t": "how are you doing,"}, {"s": 9.286, "e": 10.779, "t": "which is just hello,"}, {"s": 10.779, "e": 12.145, "t": "not a real question."}, {"s": 12.145, "e": 12.699, "t": "Two,"}, {"s": 12.699, "e": 13.382, "t": "I'm good,"}, {"s": 13.382, "e": 14.577, "t": "which Americans say even"}, {"s": 14.577, "e": 15.729, "t": "when they're not."}, {"s": 15.729, "e": 16.283, "t": "Three,"}, {"s": 16.283, "e": 16.923, "t": "we should hang out"}, {"s": 16.923, "e": 17.521, "t": "sometime,"}, {"s": 17.521, "e": 18.417, "t": "which often isn't a"}, {"s": 18.417, "e": 19.441, "t": "real plan."}, {"s": 21.353, "e": 22.761, "t": "But here's the twist."}, {"s": 22.761, "e": 23.571, "t": "Four,"}, {"s": 23.571, "e": 24.51, "t": "Americans ask for the"}, {"s": 24.51, "e": 26.131, "t": "restroom or the bathroom,"}, {"s": 26.131, "e": 26.814, "t": "even when there's no"}, {"s": 26.814, "e": 28.265, "t": "bath and no rest."}, {"s": 28.265, "e": 28.905, "t": "Five,"}, {"s": 28.905, "e": 30.057, "t": "a quarter till four,"}, {"s": 30.057, "e": 31.038, "t": "which means three forty"}, {"s": 31.038, "e": 32.489, "t": "five and confuses lots"}, {"s": 32.489, "e": 33.641, "t": "of learners."}, {"s": 33.641, "e": 34.622, "t": "And in America,"}, {"s": 34.622, "e": 35.561, "t": "the first floor is"}, {"s": 35.561, "e": 36.627, "t": "the ground floor,"}, {"s": 36.627, "e": 37.523, "t": "while in the UK"}, {"s": 37.523, "e": 38.206, "t": "it's the one above"}, {"s": 38.206, "e": 38.761, "t": "it."}, {"s": 40.673, "e": 41.654, "t": "Do you say bathroom"}, {"s": 41.654, "e": 42.806, "t": "or toilet?"}, {"s": 42.806, "e": 43.659, "t": "Comment below,"}, {"s": 43.659, "e": 44.9