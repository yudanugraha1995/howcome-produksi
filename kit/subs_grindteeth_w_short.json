[{"s": 0.0, "e": 0.846, "t": "What if you ground"}, {"s": 0.846, "e": 2.211, "t": "your teeth every night?"}, {"s": 6.515, "e": 8.094, "t": "Doctors call it bruxism,"}, {"s": 8.094, "e": 9.289, "t": "and partners often notice"}, {"s": 9.289, "e": 11.038, "t": "the grinding sound first."}, {"s": 11.038, "e": 11.849, "t": "Most people who do"}, {"s": 11.849, "e": 13.129, "t": "it don't even know."}, {"s": 13.129, "e": 14.238, "t": "Stress and sleep problems"}, {"s": 14.238, "e": 15.39, "t": "can make it worse."}, {"s": 19.694, "e": 20.974, "t": "But here's the twist."}, {"s": 20.974, "e": 21.998, "t": "Your jaw can clench"}, {"s": 21.998, "e": 22.638, "t": "with a lot of"}, {"s": 22.638, "e": 23.833, "t": "force while you sleep,"}, {"s": 23.833, "e": 24.729, "t": "which can wear teeth"}, {"s": 24.729, "e": 25.283, "t": "down,"}, {"s": 25.283, "e": 25.966, "t": "crack them,"}, {"s": 25.966, "e": 27.118, "t": "and cause morning headaches"}, {"s": 27.118, "e": 28.27, "t": "and jaw pain."}, {"s": 28.27, "e": 29.081, "t": "A dentist can make"}, {"s": 29.081, "e": 29.763, "t": "a night guard to"}, {"s": 29.763, "e": 30.787, "t": "protect your teeth while"}, {"s": 30.787, "e": 31.683, "t": "you sleep."}, {"s": 31.683, "e": 32.835, "t": "Some people also clench"}, {"s": 32.835, "e": 33.689, "t": "during the day without"}, {"s": 33.689, "e": 34.329, "t": "noticing,"}, {"s": 34.329, "e": 35.523, "t": "especially when they're focused"}, {"s": 35.523, "e": 36.505, "t": "or stressed."}, {"s": 40.809, "e": 41.321, "t": "Do you wake up"}, {"s": 41.321, "e": 42.686, "t": "with a sore jaw?"}, {"s": 42.686, "e": 43.625, "t": "Comment below,"}, {"s": 43.625, "e": 44.947, "t": "and subscribe for more!"}]