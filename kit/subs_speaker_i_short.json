[{"s": 0.0, "e": 0.88, "t": "What if your smart"}, {"s": 0.96, "e": 2.8, "t": "speaker was always listening?"}, {"s": 3.993, "e": 5.033, "t": "It does listen,"}, {"s": 5.193, "e": 5.913, "t": "but only for its"}, {"s": 5.993, "e": 6.793, "t": "wake word."}, {"s": 6.953, "e": 7.513, "t": "After that,"}, {"s": 7.553, "e": 8.633, "t": "it records your request"}, {"s": 8.753, "e": 9.273, "t": "and sends it to"}, {"s": 9.313, "e": 10.073, "t": "the cloud."}, {"s": 11.026, "e": 11.826, "t": "Plot twist:"}, {"s": 11.866, "e": 12.706, "t": "you can review and"}, {"s": 12.906, "e": 13.906, "t": "delete those recordings in"}, {"s": 13.986, "e": 14.626, "t": "the app!"}, {"s": 15.499, "e": 16.459, "t": "Do you have one?"}, {"s": 16.659, "e": 16.912, "t": "Comment,"}, {"s": 16.966, "e": 17.899, "t": "and subscribe!"}]