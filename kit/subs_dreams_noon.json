[{"s": 0.22, "e": 1.22, "t": "You had a wild"}, {"s": 1.3, "e": 1.7, "t": "dream,"}, {"s": 1.84, "e": 3.48, "t": "but now it's gone."}, {"s": 4.6, "e": 5.68, "t": "What if you remembered"}, {"s": 6.04, "e": 6.86, "t": "every dream?"}, {"s": 15.833, "e": 17.133, "t": "You dream several times"}, {"s": 17.213, "e": 17.793, "t": "every night,"}, {"s": 17.973, "e": 19.333, "t": "mostly in REM sleep."}, {"s": 19.653, "e": 20.673, "t": "But your brain forgets"}, {"s": 20.753, "e": 22.073, "t": "most dreams within minutes"}, {"s": 22.113, "e": 22.833, "t": "of waking up."}, {"s": 31.466, "e": 32.186, "t": "Plot twist!"}, {"s": 32.526, "e": 34.166, "t": "People born blind still"}, {"s": 34.306, "e": 34.706, "t": "dream."}, {"s": 35.066, "e": 36.406, "t": "They dream in sounds,"}, {"s": 36.666, "e": 37.086, "t": "smells,"}, {"s": 37.246, "e": 38.406, "t": "and touch instead of"}, {"s": 38.446, "e": 38.966, "t": "pictures!"}, {"s": 47.659, "e": 48.619, "t": "Your weirdest dream?"}, {"s": 48.939, "e": 49.359, "t": "Tell me in the"}, {"s": 49.399, "e": 49.899, "t": "comments!"}]