[{"s": 0.0, "e": 0.8, "t": "Why does the moon"}, {"s": 0.88, "e": 1.8, "t": "look bigger near the"}, {"s": 1.84, "e": 2.72, "t": "horizon?"}, {"s": 3.553, "e": 4.433, "t": "Most people think it's"}, {"s": 4.553, "e": 5.193, "t": "closer."}, {"s": 5.986, "e": 7.186, "t": "But here's the surprising"}, {"s": 7.266, "e": 7.906, "t": "part:"}, {"s": 7.986, "e": 8.946, "t": "it's not bigger at"}, {"s": 9.106, "e": 9.346, "t": "all."}, {"s": 9.746, "e": 10.546, "t": "Take a photo,"}, {"s": 10.626, "e": 11.426, "t": "and it's the same"}, {"s": 11.506, "e": 12.146, "t": "size."}, {"s": 12.306, "e": 13.266, "t": "It's an illusion your"}, {"s": 13.346, "e": 14.466, "t": "brain creates!"}, {"s": 15.219, "e": 16.259, "t": "Have you noticed this?"}, {"s": 16.419, "e": 16.899, "t": "Comment,"}, {"s": 16.939, "e": 18.019, "t": "and subscribe!"}]