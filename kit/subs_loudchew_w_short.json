[{"s": 0.0, "e": 0.889, "t": "What if you chewed"}, {"s": 0.889, "e": 2.425, "t": "loudly every day?"}, {"s": 7.697, "e": 8.337, "t": "Chewing is one of"}, {"s": 8.337, "e": 9.489, "t": "the most normal sounds"}, {"s": 9.489, "e": 10.854, "t": "at any dinner table."}, {"s": 10.854, "e": 11.707, "t": "You might not even"}, {"s": 11.707, "e": 12.561, "t": "notice it."}, {"s": 12.561, "e": 13.713, "t": "Crunchy snacks and gum"}, {"s": 13.713, "e": 14.31, "t": "can be heard from"}, {"s": 14.31, "e": 15.462, "t": "across a room."}, {"s": 20.734, "e": 22.057, "t": "But here's the twist."}, {"s": 22.057, "e": 23.721, "t": "For people with misophonia,"}, {"s": 23.721, "e": 24.83, "t": "chewing sounds can trigger"}, {"s": 24.83, "e": 26.494, "t": "real anger or panic,"}, {"s": 26.494, "e": 27.177, "t": "like a fight or"}, {"s": 27.177, "e": 27.945, "t": "flight alarm in the"}, {"s": 27.945, "e": 28.713, "t": "brain!"}, {"s": 28.713, "e": 29.95, "t": "Scientists found their brains"}, {"s": 29.95, "e": 31.102, "t": "react more strongly to"}, {"s": 31.102, "e": 32.425, "t": "these trigger sounds."}, {"s": 32.425, "e": 33.705, "t": "Some people with misophonia"}, {"s": 33.705, "e": 34.686, "t": "even wear headphones at"}, {"s": 34.686, "e": 35.753, "t": "meals to cope."}, {"s": 41.025, "e": 42.177, "t": "Does loud chewing bother"}, {"s": 42.177, "e": 42.603, "t": "you?"}, {"s": 42.603, "e": 43.542, "t": "Comment below,"}, {"s": 43.542, "e": 44.95, "t": "and subscribe for more!"}]