[{"s": 0.0, "e": 0.803, "t": "What if you never"}, {"s": 0.803, "e": 2.723, "t": "replaced your kitchen sponge?"}, {"s": 6.339, "e": 7.449, "t": "A kitchen sponge gets"}, {"s": 7.449, "e": 8.771, "t": "used on almost every"}, {"s": 8.771, "e": 10.051, "t": "dish in the house."}, {"s": 10.051, "e": 11.374, "t": "It still looks fine."}, {"s": 11.374, "e": 12.142, "t": "It's wet,"}, {"s": 12.142, "e": 12.91, "t": "warm and full of"}, {"s": 12.91, "e": 13.891, "t": "food bits."}, {"s": 17.507, "e": 19.043, "t": "But here's the twist."}, {"s": 19.043, "e": 20.622, "t": "Scientists found used sponges"}, {"s": 20.622, "e": 21.518, "t": "can hold billions of"}, {"s": 21.518, "e": 22.926, "t": "bacteria in a tiny"}, {"s": 22.926, "e": 23.523, "t": "space,"}, {"s": 23.523, "e": 24.974, "t": "and microwaving them doesn't"}, {"s": 24.974, "e": 26.211, "t": "fully fix it."}, {"s": 26.211, "e": 27.278, "t": "Replace it every week"}, {"s": 27.278, "e": 28.089, "t": "or two!"}, {"s": 28.089, "e": 29.198, "t": "A dirty sponge can"}, {"s": 29.198, "e": 30.094, "t": "spread germs to your"}, {"s": 30.094, "e": 31.502, "t": "plates and counters every"}, {"s": 31.502, "e": 32.697, "t": "time you wipe."}, {"s": 32.697, "e": 33.977, "t": "Some people swap sponges"}, {"s": 33.977, "e": 34.873, "t": "for brushes,"}, {"s": 34.873, "e": 36.067, "t": "which dry faster and"}, {"s": 36.067, "e": 37.561, "t": "hold fewer germs."}, {"s": 41.177, "e": 41.859, "t": "When did you change"}, {"s": 41.859, "e": 42.713, "t": "yours?"}, {"s": 42.713, "e": 43.566, "t": "Comment below,"}, {"s": 43.566, "e": 44.931, "t": "and subscribe for more!"}]