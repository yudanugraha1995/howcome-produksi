[{"s": 0.0, "e": 0.803, "t": "What if you brushed"}, {"s": 0.803, "e": 1.87, "t": "your teeth really hard"}, {"s": 1.87, "e": 2.894, "t": "every day?"}, {"s": 7.59, "e": 8.955, "t": "Hard bristle toothbrushes are"}, {"s": 8.955, "e": 9.766, "t": "still sold in lots"}, {"s": 9.766, "e": 10.79, "t": "of stores."}, {"s": 10.79, "e": 12.582, "t": "It feels extra clean."}, {"s": 12.582, "e": 13.563, "t": "Many people think more"}, {"s": 13.563, "e": 15.355, "t": "pressure means cleaner teeth."}, {"s": 20.051, "e": 21.374, "t": "But here's the twist."}, {"s": 21.374, "e": 22.526, "t": "Scrubbing hard can wear"}, {"s": 22.526, "e": 23.55, "t": "away enamel and push"}, {"s": 23.55, "e": 24.617, "t": "your gums back,"}, {"s": 24.617, "e": 25.427, "t": "so dentists say use"}, {"s": 25.427, "e": 26.366, "t": "a soft brush and"}, {"s": 26.366, "e": 27.902, "t": "gentle little circles!"}, {"s": 27.902, "e": 28.755, "t": "Two minutes,"}, {"s": 28.755, "e": 29.566, "t": "twice a day,"}, {"s": 29.566, "e": 30.718, "t": "with gentle pressure,"}, {"s": 30.718, "e": 32.126, "t": "is all you need."}, {"s": 32.126, "e": 33.534, "t": "Some electric toothbrushes even"}, {"s": 33.534, "e": 34.345, "t": "have a sensor that"}, {"s": 34.345, "e": 35.027, "t": "warns you when you"}, {"s": 35.027, "e": 36.265, "t": "push too hard."}, {"s": 40.961, "e": 42.582, "t": "Soft or hard brush?"}, {"s": 42.582, "e": 43.563, "t": "Comment below,"}, {"s": 43.563, "e": 44.928, "t": "and subscribe for more!"}]