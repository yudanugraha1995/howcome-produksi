[{"s": 0.0, "e": 0.718, "t": "What if you ate"}, {"s": 0.718, "e": 2.382, "t": "a banana every single"}, {"s": 2.382, "e": 3.193, "t": "day?"}, {"s": 5.785, "e": 6.254, "t": "It's one of the"}, {"s": 6.254, "e": 7.406, "t": "most eaten fruits on"}, {"s": 7.406, "e": 8.43, "t": "the planet."}, {"s": 8.43, "e": 9.369, "t": "One banana gives you"}, {"s": 9.369, "e": 10.265, "t": "potassium,"}, {"s": 10.265, "e": 12.142, "t": "fiber and vitamin B6,"}, {"s": 12.142, "e": 13.081, "t": "and it's an easy"}, {"s": 13.081, "e": 14.361, "t": "energy boost."}, {"s": 14.361, "e": 15.555, "t": "That potassium helps your"}, {"s": 15.555, "e": 16.75, "t": "muscles and heart work"}, {"s": 16.75, "e": 17.603, "t": "properly."}, {"s": 20.195, "e": 21.475, "t": "But here's the twist."}, {"s": 21.475, "e": 23.566, "t": "Bananas are slightly radioactive"}, {"s": 23.566, "e": 24.931, "t": "because of their potassium,"}, {"s": 24.931, "e": 25.614, "t": "but you'd need to"}, {"s": 25.614, "e": 27.022, "t": "eat millions at once"}, {"s": 27.022, "e": 27.491, "t": "for it to be"}, {"s": 27.491, "e": 28.558, "t": "dangerous."}, {"s": 28.558, "e": 29.923, "t": "Scientists even joke about"}, {"s": 29.923, "e": 31.331, "t": "the banana equivalent dose"}, {"s": 31.331, "e": 32.995, "t": "to explain radiation."}, {"s": 32.995, "e": 34.233, "t": "Your body also keeps"}, {"s": 34.233, "e": 35.939, "t": "potassium levels balanced,"}, {"s": 35.939, "e": 37.049, "t": "so extra just gets"}, {"s": 37.049, "e": 38.115, "t": "flushed out."}, {"s": 40.707, "e": 42.542, "t": "Green or yellow bananas?"}, {"s": 42.542, "e": 43.481, "t": "Comment below,"}, {"s": 43.481, "e": 44.931, "t": "and subscribe for more!"}]