[{"s": 0.18, "e": 1.56, "t": "Ten thousand steps."}, {"s": 2.42, "e": 2.82, "t": "Every."}, {"s": 3.54, "e": 4.019, "t": "Single."}, {"s": 4.66, "e": 4.96, "t": "Day."}, {"s": 5.78, "e": 6.62, "t": "Your watch says it's"}, {"s": 6.66, "e": 7.46, "t": "the magic number,"}, {"s": 7.6, "e": 8.5, "t": "and it buzzes when"}, {"s": 8.52, "e": 8.94, "t": "you hit it."}, {"s": 9.24, "e": 9.84, "t": "But what would it"}, {"s": 10.08, "e": 10.92, "t": "really do to your"}, {"s": 10.96, "e": 11.3, "t": "body?"}, {"s": 11.86, "e": 12.8, "t": "And the big one."}, {"s": 13.16, "e": 14.08, "t": "A huge study of"}, {"s": 14.16, "e": 15.74, "t": "about fifty thousand adults"}, {"s": 15.78, "e": 16.84, "t": "found that more steps"}, {"s": 16.94, "e": 18.02, "t": "meant a lower risk"}, {"s": 18.06, "e": 18.88, "t": "of dying early."}, {"s": 19.18, "e": 20.18, "t": "But the benefit leveled"}, {"s": 20.28, "e": 20.52, "t": "off,"}, {"s": 20.78, "e": 21.68, "t": "around six to eight"}, {"s": 21.72, "e": 22.86, "t": "thousand steps for people"}, {"s": 22.92, "e": 23.58, "t": "over sixty,"}, {"s": 23.86, "e": 24.56, "t": "and eight to ten"}, {"s": 24.62, "e": 26.1, "t": "thousand for younger adults."}, {"s": 26.58, "e": 27.8, "t": "So more is better,"}, {"s": 28.1, "e": 28.76, "t": "but only up to"}, {"s": 28.8, "e": 29.28, "t": "a point."}, {"s": 32.58, "e": 33.28, "t": "Plot twist!"}, {"s": 33.64, "e": 34.8, "t": "Ten thousand didn't come"}, {"s": 34.84, "e": 35.52, "t": "from science."}, {"s": 35.86, "e": 36.44, "t": "It came from a"}, {"s": 36.48, "e": 37.94, "t": "Japanese pedometer sold in"}, {"s": 37.98, "e": 39.12, "t": "the nineteen sixties,"}, {"s": 39.36, "e": 40.4, "t": "whose name meant ten"}, {"s": 40.5, "e": 41.68, "t": "thousand steps meter."}, {"s": 42.1, "e": 42.88, "t": "Great marketing,"}, {"s": 43.0, "e": 44.32, "t": "but every extra step"}, {"s": 44.36, "e": 44.78, "t": "helps!"}, {"s": 45.26, "e": 46.08, "t": "Even going from two"}, {"s": 46.16, "e": 47.38, "t": "thousand to four thousand"}, {"s": 47.46, "e": 48.54, "t": "makes a real difference."}, {"s": 49.0, "e": 49.76, "t": "How many steps did"}, {"s": 49.78, "e": 50.44, "t": "you walk today?"}, {"s": 50.72, "e": 51.16, "t": "Tell me in the"}, {"s": 51.2, "e": 51.62, "t": "comments,"}, {"s": 51.66, "e": 52.759, "t": "and subscribe for more"}, {"s": 52.8, "e": 53.38, "t": "HowCome!"}]