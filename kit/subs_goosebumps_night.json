[{"s": 0.56, "e": 1.06, "t": "Brr!"}, {"s": 1.36, "e": 2.32, "t": "Tiny bumps on your"}, {"s": 2.4, "e": 2.72, "t": "arms."}, {"s": 3.1, "e": 3.76, "t": "What if you got"}, {"s": 3.8, "e": 6.08, "t": "goosebumps every single day?"}, {"s": 15.693, "e": 16.473, "t": "Each bump is a"}, {"s": 16.533, "e": 17.773, "t": "tiny muscle pulling a"}, {"s": 17.833, "e": 18.773, "t": "hair straight up."}, {"s": 18.993, "e": 20.333, "t": "For our furry ancestors,"}, {"s": 20.433, "e": 21.293, "t": "that puffed up their"}, {"s": 21.333, "e": 22.253, "t": "fur to stay warm."}, {"s": 31.566, "e": 32.286, "t": "Plot twist!"}, {"s": 32.486, "e": 33.006, "t": "In mice,"}, {"s": 33.206, "e": 34.486, "t": "those same tiny muscles"}, {"s": 34.526, "e": 35.386, "t": "help wake up hair"}, {"s": 35.466, "e": 35.826, "t": "growth."}, {"s": 36.026, "e": 36.886, "t": "And a great song"}, {"s": 36.906, "e": 37.926, "t": "can give you goosebumps"}, {"s": 37.966, "e": 38.286, "t": "too!"}, {"s": 47.579, "e": 48.779, "t": "What gives you goosebumps?"}, {"s": 49.019, "e": 49.439, "t": "Tell me in the"}, {"s": 49.479, "e": 49.939, "t": "comments!"}]