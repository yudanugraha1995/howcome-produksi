[{"s": 0.0, "e": 0.761, "t": "What if you chewed"}, {"s": 0.761, "e": 1.87, "t": "on your pen every"}, {"s": 1.87, "e": 2.979, "t": "single day?"}, {"s": 7.619, "e": 8.899, "t": "Students and office workers"}, {"s": 8.899, "e": 10.094, "t": "do it the most."}, {"s": 10.094, "e": 10.777, "t": "Lots of people do"}, {"s": 10.777, "e": 11.715, "t": "it while thinking,"}, {"s": 11.715, "e": 12.569, "t": "and it can feel"}, {"s": 12.569, "e": 13.337, "t": "calming."}, {"s": 13.337, "e": 14.19, "t": "Chewing is a common"}, {"s": 14.19, "e": 15.342, "t": "way people release nervous"}, {"s": 15.342, "e": 16.11, "t": "energy."}, {"s": 20.75, "e": 22.03, "t": "But here's the twist."}, {"s": 22.03, "e": 23.182, "t": "Pens can carry tons"}, {"s": 23.182, "e": 24.035, "t": "of germs,"}, {"s": 24.035, "e": 25.187, "t": "and biting hard plastic"}, {"s": 25.187, "e": 26.126, "t": "can crack teeth and"}, {"s": 26.126, "e": 27.619, "t": "wear down fillings."}, {"s": 27.619, "e": 28.771, "t": "Swallowing a broken pen"}, {"s": 28.771, "e": 29.582, "t": "cap is also a"}, {"s": 29.582, "e": 30.691, "t": "real choking risk,"}, {"s": 30.691, "e": 32.27, "t": "especially for kids."}, {"s": 32.27, "e": 33.251, "t": "That's why many pen"}, {"s": 33.251, "e": 34.147, "t": "caps have a tiny"}, {"s": 34.147, "e": 35.043, "t": "hole in the top,"}, {"s": 35.043, "e": 36.323, "t": "to let air through."}, {"s": 40.963, "e": 41.603, "t": "Are you a pen"}, {"s": 41.603, "e": 42.371, "t": "chewer?"}, {"s": 42.371, "e": 43.395, "t": "Comment below,"}, {"s": 43.395, "e": 44.931, "t": "and subscribe for more!"}]