[{"s": 0.0, "e": 1.44, "t": "Why do microwaves heat"}, {"s": 1.52, "e": 2.56, "t": "food unevenly?"}, {"s": 3.527, "e": 5.047, "t": "Microwaves bounce around and"}, {"s": 5.127, "e": 6.407, "t": "create hot and cold"}, {"s": 6.687, "e": 7.127, "t": "spots."}, {"s": 7.287, "e": 8.167, "t": "That's why the plate"}, {"s": 8.247, "e": 8.807, "t": "spins."}, {"s": 9.534, "e": 10.734, "t": "But here's the surprising"}, {"s": 10.814, "e": 11.454, "t": "part:"}, {"s": 11.534, "e": 12.894, "t": "microwaves don't cook from"}, {"s": 12.974, "e": 13.854, "t": "the inside out."}, {"s": 14.094, "e": 15.134, "t": "They mostly heat the"}, {"s": 15.214, "e": 16.574, "t": "outer layer first!"}, {"s": 17.301, "e": 18.061, "t": "Do you stir?"}, {"s": 18.261, "e": 18.741, "t": "Comment,"}, {"s": 18.821, "e": 19.781, "t": "and subscribe!"}]