[{"s": 0.0, "e": 0.889, "t": "What if you didn't"}, {"s": 0.889, "e": 2.169, "t": "shower for a week?"}, {"s": 5.273, "e": 6.382, "t": "Your body makes sweat"}, {"s": 6.382, "e": 7.619, "t": "and skin oil every"}, {"s": 7.619, "e": 8.686, "t": "single day."}, {"s": 8.686, "e": 9.539, "t": "At first,"}, {"s": 9.539, "e": 10.862, "t": "you'd just feel greasy."}, {"s": 10.862, "e": 11.673, "t": "Your scalp would get"}, {"s": 11.673, "e": 13.251, "t": "oily and itchy too."}, {"s": 16.355, "e": 17.678, "t": "But here's the twist."}, {"s": 17.678, "e": 19.47, "t": "Sweat itself doesn't smell."}, {"s": 19.47, "e": 20.323, "t": "The smell comes from"}, {"s": 20.323, "e": 21.689, "t": "bacteria on your skin"}, {"s": 21.689, "e": 22.713, "t": "eating that sweat,"}, {"s": 22.713, "e": 23.865, "t": "and after a week,"}, {"s": 23.865, "e": 24.931, "t": "dead skin can even"}, {"s": 24.931, "e": 25.699, "t": "build up in dark"}, {"s": 25.699, "e": 26.723, "t": "patches!"}, {"s": 26.723, "e": 28.131, "t": "Dermatologists say most people"}, {"s": 28.131, "e": 29.667, "t": "are fine showering daily"}, {"s": 29.667, "e": 30.862, "t": "or every other day,"}, {"s": 30.862, "e": 31.502, "t": "as long as you"}, {"s": 31.502, "e": 32.953, "t": "wash the sweaty spots."}, {"s": 32.953, "e": 33.977, "t": "Rinsing off sweat after"}, {"s": 33.977, "e": 35.257, "t": "the gym matters most,"}, {"s": 35.257, "e": 36.238, "t": "because sweaty skin is"}, {"s": 36.238, "e": 37.433, "t": "where acne and rashes"}, {"s": 37.433, "e": 38.115, "t": "start."}, {"s": 41.219, "e": 41.987, "t": "How often do you"}, {"s": 41.987, "e": 42.755, "t": "shower?"}, {"s": 42.755, "e": 43.737, "t": "Comment below,"}, {"s": 43.737, "e": 44.931, "t": "and subscribe for more!"}]