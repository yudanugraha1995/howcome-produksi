[{"s": 0.0, "e": 0.846, "t": "What if you never"}, {"s": 0.846, "e": 2.211, "t": "wore sunscreen?"}, {"s": 4.467, "e": 5.491, "t": "Many people only put"}, {"s": 5.491, "e": 6.473, "t": "on sunscreen at the"}, {"s": 6.473, "e": 7.198, "t": "beach."}, {"s": 7.198, "e": 7.966, "t": "You might just get"}, {"s": 7.966, "e": 9.246, "t": "a nice tan."}, {"s": 9.246, "e": 10.526, "t": "UV rays reach your"}, {"s": 10.526, "e": 11.806, "t": "skin even on cloudy"}, {"s": 11.806, "e": 12.531, "t": "days."}, {"s": 14.787, "e": 15.982, "t": "But here's the twist."}, {"s": 15.982, "e": 17.177, "t": "Up to ninety percent"}, {"s": 17.177, "e": 18.627, "t": "of visible skin aging,"}, {"s": 18.627, "e": 19.779, "t": "like wrinkles and dark"}, {"s": 19.779, "e": 20.419, "t": "spots,"}, {"s": 20.419, "e": 21.571, "t": "comes from the sun,"}, {"s": 21.571, "e": 22.467, "t": "and a study found"}, {"s": 22.467, "e": 23.961, "t": "daily sunscreen users had"}, {"s": 23.961, "e": 25.497, "t": "no detectable increase in"}, {"s": 25.497, "e": 26.777, "t": "skin aging!"}, {"s": 26.777, "e": 28.825, "t": "Dermatologists say use SPF"}, {"s": 28.825, "e": 30.062, "t": "thirty or higher every"}, {"s": 30.062, "e": 30.574, "t": "day,"}, {"s": 30.574, "e": 31.683, "t": "and reapply every two"}, {"s": 31.683, "e": 33.219, "t": "hours outside."}, {"s": 33.219, "e": 34.585, "t": "Sunscreen also lowers your"}, {"s": 34.585, "e": 35.907, "t": "risk of skin cancer,"}, {"s": 35.907, "e": 37.017, "t": "the most common cancer"}, {"s": 37.017, "e": 38.382, "t": "in the United States."}, {"s": 40.638, "e": 41.705, "t": "Do you wear sunscreen"}, {"s": 41.705, "e": 42.601, "t": "every day?"}, {"s": 42.601, "e": 43.582, "t": "Comment below,"}, {"s": 43.582, "e": 44.947, "t": "and subscribe for more!"}]