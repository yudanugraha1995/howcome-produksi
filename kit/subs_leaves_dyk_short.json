[{"s": 0.0, "e": 1.12, "t": "Why do leaves change"}, {"s": 1.2, "e": 2.32, "t": "color in fall?"}, {"s": 3.153, "e": 4.353, "t": "Leaves are green because"}, {"s": 4.393, "e": 5.313, "t": "of chlorophyll,"}, {"s": 5.393, "e": 6.353, "t": "which makes food from"}, {"s": 6.433, "e": 6.993, "t": "sunlight."}, {"s": 7.986, "e": 9.106, "t": "But here's the surprising"}, {"s": 9.186, "e": 9.826, "t": "part:"}, {"s": 9.906, "e": 11.026, "t": "the yellow and orange"}, {"s": 11.106, "e": 12.706, "t": "hid there all summer."}, {"s": 12.786, "e": 14.066, "t": "When chlorophyll fades,"}, {"s": 14.186, "e": 15.346, "t": "they finally show!"}, {"s": 16.339, "e": 17.459, "t": "Fall or spring?"}, {"s": 17.779, "e": 18.339, "t": "Comment,"}, {"s": 18.379, "e": 19.379, "t": "and subscribe!"}]