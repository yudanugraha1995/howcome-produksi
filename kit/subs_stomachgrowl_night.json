[{"s": 0.68, "e": 1.26, "t": "Grrrr!"}, {"s": 1.54, "e": 2.8, "t": "In a quiet class!"}, {"s": 2.98, "e": 3.76, "t": "What if your stomach"}, {"s": 3.82, "e": 5.18, "t": "growled all day long?"}, {"s": 15.36, "e": 16.18, "t": "That sound is your"}, {"s": 16.22, "e": 17.26, "t": "gut squeezing air and"}, {"s": 17.3, "e": 17.96, "t": "liquid along."}, {"s": 18.1, "e": 18.72, "t": "When you're empty,"}, {"s": 18.9, "e": 20.02, "t": "a cleaning wave sweeps"}, {"s": 20.04, "e": 21.02, "t": "through about every hour"}, {"s": 21.06, "e": 21.4, "t": "or two,"}, {"s": 21.64, "e": 22.42, "t": "and it's loud."}, {"s": 32.52, "e": 33.18, "t": "Plot twist!"}, {"s": 33.3, "e": 34.42, "t": "Your stomach growls even"}, {"s": 34.44, "e": 35.02, "t": "when you're full."}, {"s": 35.16, "e": 36.12, "t": "It's just quieter with"}, {"s": 36.16, "e": 36.78, "t": "food inside."}, {"s": 47.0, "e": 47.76, "t": "When does your stomach"}, {"s": 47.8, "e": 48.82, "t": "growl the loudest?"}, {"s": 48.96, "e": 49.36, "t": "Tell me in the"}, {"s": 49.4, "e": 49.9, "t": "comments!"}]