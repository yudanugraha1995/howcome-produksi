[{"s": 0.0, "e": 0.803, "t": "What if you ate"}, {"s": 0.803, "e": 1.998, "t": "cereal for breakfast every"}, {"s": 1.998, "e": 2.51, "t": "morning?"}, {"s": 5.734, "e": 6.459, "t": "It's quick,"}, {"s": 6.459, "e": 7.441, "t": "cheap and kids love"}, {"s": 7.441, "e": 8.038, "t": "it."}, {"s": 8.038, "e": 9.361, "t": "Many cereals are fortified"}, {"s": 9.361, "e": 10.214, "t": "with iron,"}, {"s": 10.214, "e": 11.238, "t": "B vitamins and folic"}, {"s": 11.238, "e": 11.835, "t": "acid,"}, {"s": 11.835, "e": 12.603, "t": "and with milk you"}, {"s": 12.603, "e": 14.011, "t": "get calcium too."}, {"s": 14.011, "e": 15.334, "t": "Whole grain cereals also"}, {"s": 15.334, "e": 16.187, "t": "add fiber,"}, {"s": 16.187, "e": 16.998, "t": "which keeps you full"}, {"s": 16.998, "e": 17.937, "t": "longer."}, {"s": 21.161, "e": 22.526, "t": "But here's the twist."}, {"s": 22.526, "e": 23.635, "t": "Some kids' cereals are"}, {"s": 23.635, "e": 24.574, "t": "more than half sugar"}, {"s": 24.574, "e": 25.385, "t": "by weight,"}, {"s": 25.385, "e": 26.409, "t": "and most people pour"}, {"s": 26.409, "e": 27.219, "t": "way more than one"}, {"s": 27.219, "e": 28.03, "t": "serving."}, {"s": 28.03, "e": 29.054, "t": "A big cereal bowl"}, {"s": 29.054, "e": 30.078, "t": "can easily hold two"}, {"s": 30.078, "e": 31.145, "t": "or three servings without"}, {"s": 31.145, "e": 32.254, "t": "you noticing."}, {"s": 32.254, "e": 33.619, "t": "Experts suggest picking one"}, {"s": 33.619, "e": 34.771, "t": "with more fiber and"}, {"s": 34.771, "e": 35.753, "t": "less than about six"}, {"s": 35.753, "e": 36.649, "t": "grams of sugar per"}, {"s": 36.649, "e": 37.587, "t": "serving."}, {"s": 40.811, "e": 42.049, "t": "Cereal first or milk"}, {"s": 42.049, "e": 42.817, "t": "first?"}, {"s": 42.817, "e": 43.755, "t": "Comment below,"}, {"s": 43.755, "e": 44.95, "t": "and subscribe for more!"}]