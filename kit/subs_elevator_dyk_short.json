[{"s": 0.0, "e": 1.2, "t": "Why do elevators have"}, {"s": 1.36, "e": 2.12, "t": "mirrors?"}, {"s": 2.913, "e": 3.873, "t": "Most people think it's"}, {"s": 3.953, "e": 4.593, "t": "just to check your"}, {"s": 4.793, "e": 5.153, "t": "hair."}, {"s": 5.906, "e": 7.026, "t": "But here's the surprising"}, {"s": 7.106, "e": 7.746, "t": "part:"}, {"s": 7.906, "e": 9.506, "t": "mirrors make small spaces"}, {"s": 9.586, "e": 10.466, "t": "feel bigger,"}, {"s": 10.546, "e": 11.346, "t": "so the wait feels"}, {"s": 11.426, "e": 11.826, "t": "shorter."}, {"s": 12.146, "e": 13.346, "t": "They also help wheelchair"}, {"s": 13.426, "e": 14.706, "t": "users see behind them!"}, {"s": 15.619, "e": 16.099, "t": "Do you check the"}, {"s": 16.179, "e": 16.699, "t": "mirror?"}, {"s": 16.899, "e": 17.379, "t": "Comment,"}, {"s": 17.459, "e": 18.499, "t": "and subscribe!"}]