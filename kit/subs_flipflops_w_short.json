[{"s": 0.0, "e": 0.761, "t": "What if you wore"}, {"s": 0.761, "e": 2.211, "t": "flip flops every day?"}, {"s": 7.483, "e": 8.166, "t": "Flip flops are one"}, {"s": 8.166, "e": 9.147, "t": "of the most popular"}, {"s": 9.147, "e": 10.214, "t": "shoes in summer."}, {"s": 10.214, "e": 11.665, "t": "They're easy and breezy."}, {"s": 11.665, "e": 12.518, "t": "They're perfect for the"}, {"s": 12.518, "e": 13.713, "t": "beach and the pool."}, {"s": 18.985, "e": 20.051, "t": "But here's the twist."}, {"s": 20.051, "e": 20.819, "t": "Your toes have to"}, {"s": 20.819, "e": 21.587, "t": "grip just to keep"}, {"s": 21.587, "e": 22.27, "t": "them on,"}, {"s": 22.27, "e": 23.166, "t": "which changes how you"}, {"s": 23.166, "e": 23.678, "t": "walk,"}, {"s": 23.678, "e": 24.574, "t": "and with almost no"}, {"s": 24.574, "e": 25.342, "t": "arch support,"}, {"s": 25.342, "e": 25.939, "t": "it can lead to"}, {"s": 25.939, "e": 26.963, "t": "heel pain and sore"}, {"s": 26.963, "e": 27.774, "t": "feet!"}, {"s": 27.774, "e": 29.097, "t": "Podiatrists say save them"}, {"s": 29.097, "e": 30.035, "t": "for short walks and"}, {"s": 30.035, "e": 31.187, "t": "wear supportive shoes for"}, {"s": 31.187, "e": 32.169, "t": "long days."}, {"s": 32.169, "e": 33.363, "t": "Flip flops also offer"}, {"s": 33.363, "e": 34.558, "t": "almost no protection if"}, {"s": 34.558, "e": 35.369, "t": "something falls on your"}, {"s": 35.369, "e": 36.051, "t": "toes."}, {"s": 41.323, "e": 42.774, "t": "Flip flops or sneakers?"}, {"s": 42.774, "e": 43.713, "t": "Comment below,"}, {"s": 43.713, "e": 44.95, "t": "and subscribe for more!"}]