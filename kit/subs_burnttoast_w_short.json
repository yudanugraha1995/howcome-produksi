[{"s": 0.0, "e": 0.803, "t": "What if you ate"}, {"s": 0.803, "e": 2.553, "t": "burnt toast every day?"}, {"s": 6.057, "e": 6.697, "t": "Toast is one of"}, {"s": 6.697, "e": 7.977, "t": "the most popular breakfasts"}, {"s": 7.977, "e": 9.043, "t": "in the world."}, {"s": 9.043, "e": 10.025, "t": "A little crunch never"}, {"s": 10.025, "e": 10.409, "t": "hurt,"}, {"s": 10.409, "e": 11.219, "t": "right?"}, {"s": 11.219, "e": 11.987, "t": "Lots of people like"}, {"s": 11.987, "e": 13.011, "t": "their toast dark and"}, {"s": 13.011, "e": 13.779, "t": "crispy."}, {"s": 17.283, "e": 18.606, "t": "But here's the twist."}, {"s": 18.606, "e": 19.63, "t": "Burnt toast has more"}, {"s": 19.63, "e": 20.441, "t": "acrylamide,"}, {"s": 20.441, "e": 21.422, "t": "a chemical linked to"}, {"s": 21.422, "e": 23.086, "t": "cancer in animal studies,"}, {"s": 23.086, "e": 24.067, "t": "so the UK food"}, {"s": 24.067, "e": 25.305, "t": "agency says go for"}, {"s": 25.305, "e": 26.03, "t": "golden,"}, {"s": 26.03, "e": 27.523, "t": "not dark brown!"}, {"s": 27.523, "e": 28.803, "t": "It forms when starchy"}, {"s": 28.803, "e": 29.785, "t": "foods like bread and"}, {"s": 29.785, "e": 30.979, "t": "fries cook at very"}, {"s": 30.979, "e": 32.046, "t": "high heat."}, {"s": 32.046, "e": 32.686, "t": "Coffee,"}, {"s": 32.686, "e": 33.923, "t": "chips and fries also"}, {"s": 33.923, "e": 35.161, "t": "contain acrylamide,"}, {"s": 35.161, "e": 36.057, "t": "so it's about not"}, {"s": 36.057, "e": 37.294, "t": "overdoing it."}, {"s": 40.798, "e": 42.505, "t": "Light or dark toast?"}, {"s": 42.505, "e": 43.571, "t": "Comment below,"}, {"s": 43.571, "e": 44.936, "t": "and subscribe for more!"}]