[{"s": 0.0, "e": 1.2, "t": "Why do batteries die"}, {"s": 1.36, "e": 2.68, "t": "faster in the cold?"}, {"s": 3.473, "e": 5.073, "t": "The chemical reactions inside"}, {"s": 5.153, "e": 6.273, "t": "slow down when it's"}, {"s": 6.393, "e": 7.073, "t": "freezing,"}, {"s": 7.153, "e": 8.433, "t": "so less power comes"}, {"s": 8.513, "e": 8.993, "t": "out."}, {"s": 9.826, "e": 10.946, "t": "But here's the surprising"}, {"s": 11.026, "e": 11.666, "t": "part:"}, {"s": 11.746, "e": 13.426, "t": "the energy isn't gone."}, {"s": 13.666, "e": 14.386, "t": "Warm it up,"}, {"s": 14.506, "e": 15.106, "t": "and much of it"}, {"s": 15.266, "e": 16.026, "t": "comes back!"}, {"s": 16.819, "e": 17.699, "t": "Has your phone died"}, {"s": 17.779, "e": 18.659, "t": "in the cold?"}, {"s": 18.859, "e": 19.219, "t": "Comment,"}, {"s": 19.259, "e": 20.259, "t": "and subscribe!"}]