[{"s": 0.0, "e": 1.04, "t": "Why does a spoon"}, {"s": 1.16, "e": 2.48, "t": "look bent in water?"}, {"s": 3.313, "e": 4.753, "t": "Light changes direction when"}, {"s": 4.833, "e": 5.953, "t": "it moves from water"}, {"s": 6.073, "e": 6.833, "t": "into air."}, {"s": 7.666, "e": 8.786, "t": "But here's the surprising"}, {"s": 8.866, "e": 9.506, "t": "part:"}, {"s": 9.586, "e": 11.186, "t": "light actually slows down"}, {"s": 11.266, "e": 12.146, "t": "by about a quarter"}, {"s": 12.226, "e": 13.106, "t": "in water,"}, {"s": 13.186, "e": 14.546, "t": "and that slowdown bends"}, {"s": 14.626, "e": 15.106, "t": "it!"}, {"s": 15.779, "e": 16.419, "t": "Did you try this"}, {"s": 16.459, "e": 17.299, "t": "as a kid?"}, {"s": 17.499, "e": 17.779, "t": "Comment,"}, {"s": 17.859, "e": 18.819, "t": "and subscribe!"}]