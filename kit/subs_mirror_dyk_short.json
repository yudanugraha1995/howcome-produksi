[{"s": 0.0, "e": 1.22, "t": "Why do mirrors flip"}, {"s": 1.28, "e": 2.32, "t": "left and right?"}, {"s": 3.393, "e": 4.593, "t": "Raise your right hand,"}, {"s": 4.673, "e": 5.873, "t": "and your reflection seems"}, {"s": 5.953, "e": 7.153, "t": "to raise its left."}, {"s": 7.986, "e": 9.026, "t": "But here's the surprising"}, {"s": 9.186, "e": 9.906, "t": "part:"}, {"s": 9.986, "e": 11.426, "t": "mirrors don't flip left"}, {"s": 11.466, "e": 12.386, "t": "and right at all."}, {"s": 12.546, "e": 13.506, "t": "They flip front to"}, {"s": 13.586, "e": 14.066, "t": "back!"}, {"s": 15.059, "e": 15.699, "t": "Did this blow your"}, {"s": 15.779, "e": 16.299, "t": "mind?"}, {"s": 16.499, "e": 16.979, "t": "Comment,"}, {"s": 17.019, "e": 18.099, "t": "and subscribe!"}]