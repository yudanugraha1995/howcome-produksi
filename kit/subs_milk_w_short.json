[{"s": 0.0, "e": 0.889, "t": "What if you drank"}, {"s": 0.889, "e": 2.211, "t": "milk every day?"}, {"s": 6.059, "e": 6.913, "t": "Kids are often told"}, {"s": 6.913, "e": 7.894, "t": "to drink milk for"}, {"s": 7.894, "e": 8.918, "t": "strong bones."}, {"s": 8.918, "e": 10.113, "t": "It's packed with calcium"}, {"s": 10.113, "e": 11.478, "t": "and protein."}, {"s": 11.478, "e": 12.502, "t": "One glass has about"}, {"s": 12.502, "e": 13.654, "t": "three hundred milligrams of"}, {"s": 13.654, "e": 14.593, "t": "calcium."}, {"s": 18.441, "e": 19.763, "t": "But here's the twist."}, {"s": 19.763, "e": 20.659, "t": "About two thirds of"}, {"s": 20.659, "e": 21.683, "t": "adults around the world"}, {"s": 21.683, "e": 23.475, "t": "have trouble digesting lactose,"}, {"s": 23.475, "e": 24.457, "t": "the natural sugar in"}, {"s": 24.457, "e": 24.969, "t": "milk,"}, {"s": 24.969, "e": 26.163, "t": "so for many people,"}, {"s": 26.163, "e": 27.401, "t": "milk means a grumbling"}, {"s": 27.401, "e": 28.254, "t": "stomach!"}, {"s": 28.254, "e": 29.278, "t": "Lactose free milk and"}, {"s": 29.278, "e": 30.473, "t": "yogurt are often much"}, {"s": 30.473, "e": 31.881, "t": "easier to digest."}, {"s": 31.881, "e": 32.947, "t": "In places like Northern"}, {"s": 32.947, "e": 33.587, "t": "Europe,"}, {"s": 33.587, "e": 34.697, "t": "most adults can digest"}, {"s": 34.697, "e": 36.019, "t": "milk just fine,"}, {"s": 36.019, "e": 37.47, "t": "thanks to their genes."}, {"s": 41.318, "e": 42.043, "t": "Does milk work for"}, {"s": 42.043, "e": 42.769, "t": "you?"}, {"s": 42.769, "e": 43.665, "t": "Comment below,"}, {"s": 43.665, "e": 44.944, "t": "and subscribe for more!"}]