[{"s": 0.0, "e": 0.974, "t": "What if you swallowed"}, {"s": 0.974, "e": 2.51, "t": "toothpaste every day?"}, {"s": 6.814, "e": 8.777, "t": "Most toothpaste contains fluoride,"}, {"s": 8.777, "e": 10.398, "t": "which helps prevent cavities."}, {"s": 10.398, "e": 11.294, "t": "A tiny bit happens"}, {"s": 11.294, "e": 12.147, "t": "to everyone."}, {"s": 12.147, "e": 13.385, "t": "Adults should spit,"}, {"s": 13.385, "e": 14.238, "t": "not swallow,"}, {"s": 14.238, "e": 14.793, "t": "and you don't even"}, {"s": 14.793, "e": 16.03, "t": "need to rinse."}, {"s": 20.334, "e": 21.742, "t": "But here's the twist."}, {"s": 21.742, "e": 22.723, "t": "That's why kids under"}, {"s": 22.723, "e": 23.577, "t": "three should use only"}, {"s": 23.577, "e": 24.686, "t": "a rice grain sized"}, {"s": 24.686, "e": 25.411, "t": "smear,"}, {"s": 25.411, "e": 26.478, "t": "because swallowing too much"}, {"s": 26.478, "e": 27.63, "t": "fluoride while teeth grow"}, {"s": 27.63, "e": 29.123, "t": "can cause white spots!"}, {"s": 29.123, "e": 29.977, "t": "For kids three to"}, {"s": 29.977, "e": 30.531, "t": "six,"}, {"s": 30.531, "e": 31.513, "t": "a pea sized amount"}, {"s": 31.513, "e": 32.409, "t": "is enough."}, {"s": 32.409, "e": 33.305, "t": "If a kid swallows"}, {"s": 33.305, "e": 34.627, "t": "a lot of toothpaste,"}, {"s": 34.627, "e": 35.865, "t": "call poison control right"}, {"s": 35.865, "e": 36.462, "t": "away."}, {"s": 40.766, "e": 41.662, "t": "How much toothpaste do"}, {"s": 41.662, "e": 42.686, "t": "you use?"}, {"s": 42.686, "e": 43.625, "t": "Comment below,"}, {"s": 43.625, "e": 44.947, "t": "and subscribe for more!"}]