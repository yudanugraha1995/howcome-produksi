[{"s": 0.0, "e": 0.931, "t": "What if you picked"}, {"s": 0.931, "e": 2.169, "t": "every scab?"}, {"s": 6.529, "e": 7.766, "t": "Scabs usually form within"}, {"s": 7.766, "e": 8.662, "t": "a day after a"}, {"s": 8.662, "e": 9.899, "t": "cut or scrape."}, {"s": 9.899, "e": 10.667, "t": "A scab is your"}, {"s": 10.667, "e": 12.203, "t": "body's natural bandage."}, {"s": 12.203, "e": 13.227, "t": "It's made of dried"}, {"s": 13.227, "e": 14.337, "t": "blood and platelets that"}, {"s": 14.337, "e": 15.617, "t": "seal the wound."}, {"s": 19.977, "e": 21.257, "t": "But here's the twist."}, {"s": 21.257, "e": 22.323, "t": "Picking it reopens the"}, {"s": 22.323, "e": 22.963, "t": "wound,"}, {"s": 22.963, "e": 24.073, "t": "lets germs in,"}, {"s": 24.073, "e": 24.926, "t": "and makes a scar"}, {"s": 24.926, "e": 25.993, "t": "more likely,"}, {"s": 25.993, "e": 26.931, "t": "so leaving it alone"}, {"s": 26.931, "e": 28.681, "t": "helps it heal faster!"}, {"s": 28.681, "e": 29.875, "t": "Keeping the wound clean"}, {"s": 29.875, "e": 30.771, "t": "and a little moist"}, {"s": 30.771, "e": 31.497, "t": "can help it heal"}, {"s": 31.497, "e": 32.777, "t": "with less scarring."}, {"s": 32.777, "e": 33.715, "t": "Picking can also lead"}, {"s": 33.715, "e": 34.654, "t": "to infection,"}, {"s": 34.654, "e": 35.763, "t": "which makes healing take"}, {"s": 35.763, "e": 36.873, "t": "even longer."}, {"s": 41.233, "e": 41.958, "t": "Are you a scab"}, {"s": 41.958, "e": 42.683, "t": "picker?"}, {"s": 42.683, "e": 43.579, "t": "Comment below,"}, {"s": 43.579, "e": 44.944, "t": "and subscribe for more!"}]