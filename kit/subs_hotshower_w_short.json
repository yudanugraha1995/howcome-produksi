[{"s": 0.0, "e": 0.846, "t": "What if you took"}, {"s": 0.846, "e": 2.169, "t": "super hot showers every"}, {"s": 2.169, "e": 2.809, "t": "day?"}, {"s": 5.969, "e": 6.737, "t": "A long,"}, {"s": 6.737, "e": 7.803, "t": "steamy shower is one"}, {"s": 7.803, "e": 8.785, "t": "of the best parts"}, {"s": 8.785, "e": 10.107, "t": "of a cold morning."}, {"s": 10.107, "e": 11.345, "t": "It feels amazing,"}, {"s": 11.345, "e": 13.094, "t": "especially in winter."}, {"s": 13.094, "e": 14.374, "t": "Hot water also helps"}, {"s": 14.374, "e": 15.825, "t": "sore muscles relax."}, {"s": 18.985, "e": 20.265, "t": "But here's the twist."}, {"s": 20.265, "e": 21.374, "t": "Hot water strips the"}, {"s": 21.374, "e": 22.441, "t": "natural oils from your"}, {"s": 22.441, "e": 23.081, "t": "skin,"}, {"s": 23.081, "e": 24.147, "t": "so it gets dry"}, {"s": 24.147, "e": 25.129, "t": "and itchy,"}, {"s": 25.129, "e": 25.726, "t": "and it can make"}, {"s": 25.726, "e": 26.963, "t": "dandruff worse."}, {"s": 26.963, "e": 28.158, "t": "Warm is better!"}, {"s": 28.158, "e": 29.95, "t": "Dermatologists suggest showers of"}, {"s": 29.95, "e": 30.889, "t": "about five to ten"}, {"s": 30.889, "e": 31.529, "t": "minutes,"}, {"s": 31.529, "e": 33.491, "t": "then moisturizer right after."}, {"s": 33.491, "e": 34.515, "t": "Very hot water can"}, {"s": 34.515, "e": 35.497, "t": "also leave your skin"}, {"s": 35.497, "e": 36.819, "t": "red and make eczema"}, {"s": 36.819, "e": 37.673, "t": "flare up."}, {"s": 40.833, "e": 42.582, "t": "Hot or warm showers?"}, {"s": 42.582, "e": 43.563, "t": "Comment below,"}, {"s": 43.563, "e": 44.928, "t": "and subscribe for more!"}]