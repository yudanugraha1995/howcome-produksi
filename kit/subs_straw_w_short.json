[{"s": 0.0, "e": 0.931, "t": "What if you drank"}, {"s": 0.931, "e": 2.297, "t": "everything through a straw?"}, {"s": 7.113, "e": 8.222, "t": "Lots of people drink"}, {"s": 8.222, "e": 9.331, "t": "everything through a straw,"}, {"s": 9.331, "e": 10.782, "t": "from water to smoothies."}, {"s": 10.782, "e": 11.55, "t": "It can help protect"}, {"s": 11.55, "e": 13.043, "t": "your teeth from stains."}, {"s": 13.043, "e": 14.238, "t": "Dentists even suggest it"}, {"s": 14.238, "e": 15.134, "t": "for drinks like soda"}, {"s": 15.134, "e": 16.286, "t": "and iced coffee."}, {"s": 21.102, "e": 22.382, "t": "But here's the twist."}, {"s": 22.382, "e": 23.534, "t": "Pursing your lips over"}, {"s": 23.534, "e": 24.558, "t": "and over may add"}, {"s": 24.558, "e": 25.497, "t": "to fine lines around"}, {"s": 25.497, "e": 26.137, "t": "your mouth,"}, {"s": 26.137, "e": 26.99, "t": "and you can swallow"}, {"s": 26.99, "e": 27.929, "t": "extra air,"}, {"s": 27.929, "e": 28.654, "t": "which can leave you"}, {"s": 28.654, "e": 29.593, "t": "bloated!"}, {"s": 29.593, "e": 31.129, "t": "Reusable straws are fine,"}, {"s": 31.129, "e": 32.579, "t": "just clean them well."}, {"s": 32.579, "e": 33.859, "t": "Straws don't stop every"}, {"s": 33.859, "e": 34.414, "t": "stain,"}, {"s": 34.414, "e": 35.523, "t": "so brushing and rinsing"}, {"s": 35.523, "e": 36.377, "t": "still matter."}, {"s": 41.193, "e": 42.729, "t": "Straw or no straw?"}, {"s": 42.729, "e": 43.582, "t": "Comment below,"}, {"s": 43.582, "e": 44.947, "t": "and subscribe for more!"}]