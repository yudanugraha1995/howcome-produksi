[{"s": 0.14, "e": 1.08, "t": "Cold feet under the"}, {"s": 1.16, "e": 1.52, "t": "blanket?"}, {"s": 1.92, "e": 2.56, "t": "What if you slept"}, {"s": 2.6, "e": 3.68, "t": "in socks every night?"}, {"s": 14.366, "e": 15.467, "t": "Warm feet open blood"}, {"s": 15.507, "e": 15.807, "t": "vessels,"}, {"s": 15.947, "e": 16.727, "t": "so heat leaves your"}, {"s": 16.747, "e": 17.507, "t": "body faster,"}, {"s": 17.647, "e": 18.447, "t": "and a cooler body"}, {"s": 18.567, "e": 19.527, "t": "falls asleep sooner."}, {"s": 19.647, "e": 20.287, "t": "In one study,"}, {"s": 20.427, "e": 21.587, "t": "sock wearers fell asleep"}, {"s": 21.687, "e": 22.107, "t": "faster."}, {"s": 32.634, "e": 33.374, "t": "Plot twist!"}, {"s": 33.594, "e": 34.374, "t": "Warm feet were one"}, {"s": 34.414, "e": 35.254, "t": "of the best signs"}, {"s": 35.294, "e": 36.034, "t": "someone was about to"}, {"s": 36.074, "e": 36.794, "t": "fall asleep!"}, {"s": 47.441, "e": 48.761, "t": "Socks or bare feet?"}, {"s": 48.941, "e": 49.381, "t": "Tell me in the"}, {"s": 49.421, "e": 49.941, "t": "comments!"}]