[{"s": 0.0, "e": 0.846, "t": "What if you dried"}, {"s": 0.846, "e": 1.657, "t": "your hands with an"}, {"s": 1.657, "e": 3.449, "t": "air dryer every time?"}, {"s": 7.065, "e": 8.302, "t": "Lots of public bathrooms"}, {"s": 8.302, "e": 9.454, "t": "have replaced paper towels"}, {"s": 9.454, "e": 10.179, "t": "with them."}, {"s": 10.179, "e": 11.374, "t": "It feels cleaner,"}, {"s": 11.374, "e": 12.227, "t": "because you don't touch"}, {"s": 12.227, "e": 13.038, "t": "anything."}, {"s": 13.038, "e": 14.147, "t": "They also cut paper"}, {"s": 14.147, "e": 14.617, "t": "waste,"}, {"s": 14.617, "e": 15.214, "t": "which is good for"}, {"s": 15.214, "e": 16.153, "t": "the planet."}, {"s": 19.769, "e": 21.091, "t": "But here's the twist."}, {"s": 21.091, "e": 22.115, "t": "Studies found that jet"}, {"s": 22.115, "e": 23.182, "t": "air dryers can blow"}, {"s": 23.182, "e": 24.249, "t": "germs from wet hands"}, {"s": 24.249, "e": 25.017, "t": "more than a meter"}, {"s": 25.017, "e": 25.657, "t": "away,"}, {"s": 25.657, "e": 26.51, "t": "spreading them around the"}, {"s": 26.51, "e": 27.662, "t": "bathroom far more than"}, {"s": 27.662, "e": 28.857, "t": "paper towels."}, {"s": 28.857, "e": 30.094, "t": "Rubbing with paper towels"}, {"s": 30.094, "e": 31.331, "t": "also wipes off germs"}, {"s": 31.331, "e": 32.697, "t": "that washing missed."}, {"s": 32.697, "e": 33.251, "t": "And if you leave"}, {"s": 33.251, "e": 34.361, "t": "with damp hands,"}, {"s": 34.361, "e": 35.854, "t": "germs spread more easily,"}, {"s": 35.854, "e": 37.39, "t": "so dry them fully."}, {"s": 41.006, "e": 42.115, "t": "Paper towels or hand"}, {"s": 42.115, "e": 42.841, "t": "dryer?"}, {"s": 42.841, "e": 43.737, "t": "Comment below,"}, {"s": 43.737, "e": 44.931, "t": "and subscribe for more!"}]