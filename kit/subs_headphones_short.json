[{"s": 0.14, "e": 1.08, "t": "Headphones on the bus,"}, {"s": 1.54, "e": 2.02, "t": "at work,"}, {"s": 2.36, "e": 2.94, "t": "at the gym,"}, {"s": 3.38, "e": 3.88, "t": "in bed."}, {"s": 4.58, "e": 5.12, "t": "What if you wore"}, {"s": 5.16, "e": 5.92, "t": "them all day,"}, {"s": 6.16, "e": 6.78, "t": "every day?"}, {"s": 7.08, "e": 7.8, "t": "What happens to your"}, {"s": 7.88, "e": 8.24, "t": "ears?"}, {"s": 8.7, "e": 9.38, "t": "Can you even hear"}, {"s": 9.4, "e": 9.86, "t": "me right now?"}, {"s": 10.08, "e": 10.82, "t": "Let's find out what"}, {"s": 10.94, "e": 11.66, "t": "science says."}, {"s": 12.01, "e": 12.99, "t": "Deep inside your ear"}, {"s": 13.03, "e": 14.13, "t": "are tiny hair cells"}, {"s": 14.19, "e": 15.17, "t": "that turn sound into"}, {"s": 15.21, "e": 16.27, "t": "signals for your brain."}, {"s": 16.47, "e": 17.59, "t": "Very loud sound can"}, {"s": 17.63, "e": 18.63, "t": "bend and break them."}, {"s": 19.07, "e": 20.09, "t": "Here's the scary part."}, {"s": 20.23, "e": 21.13, "t": "Those hair cells don't"}, {"s": 21.15, "e": 21.73, "t": "grow back,"}, {"s": 21.87, "e": 22.87, "t": "so hearing lost to"}, {"s": 22.91, "e": 24.05, "t": "loud noise is usually"}, {"s": 24.09, "e": 24.57, "t": "permanent."}, {"s": 24.75, "e": 25.65, "t": "And many phones can"}, {"s": 25.67, "e": 26.97, "t": "blast over one hundred"}, {"s": 27.09, "e": 27.77, "t": "decibels."}, {"s": 28.01, "e": 28.81, "t": "A simple rule:"}, {"s": 29.01, "e": 30.43, "t": "under sixty percent volume,"}, {"s": 30.53, "e": 31.71, "t": "for about sixty minutes"}, {"s": 31.75, "e": 32.37, "t": "at a time."}, {"s": 32.55, "e": 33.47, "t": "Then give your ears"}, {"s": 33.53, "e": 34.37, "t": "a quiet break."}, {"s": 36.076, "e": 36.856, "t": "Plot twist!"}, {"s": 37.076, "e": 38.476, "t": "Noise cancelling headphones can"}, {"s": 38.496, "e": 39.416, "t": "protect your ears."}, {"s": 39.596, "e": 40.696, "t": "They block the background"}, {"s": 40.736, "e": 41.036, "t": "noise,"}, {"s": 41.096, "e": 41.716, "t": "so you don't need"}, {"s": 41.736, "e": 42.636, "t": "to crank the volume"}, {"s": 42.736, "e": 42.876, "t": "up."}, {"s": 43.036, "e": 43.776, "t": "And if your ears"}, {"s": 43.816, "e": 44.716, "t": "ring after listening,"}, {"s": 44.856, "e": 45.876, "t": "it was too loud."}, {"s": 46.056, "e": 46.936, "t": "That ringing is your"}, {"s": 47.016, "e": 48.096, "t": "ear asking for help."}, {"s": 48.656, "e": 49.376, "t": "Listen to it."}, {"s": 49.696, "e": 50.396, "t": "How loud do you"}, {"s": 50.436, "e": 51.216, "t": "play your music?"}, {"s": 51.396, "e": 51.836, "t": "Tell me in the"}, {"s": 51.876, "e": 52.276, "t": "comments,"}, {"s": 52.316, "e": 53.456, "t": "and subscribe for more"}, {"s": 53.496, "e": 54.116, "t": "HowCome!"}]