[{"s": 0.0, "e": 1.04, "t": "Why do old books"}, {"s": 1.12, "e": 2.48, "t": "smell so good?"}, {"s": 3.153, "e": 4.353, "t": "As paper ages,"}, {"s": 4.553, "e": 6.033, "t": "chemicals inside it slowly"}, {"s": 6.153, "e": 7.073, "t": "break down."}, {"s": 7.746, "e": 8.786, "t": "But here's the surprising"}, {"s": 8.946, "e": 9.506, "t": "part:"}, {"s": 9.586, "e": 10.226, "t": "one of them is"}, {"s": 10.386, "e": 11.106, "t": "vanillin,"}, {"s": 11.226, "e": 12.306, "t": "the same compound that"}, {"s": 12.386, "e": 13.666, "t": "gives vanilla its sweet"}, {"s": 13.826, "e": 14.626, "t": "smell!"}, {"s": 15.259, "e": 16.019, "t": "Do you love that"}, {"s": 16.099, "e": 16.659, "t": "smell?"}, {"s": 16.739, "e": 17.299, "t": "Comment,"}, {"s": 17.379, "e": 18.419, "t": "and subscribe!"}]