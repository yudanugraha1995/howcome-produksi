[{"s": 0.0, "e": 0.96, "t": "What if you never"}, {"s": 1.08, "e": 2.44, "t": "unplugged your chargers?"}, {"s": 3.233, "e": 4.353, "t": "A lone phone charger"}, {"s": 4.433, "e": 6.193, "t": "barely uses any power."}, {"s": 6.866, "e": 7.746, "t": "But TVs,"}, {"s": 7.906, "e": 9.266, "t": "consoles and other devices"}, {"s": 9.306, "e": 10.386, "t": "on standby can add"}, {"s": 10.466, "e": 11.346, "t": "up to about five"}, {"s": 11.426, "e": 12.546, "t": "to ten percent of"}, {"s": 12.573, "e": 13.906, "t": "a home's electricity!"}, {"s": 14.579, "e": 15.859, "t": "Do you unplug yours?"}, {"s": 15.939, "e": 16.339, "t": "Tell us in the"}, {"s": 16.419, "e": 17.219, "t": "comments!"}, {"s": 17.539, "e": 18.179, "t": "Subscribe!"}]