[{"s": 0.0, "e": 0.846, "t": "What if you drank"}, {"s": 0.846, "e": 2.51, "t": "hot water every morning?"}, {"s": 6.358, "e": 7.382, "t": "Drinking warm water in"}, {"s": 7.382, "e": 8.193, "t": "the morning is a"}, {"s": 8.193, "e": 9.387, "t": "common habit in many"}, {"s": 9.387, "e": 10.497, "t": "parts of Asia."}, {"s": 10.497, "e": 11.35, "t": "Many people say it"}, {"s": 11.35, "e": 12.63, "t": "wakes up their stomach."}, {"s": 12.63, "e": 13.526, "t": "Lots of people swear"}, {"s": 13.526, "e": 14.379, "t": "it helps them feel"}, {"s": 14.379, "e": 15.574, "t": "warm and hydrated."}, {"s": 19.422, "e": 20.873, "t": "But here's the twist."}, {"s": 20.873, "e": 21.854, "t": "Warm drinks can help"}, {"s": 21.854, "e": 22.963, "t": "get your gut moving,"}, {"s": 22.963, "e": 24.158, "t": "but very hot drinks"}, {"s": 24.158, "e": 25.481, "t": "above sixty five degrees"}, {"s": 25.481, "e": 26.59, "t": "Celsius are linked to"}, {"s": 26.59, "e": 27.529, "t": "a higher risk of"}, {"s": 27.529, "e": 28.553, "t": "throat cancer."}, {"s": 28.553, "e": 29.15, "t": "So let it cool"}, {"s": 29.15, "e": 30.003, "t": "a bit!"}, {"s": 30.003, "e": 31.027, "t": "Warm or cold,"}, {"s": 31.027, "e": 32.094, "t": "the most important thing"}, {"s": 32.094, "e": 33.545, "t": "is drinking enough water"}, {"s": 33.545, "e": 34.398, "t": "every day."}, {"s": 34.398, "e": 35.337, "t": "Tea and coffee lovers"}, {"s": 35.337, "e": 36.147, "t": "can simply wait a"}, {"s": 36.147, "e": 37.769, "t": "few minutes before sipping."}, {"s": 41.617, "e": 42.811, "t": "Hot water or cold?"}, {"s": 42.811, "e": 43.665, "t": "Comment below,"}, {"s": 43.665, "e": 44.944, "t": "and subscribe for more!"}]