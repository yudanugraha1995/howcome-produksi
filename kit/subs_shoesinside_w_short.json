[{"s": 0.0, "e": 0.718, "t": "What if you wore"}, {"s": 0.718, "e": 2.467, "t": "your outdoor shoes inside"}, {"s": 2.467, "e": 3.449, "t": "every day?"}, {"s": 6.497, "e": 7.99, "t": "In many American homes,"}, {"s": 7.99, "e": 9.355, "t": "wearing shoes inside is"}, {"s": 9.355, "e": 10.507, "t": "totally normal."}, {"s": 10.507, "e": 11.958, "t": "It saves time."}, {"s": 11.958, "e": 13.238, "t": "Many homes in Japan,"}, {"s": 13.238, "e": 14.603, "t": "Korea and Canada take"}, {"s": 14.603, "e": 15.371, "t": "shoes off at the"}, {"s": 15.371, "e": 16.267, "t": "door."}, {"s": 19.315, "e": 20.681, "t": "But here's the twist."}, {"s": 20.681, "e": 21.662, "t": "Shoe soles pick up"}, {"s": 21.662, "e": 22.771, "t": "dirt and bacteria from"}, {"s": 22.771, "e": 23.497, "t": "the street,"}, {"s": 23.497, "e": 24.521, "t": "and one study found"}, {"s": 24.521, "e": 26.313, "t": "fecal bacteria on almost"}, {"s": 26.313, "e": 27.763, "t": "every shoe it tested!"}, {"s": 27.763, "e": 28.787, "t": "Your floor is where"}, {"s": 28.787, "e": 30.067, "t": "babies crawl and pets"}, {"s": 30.067, "e": 30.878, "t": "lie down,"}, {"s": 30.878, "e": 31.603, "t": "so a shoe rack"}, {"s": 31.603, "e": 32.286, "t": "by the door is"}, {"s": 32.286, "e": 33.694, "t": "an easy fix."}, {"s": 33.694, "e": 34.889, "t": "Indoor slippers keep your"}, {"s": 34.889, "e": 35.955, "t": "feet warm and your"}, {"s": 35.955, "e": 37.491, "t": "floors much cleaner."}, {"s": 40.539, "e": 41.478, "t": "Shoes on or off"}, {"s": 41.478, "e": 42.545, "t": "at home?"}, {"s": 42.545, "e": 43.569, "t": "Comment below,"}, {"s": 43.569, "e": 44.934, "t": "and subscribe for more!"}]