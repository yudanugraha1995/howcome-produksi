[{"s": 0.0, "e": 0.675, "t": "What if you ate"}, {"s": 0.675, "e": 1.614, "t": "a piece of dark"}, {"s": 1.614, "e": 3.193, "t": "chocolate every day?"}, {"s": 5.161, "e": 6.227, "t": "It's often called the"}, {"s": 6.227, "e": 8.019, "t": "healthy kind of chocolate."}, {"s": 8.019, "e": 9.171, "t": "Dark chocolate is packed"}, {"s": 9.171, "e": 10.366, "t": "with flavanols,"}, {"s": 10.366, "e": 11.689, "t": "plant compounds linked to"}, {"s": 11.689, "e": 12.627, "t": "better blood flow and"}, {"s": 12.627, "e": 13.694, "t": "heart health."}, {"s": 13.694, "e": 14.803, "t": "The darker it is,"}, {"s": 14.803, "e": 16.467, "t": "usually seventy percent cocoa"}, {"s": 16.467, "e": 17.15, "t": "or more,"}, {"s": 17.15, "e": 18.345, "t": "the more flavanols and"}, {"s": 18.345, "e": 19.539, "t": "the less sugar."}, {"s": 21.507, "e": 22.958, "t": "But here's the twist."}, {"s": 22.958, "e": 24.067, "t": "Tests found lead and"}, {"s": 24.067, "e": 25.518, "t": "cadmium in many popular"}, {"s": 25.518, "e": 26.841, "t": "dark chocolate bars,"}, {"s": 26.841, "e": 27.779, "t": "so eating a lot"}, {"s": 27.779, "e": 28.846, "t": "every day isn't a"}, {"s": 28.846, "e": 30.041, "t": "great idea."}, {"s": 30.041, "e": 31.193, "t": "Experts say a small"}, {"s": 31.193, "e": 31.875, "t": "square or two a"}, {"s": 31.875, "e": 32.899, "t": "day is plenty,"}, {"s": 32.899, "e": 34.734, "t": "and switching brands helps."}, {"s": 34.734, "e": 35.715, "t": "It's also still high"}, {"s": 35.715, "e": 37.123, "t": "in calories and fat,"}, {"s": 37.123, "e": 38.147, "t": "so more isn't always"}, {"s": 38.147, "e": 38.873, "t": "better."}, {"s": 40.841, "e": 42.59, "t": "Dark or milk chocolate?"}, {"s": 42.59, "e": 43.571, "t": "Comment below,"}, {"s": 43.571, "e": 44.936, "t": "and subscribe for more!"}]