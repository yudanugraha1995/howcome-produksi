[{"s": 0.0, "e": 0.846, "t": "What if you ate"}, {"s": 0.846, "e": 1.87, "t": "raw cookie dough every"}, {"s": 1.87, "e": 2.51, "t": "day?"}, {"s": 6.638, "e": 7.406, "t": "Licking the spoon is"}, {"s": 7.406, "e": 8.345, "t": "a favorite part of"}, {"s": 8.345, "e": 9.155, "t": "baking for lots of"}, {"s": 9.155, "e": 9.838, "t": "people."}, {"s": 9.838, "e": 11.374, "t": "It tastes amazing."}, {"s": 11.374, "e": 12.483, "t": "Most people only worry"}, {"s": 12.483, "e": 13.465, "t": "about raw eggs and"}, {"s": 13.465, "e": 14.275, "t": "salmonella."}, {"s": 18.403, "e": 19.641, "t": "But here's the twist."}, {"s": 19.641, "e": 20.323, "t": "It's not just the"}, {"s": 20.323, "e": 21.305, "t": "raw eggs."}, {"s": 21.305, "e": 22.499, "t": "Raw flour can carry"}, {"s": 22.499, "e": 23.694, "t": "E coli too,"}, {"s": 23.694, "e": 24.803, "t": "so the FDA says"}, {"s": 24.803, "e": 25.955, "t": "don't eat raw dough,"}, {"s": 25.955, "e": 26.766, "t": "unless it's made to"}, {"s": 26.766, "e": 28.046, "t": "be eaten raw!"}, {"s": 28.046, "e": 29.198, "t": "Heat treated flour and"}, {"s": 29.198, "e": 30.649, "t": "pasteurized eggs make dough"}, {"s": 30.649, "e": 31.929, "t": "safe to eat raw."}, {"s": 31.929, "e": 33.337, "t": "In twenty sixteen,"}, {"s": 33.337, "e": 34.275, "t": "millions of pounds of"}, {"s": 34.275, "e": 35.299, "t": "flour were recalled in"}, {"s": 35.299, "e": 36.238, "t": "the US because of"}, {"s": 36.238, "e": 37.219, "t": "E coli."}, {"s": 41.347, "e": 42.115, "t": "Do you sneak cookie"}, {"s": 42.115, "e": 42.755, "t": "dough?"}, {"s": 42.755, "e": 43.609, "t": "Comment below,"}, {"s": 43.609, "e": 44.931, "t": "and subscribe for more!"}]