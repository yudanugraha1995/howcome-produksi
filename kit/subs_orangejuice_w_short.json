[{"s": 0.0, "e": 0.931, "t": "What if you drank"}, {"s": 0.931, "e": 2.169, "t": "orange juice every single"}, {"s": 2.169, "e": 2.937, "t": "morning?"}, {"s": 6.553, "e": 7.875, "t": "It's the classic breakfast"}, {"s": 7.875, "e": 9.454, "t": "drink in many homes."}, {"s": 9.454, "e": 10.435, "t": "One glass gives you"}, {"s": 10.435, "e": 11.246, "t": "more than a full"}, {"s": 11.246, "e": 12.697, "t": "day of vitamin C."}, {"s": 12.697, "e": 13.934, "t": "It also has potassium"}, {"s": 13.934, "e": 15.043, "t": "and folate."}, {"s": 18.659, "e": 19.982, "t": "But here's the twist."}, {"s": 19.982, "e": 21.134, "t": "Orange juice has nearly"}, {"s": 21.134, "e": 21.987, "t": "as much sugar as"}, {"s": 21.987, "e": 22.755, "t": "the same amount of"}, {"s": 22.755, "e": 23.353, "t": "soda,"}, {"s": 23.353, "e": 24.291, "t": "and without the fiber"}, {"s": 24.291, "e": 25.23, "t": "of a whole orange"}, {"s": 25.23, "e": 26.041, "t": "it hits your blood"}, {"s": 26.041, "e": 27.321, "t": "sugar faster."}, {"s": 27.321, "e": 28.259, "t": "It takes about three"}, {"s": 28.259, "e": 29.326, "t": "oranges to make one"}, {"s": 29.326, "e": 30.051, "t": "glass,"}, {"s": 30.051, "e": 30.819, "t": "so it's easy to"}, {"s": 30.819, "e": 31.502, "t": "drink a lot of"}, {"s": 31.502, "e": 32.697, "t": "sugar fast."}, {"s": 32.697, "e": 34.019, "t": "Experts suggest eating the"}, {"s": 34.019, "e": 34.873, "t": "whole fruit,"}, {"s": 34.873, "e": 35.854, "t": "or keeping juice to"}, {"s": 35.854, "e": 36.793, "t": "one small glass a"}, {"s": 36.793, "e": 37.603, "t": "day."}, {"s": 41.219, "e": 42.713, "t": "Juice or whole fruit?"}, {"s": 42.713, "e": 43.651, "t": "Comment below,"}, {"s": 43.651, "e": 44.931, "t": "and subscribe for more!"}]