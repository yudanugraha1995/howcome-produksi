[{"s": 0.0, "e": 1.28, "t": "Why do mosquito bites"}, {"s": 1.36, "e": 1.84, "t": "itch?"}, {"s": 2.833, "e": 4.113, "t": "When a mosquito bites,"}, {"s": 4.153, "e": 5.473, "t": "it injects saliva to"}, {"s": 5.553, "e": 6.873, "t": "keep your blood flowing."}, {"s": 7.666, "e": 8.706, "t": "But here's the surprising"}, {"s": 8.786, "e": 9.346, "t": "part:"}, {"s": 9.426, "e": 10.546, "t": "the itch isn't the"}, {"s": 10.626, "e": 11.026, "t": "bite."}, {"s": 11.346, "e": 12.386, "t": "It's your immune system"}, {"s": 12.466, "e": 13.826, "t": "reacting to that saliva"}, {"s": 13.906, "e": 15.266, "t": "and releasing histamine!"}, {"s": 16.259, "e": 17.459, "t": "Do mosquitoes love you?"}, {"s": 17.779, "e": 18.259, "t": "Comment,"}, {"s": 18.339, "e": 19.379, "t": "and subscribe!"}]