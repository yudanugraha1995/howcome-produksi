[{"s": 0.0, "e": 0.675, "t": "What if you ate"}, {"s": 0.675, "e": 1.998, "t": "a spoonful of honey"}, {"s": 1.998, "e": 2.851, "t": "every day?"}, {"s": 4.987, "e": 5.67, "t": "People have used it"}, {"s": 5.67, "e": 6.737, "t": "as food and medicine"}, {"s": 6.737, "e": 8.315, "t": "for thousands of years."}, {"s": 8.315, "e": 10.022, "t": "Honey has antioxidants and"}, {"s": 10.022, "e": 11.003, "t": "can soothe a sore"}, {"s": 11.003, "e": 11.985, "t": "throat and calm a"}, {"s": 11.985, "e": 12.966, "t": "cough."}, {"s": 12.966, "e": 14.331, "t": "But a tablespoon still"}, {"s": 14.331, "e": 16.038, "t": "has about sixty calories,"}, {"s": 16.038, "e": 17.617, "t": "and it's mostly sugar."}, {"s": 19.753, "e": 21.033, "t": "But here's the twist."}, {"s": 21.033, "e": 22.697, "t": "Honey almost never spoils,"}, {"s": 22.697, "e": 24.062, "t": "and archaeologists found pots"}, {"s": 24.062, "e": 24.873, "t": "of it in ancient"}, {"s": 24.873, "e": 26.11, "t": "Egyptian tombs,"}, {"s": 26.11, "e": 27.433, "t": "thousands of years old,"}, {"s": 27.433, "e": 29.011, "t": "that hadn't gone bad."}, {"s": 29.011, "e": 29.865, "t": "That's because it's low"}, {"s": 29.865, "e": 31.017, "t": "in water and slightly"}, {"s": 31.017, "e": 31.742, "t": "acidic,"}, {"s": 31.742, "e": 33.491, "t": "so bacteria can't grow."}, {"s": 33.491, "e": 34.601, "t": "Just never give honey"}, {"s": 34.601, "e": 35.539, "t": "to babies under one"}, {"s": 35.539, "e": 36.307, "t": "year old,"}, {"s": 36.307, "e": 37.075, "t": "because of a rare"}, {"s": 37.075, "e": 39.081, "t": "risk called botulism."}, {"s": 41.217, "e": 42.539, "t": "Honey or sugar?"}, {"s": 42.539, "e": 43.521, "t": "Comment below,"}, {"s": 43.521, "e": 44.928, "t": "and subscribe for more!"}]