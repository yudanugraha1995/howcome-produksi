[{"s": 0.0, "e": 0.846, "t": "What if you followed"}, {"s": 0.846, "e": 1.955, "t": "the five second rule"}, {"s": 1.955, "e": 2.851, "t": "every day?"}, {"s": 6.923, "e": 7.777, "t": "The rule is so"}, {"s": 7.777, "e": 9.142, "t": "famous that scientists actually"}, {"s": 9.142, "e": 10.507, "t": "decided to test it."}, {"s": 10.507, "e": 11.361, "t": "Grab it fast and"}, {"s": 11.361, "e": 12.001, "t": "it's fine,"}, {"s": 12.001, "e": 12.726, "t": "right?"}, {"s": 12.726, "e": 13.579, "t": "Lots of people believe"}, {"s": 13.579, "e": 14.518, "t": "a quick grab keeps"}, {"s": 14.518, "e": 15.755, "t": "the germs away."}, {"s": 19.827, "e": 21.193, "t": "But here's the twist."}, {"s": 21.193, "e": 22.302, "t": "Scientists tested it,"}, {"s": 22.302, "e": 23.369, "t": "and bacteria can jump"}, {"s": 23.369, "e": 24.222, "t": "onto food in less"}, {"s": 24.222, "e": 25.203, "t": "than one second,"}, {"s": 25.203, "e": 26.526, "t": "especially wet food like"}, {"s": 26.526, "e": 27.678, "t": "watermelon!"}, {"s": 27.678, "e": 28.83, "t": "Carpet passed on fewer"}, {"s": 28.83, "e": 29.726, "t": "germs than tile or"}, {"s": 29.726, "e": 30.323, "t": "steel,"}, {"s": 30.323, "e": 31.177, "t": "and the longer food"}, {"s": 31.177, "e": 31.689, "t": "sits,"}, {"s": 31.689, "e": 32.713, "t": "the more bacteria it"}, {"s": 32.713, "e": 33.651, "t": "picks up."}, {"s": 33.651, "e": 34.675, "t": "So for wet food,"}, {"s": 34.675, "e": 35.358, "t": "it's more like a"}, {"s": 35.358, "e": 36.723, "t": "zero second rule!"}, {"s": 40.795, "e": 41.521, "t": "Do you follow the"}, {"s": 41.521, "e": 42.758, "t": "five second rule?"}, {"s": 42.758, "e": 43.611, "t": "Comment below,"}, {"s": 43.611, "e": 44.934, "t": "and subscribe for more!"}]