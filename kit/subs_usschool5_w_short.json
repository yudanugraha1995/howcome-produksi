[{"s": 0.0, "e": 0.59, "t": "What if you went"}, {"s": 0.59, "e": 1.614, "t": "to school in America"}, {"s": 1.614, "e": 2.681, "t": "for one day?"}, {"s": 4.137, "e": 5.289, "t": "Students from other countries"}, {"s": 5.289, "e": 6.526, "t": "are often surprised by"}, {"s": 6.526, "e": 7.294, "t": "these."}, {"s": 7.294, "e": 7.977, "t": "One,"}, {"s": 7.977, "e": 9.043, "t": "many classes start the"}, {"s": 9.043, "e": 9.811, "t": "day with the Pledge"}, {"s": 9.811, "e": 10.707, "t": "of Allegiance to the"}, {"s": 10.707, "e": 11.561, "t": "flag."}, {"s": 11.561, "e": 12.243, "t": "Two,"}, {"s": 12.243, "e": 13.694, "t": "students switch classrooms every"}, {"s": 13.694, "e": 14.078, "t": "period,"}, {"s": 14.078, "e": 15.742, "t": "while teachers stay put."}, {"s": 15.742, "e": 16.254, "t": "Three,"}, {"s": 16.254, "e": 17.065, "t": "rows of lockers in"}, {"s": 17.065, "e": 17.875, "t": "the hallways,"}, {"s": 17.875, "e": 18.43, "t": "just like in the"}, {"s": 18.43, "e": 19.326, "t": "movies."}, {"s": 20.782, "e": 22.233, "t": "But here's the twist."}, {"s": 22.233, "e": 22.873, "t": "Four,"}, {"s": 22.873, "e": 23.897, "t": "high school sports are"}, {"s": 23.897, "e": 24.579, "t": "huge,"}, {"s": 24.579, "e": 25.817, "t": "and some football stadiums"}, {"s": 25.817, "e": 27.054, "t": "seat over ten thousand"}, {"s": 27.054, "e": 28.377, "t": "fans."}, {"s": 28.377, "e": 29.017, "t": "Five,"}, {"s": 29.017, "e": 29.998, "t": "the yellow school bus"}, {"s": 29.998, "e": 30.937, "t": "fleet is the biggest"}, {"s": 30.937, "e": 31.961, "t": "mass transit system in"}, {"s": 31.961, "e": 32.899, "t": "the country."}, {"s": 32.899, "e": 33.71, "t": "And prom,"}, {"s": 33.71, "e": 34.606, "t": "a fancy dance at"}, {"s": 34.606, "e": 35.246, "t": "the end of high"}, {"s": 35.246, "e": 35.758, "t": "school,"}, {"s": 35.758, "e": 37.081, "t": "can cost families hundreds"}, {"s": 37.081, "e": 38.147, "t": "of dollars."}, {"s": 39.603, "e": 40.499, "t": "Would you rather study"}, {"s": 40.499, "e": 41.609, "t": "in America or at"}, {"s": 41.609, "e": 42.547, "t": "home?"}, {"s": 42.547, "e": 43.529, "t": "Comment below,"}, {"s": 43.529, "e": 44.936, "t": "and subscribe for more!"}]