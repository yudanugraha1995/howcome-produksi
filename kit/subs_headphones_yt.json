[{"s": 0.14, "e": 1.08, "t": "Headphones on the bus,"}, {"s": 1.54, "e": 2.02, "t": "at work,"}, {"s": 2.36, "e": 2.94, "t": "at the gym,"}, {"s": 3.38, "e": 3.88, "t": "in bed."}, {"s": 4.58, "e": 5.12, "t": "What if you wore"}, {"s": 5.16, "e": 5.92, "t": "them all day,"}, {"s": 6.16, "e": 6.78, "t": "every day?"}, {"s": 7.08, "e": 7.8, "t": "What happens to your"}, {"s": 7.88, "e": 8.24, "t": "ears?"}, {"s": 8.7, "e": 9.38, "t": "Can you even hear"}, {"s": 9.4, "e": 9.86, "t": "me right now?"}, {"s": 10.08, "e": 10.82, "t": "Let's find out what"}, {"s": 10.94, "e": 11.66, "t": "science says."}, {"s": 27.792, "e": 29.012, "t": "The World Health Organization"}, {"s": 29.112, "e": 30.312, "t": "says over a billion"}, {"s": 30.352, "e": 31.192, "t": "young people are at"}, {"s": 31.232, "e": 32.292, "t": "risk of hearing loss"}, {"s": 32.312, "e": 33.492, "t": "from unsafe listening."}, {"s": 49.644, "e": 50.624, "t": "Deep inside your ear"}, {"s": 50.664, "e": 51.764, "t": "are tiny hair cells"}, {"s": 51.824, "e": 52.804, "t": "that turn sound into"}, {"s": 52.844, "e": 53.904, "t": "signals for your brain."}, {"s": 54.104, "e": 55.224, "t": "Very loud sound can"}, {"s": 55.264, "e": 56.264, "t": "bend and break them."}, {"s": 72.496, "e": 73.516, "t": "Here's the scary part."}, {"s": 73.656, "e": 74.556, "t": "Those hair cells don't"}, {"s": 74.576, "e": 75.156, "t": "grow back,"}, {"s": 75.296, "e": 76.296, "t": "so hearing lost to"}, {"s": 76.336, "e": 77.476, "t": "loud noise is usually"}, {"s": 77.516, "e": 77.996, "t": "permanent."}, {"s": 78.176, "e": 79.076, "t": "And many phones can"}, {"s": 79.096, "e": 80.396, "t": "blast over one hundred"}, {"s": 80.516, "e": 81.196, "t": "decibels."}, {"s": 81.436, "e": 82.236, "t": "A simple rule:"}, {"s": 82.436, "e": 83.856, "t": "under sixty percent volume,"}, {"s": 83.956, "e": 85.136, "t": "for about sixty minutes"}, {"s": 85.176, "e": 85.796, "t": "at a time."}, {"s": 85.976, "e": 86.896, "t": "Then give your ears"}, {"s": 86.956, "e": 87.796, "t": "a quiet break."}, {"s": 104.088, "e": 104.868, "t": "Plot twist!"}, {"s": 105.088, "e": 106.488, "t": "Noise cancelling headphones can"}, {"s": 106.508, "e": 107.428, "t": "protect your ears."}, {"s": 107.608, "e": 108.708, "t": "They block the background"}, {"s": 108.748, "e": 109.048, "t": "noise,"}, {"s": 109.108, "e": 109.728, "t": "so you don't need"}, {"s": 109.748, "e": 110.648, "t": "to crank the volume"}, {"s": 110.748, "e": 110.888, "t": "up."}, {"s": 111.048, "e": 111.788, "t": "And if your ears"}, {"s": 111.828, "e": 112.728, "t": "ring after listening,"}, {"s": 112.868, "e": 113.888, "t": "it was too loud."}, {"s": 114.068, "e": 114.948, "t": "That ringing is your"}, {"s": 115.028, "e": 116.108, "t": "ear asking for help."}, {"s": 116.668, "e": 117.388, "t": "Listen to it."}, {"s": 133.5, "e": 134.2, "t": "How loud do you"}, {"s": 134.24, "e": 135.02, "t": "play your music?"}, {"s": 135.2, "e": 135.64, "t": "Tell me in the"}, {"s": 135.68, "e": 136.08, "t": "comments,"}, {"s": 136.12, "e": 137.26, "t": "and subscribe for more"}, {"s": 137.3, "e": 137.92, "t": "HowCome!"}]