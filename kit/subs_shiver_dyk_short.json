[{"s": 0.0, "e": 0.96, "t": "Why do we shiver"}, {"s": 1.04, "e": 2.12, "t": "when we're cold?"}, {"s": 2.913, "e": 4.273, "t": "Your muscles start shaking"}, {"s": 4.433, "e": 5.073, "t": "fast,"}, {"s": 5.193, "e": 6.153, "t": "all on their own."}, {"s": 6.946, "e": 7.986, "t": "But here's the surprising"}, {"s": 8.066, "e": 8.706, "t": "part:"}, {"s": 8.826, "e": 9.986, "t": "those tiny shakes are"}, {"s": 10.106, "e": 11.746, "t": "your body making heat."}, {"s": 11.786, "e": 12.946, "t": "Shivering can boost your"}, {"s": 13.066, "e": 14.626, "t": "body's heat production several"}, {"s": 14.786, "e": 15.546, "t": "times over!"}, {"s": 16.339, "e": 17.979, "t": "Cold or hot weather?"}, {"s": 18.179, "e": 18.739, "t": "Comment,"}, {"s": 18.819, "e": 19.779, "t": "and subscribe!"}]