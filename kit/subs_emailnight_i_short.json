[{"s": 0.0, "e": 0.72, "t": "What if you checked"}, {"s": 0.8, "e": 2.48, "t": "work emails every night?"}, {"s": 3.393, "e": 4.193, "t": "It feels like getting"}, {"s": 4.433, "e": 4.753, "t": "ahead."}, {"s": 5.586, "e": 6.706, "t": "But late screen time"}, {"s": 6.746, "e": 7.666, "t": "and stress can make"}, {"s": 7.706, "e": 8.626, "t": "it harder to switch"}, {"s": 8.706, "e": 9.666, "t": "off and sleep."}, {"s": 9.826, "e": 10.546, "t": "In France,"}, {"s": 10.586, "e": 11.426, "t": "a law even gives"}, {"s": 11.506, "e": 12.546, "t": "workers the right to"}, {"s": 12.826, "e": 14.226, "t": "disconnect after hours!"}, {"s": 14.979, "e": 16.019, "t": "Do you check yours?"}, {"s": 16.179, "e": 16.579, "t": "Comment,"}, {"s": 16.659, "e": 17.699, "t": "and subscribe!"}]