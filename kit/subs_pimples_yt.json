[{"s": 0.7, "e": 1.5, "t": "A big pimple,"}, {"s": 1.84, "e": 2.86, "t": "right on your nose,"}, {"s": 3.1, "e": 4.0, "t": "the day before a"}, {"s": 4.04, "e": 4.38, "t": "party."}, {"s": 4.64, "e": 5.46, "t": "What if you popped"}, {"s": 5.56, "e": 6.6, "t": "every single pimple?"}, {"s": 6.8, "e": 7.66, "t": "Is it really that"}, {"s": 7.68, "e": 8.46, "t": "bad for your skin?"}, {"s": 24.328, "e": 25.768, "t": "Almost everyone gets pimples"}, {"s": 25.788, "e": 26.348, "t": "at some point,"}, {"s": 26.508, "e": 27.708, "t": "and popping them feels"}, {"s": 27.788, "e": 28.708, "t": "so satisfying."}, {"s": 28.908, "e": 29.968, "t": "That's why pimple popping"}, {"s": 30.008, "e": 31.208, "t": "videos get millions of"}, {"s": 31.248, "e": 31.648, "t": "views."}, {"s": 47.636, "e": 48.376, "t": "A pimple is a"}, {"s": 48.436, "e": 49.696, "t": "pore clogged with oil,"}, {"s": 49.916, "e": 50.476, "t": "dead skin,"}, {"s": 50.576, "e": 51.356, "t": "and bacteria."}, {"s": 51.556, "e": 52.496, "t": "Your body sends white"}, {"s": 52.516, "e": 53.396, "t": "blood cells to fight"}, {"s": 53.436, "e": 53.516, "t": "it,"}, {"s": 53.676, "e": 54.356, "t": "and that's the pus"}, {"s": 54.436, "e": 54.796, "t": "you see."}, {"s": 71.164, "e": 71.944, "t": "Here's the problem."}, {"s": 72.104, "e": 72.824, "t": "When you squeeze,"}, {"s": 72.924, "e": 73.684, "t": "you can push that"}, {"s": 73.724, "e": 75.184, "t": "gunk and bacteria deeper"}, {"s": 75.244, "e": 75.984, "t": "into your skin."}, {"s": 76.164, "e": 77.284, "t": "That means more swelling,"}, {"s": 77.464, "e": 78.164, "t": "more redness,"}, {"s": 78.264, "e": 79.384, "t": "and sometimes a scar"}, {"s": 79.424, "e": 80.224, "t": "or a dark spot"}, {"s": 80.244, "e": 81.324, "t": "that stays for months."}, {"s": 81.604, "e": 82.604, "t": "Skin doctors say it's"}, {"s": 82.644, "e": 83.224, "t": "better to leave it"}, {"s": 83.264, "e": 83.704, "t": "alone,"}, {"s": 83.904, "e": 85.024, "t": "use a warm compress,"}, {"s": 85.124, "e": 85.704, "t": "or stick on a"}, {"s": 85.744, "e": 86.444, "t": "pimple patch."}, {"s": 86.664, "e": 87.244, "t": "And if a pimple"}, {"s": 87.304, "e": 88.284, "t": "is big and painful,"}, {"s": 88.564, "e": 89.244, "t": "see a doctor."}, {"s": 105.172, "e": 105.892, "t": "Plot twist!"}, {"s": 106.072, "e": 107.072, "t": "Blackheads aren't dirt at"}, {"s": 107.172, "e": 107.412, "t": "all."}, {"s": 107.612, "e": 108.512, "t": "That black color is"}, {"s": 108.552, "e": 109.532, "t": "skin oil that turns"}, {"s": 109.572, "e": 110.392, "t": "dark when it touches"}, {"s": 110.432, "e": 110.832, "t": "the air,"}, {"s": 110.992, "e": 111.752, "t": "like a cut apple"}, {"s": 111.792, "e": 112.532, "t": "turning brown."}, {"s": 112.732, "e": 113.652, "t": "So scrubbing your face"}, {"s": 113.692, "e": 114.652, "t": "harder won't wash them"}, {"s": 114.712, "e": 115.052, "t": "away."}, {"s": 115.232, "e": 116.572, "t": "Gentle cleansing works better."}, {"s": 132.42, "e": 132.96, "t": "Be honest."}, {"s": 133.1, "e": 133.96, "t": "Are you a popper"}, {"s": 134.0, "e": 134.76, "t": "or a hands off"}, {"s": 134.8, "e": 135.2, "t": "person?"}, {"s": 135.4, "e": 135.82, "t": "Tell me in the"}, {"s": 135.86, "e": 136.26, "t": "comments,"}, {"s": 136.3, "e": 137.32, "t": "and subscribe for more"}, {"s": 137.36, "e": 137.92, "t": "HowCome!"}]