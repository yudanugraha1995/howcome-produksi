[{"s": 0.0, "e": 0.846, "t": "What if you walked"}, {"s": 0.846, "e": 2.297, "t": "barefoot every day?"}, {"s": 6.937, "e": 7.662, "t": "For most of human"}, {"s": 7.662, "e": 8.259, "t": "history,"}, {"s": 8.259, "e": 9.881, "t": "people walked without shoes."}, {"s": 9.881, "e": 11.502, "t": "It feels so free."}, {"s": 11.502, "e": 12.611, "t": "Some runners even switched"}, {"s": 12.611, "e": 14.062, "t": "to barefoot running."}, {"s": 18.702, "e": 19.982, "t": "But here's the twist."}, {"s": 19.982, "e": 20.921, "t": "Your foot muscles can"}, {"s": 20.921, "e": 21.902, "t": "get stronger and your"}, {"s": 21.902, "e": 23.225, "t": "balance may improve,"}, {"s": 23.225, "e": 24.462, "t": "but you risk cuts,"}, {"s": 24.462, "e": 25.614, "t": "fungus and warts,"}, {"s": 25.614, "e": 27.79, "t": "especially in public showers!"}, {"s": 27.79, "e": 29.027, "t": "People with diabetes should"}, {"s": 29.027, "e": 30.393, "t": "never go barefoot,"}, {"s": 30.393, "e": 31.289, "t": "because small cuts can"}, {"s": 31.289, "e": 32.483, "t": "go unnoticed."}, {"s": 32.483, "e": 33.763, "t": "Doctors say always wear"}, {"s": 33.763, "e": 35.214, "t": "shoes in public pools,"}, {"s": 35.214, "e": 36.622, "t": "gyms and showers."}, {"s": 41.262, "e": 42.542, "t": "Barefoot or shoes?"}, {"s": 42.542, "e": 43.566, "t": "Comment below,"}, {"s": 43.566, "e": 44.931, "t": "and subscribe for more!"}]