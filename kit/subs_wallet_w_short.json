[{"s": 0.0, "e": 0.761, "t": "What if you sat"}, {"s": 0.761, "e": 1.742, "t": "on a thick wallet"}, {"s": 1.742, "e": 2.553, "t": "every day?"}, {"s": 7.425, "e": 8.363, "t": "Back pocket wallets are"}, {"s": 8.363, "e": 9.302, "t": "a habit for millions"}, {"s": 9.302, "e": 10.155, "t": "of people."}, {"s": 10.155, "e": 11.179, "t": "Most people never even"}, {"s": 11.179, "e": 12.033, "t": "notice it."}, {"s": 12.033, "e": 12.971, "t": "Lots of people carry"}, {"s": 12.971, "e": 13.569, "t": "cards,"}, {"s": 13.569, "e": 14.678, "t": "cash and receipts all"}, {"s": 14.678, "e": 15.574, "t": "in one."}, {"s": 20.446, "e": 21.598, "t": "But here's the twist."}, {"s": 21.598, "e": 22.793, "t": "It tilts your hips,"}, {"s": 22.793, "e": 23.433, "t": "and it can press"}, {"s": 23.433, "e": 24.713, "t": "on the sciatic nerve,"}, {"s": 24.713, "e": 25.822, "t": "causing pain all the"}, {"s": 25.822, "e": 27.145, "t": "way down your leg."}, {"s": 27.145, "e": 28.254, "t": "Doctors even call it"}, {"s": 28.254, "e": 29.747, "t": "wallet neuritis!"}, {"s": 29.747, "e": 30.601, "t": "Moving your wallet to"}, {"s": 30.601, "e": 31.454, "t": "a front pocket is"}, {"s": 31.454, "e": 32.819, "t": "an easy fix."}, {"s": 32.819, "e": 34.227, "t": "Sitting unevenly for hours"}, {"s": 34.227, "e": 35.123, "t": "can also strain your"}, {"s": 35.123, "e": 36.105, "t": "lower back."}, {"s": 40.977, "e": 42.001, "t": "Front pocket or back"}, {"s": 42.001, "e": 42.683, "t": "pocket?"}, {"s": 42.683, "e": 43.579, "t": "Comment below,"}, {"s": 43.579, "e": 44.944, "t": "and subscribe for more!"}]