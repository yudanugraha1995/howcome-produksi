[{"s": 0.0, "e": 0.803, "t": "What if you cracked"}, {"s": 0.803, "e": 1.913, "t": "your back every single"}, {"s": 1.913, "e": 2.51, "t": "day?"}, {"s": 6.758, "e": 8.038, "t": "It feels amazing,"}, {"s": 8.038, "e": 8.849, "t": "and lots of people"}, {"s": 8.849, "e": 10.086, "t": "do it every morning."}, {"s": 10.086, "e": 10.939, "t": "That pop is just"}, {"s": 10.939, "e": 12.049, "t": "gas bubbles bursting in"}, {"s": 12.049, "e": 12.859, "t": "the fluid around your"}, {"s": 12.859, "e": 13.585, "t": "joints."}, {"s": 13.585, "e": 14.31, "t": "It's the same thing"}, {"s": 14.31, "e": 15.163, "t": "that happens when you"}, {"s": 15.163, "e": 16.315, "t": "crack your knuckles."}, {"s": 20.563, "e": 21.929, "t": "But here's the twist."}, {"s": 21.929, "e": 22.782, "t": "Doing it gently is"}, {"s": 22.782, "e": 23.977, "t": "usually harmless,"}, {"s": 23.977, "e": 24.873, "t": "but forcing it over"}, {"s": 24.873, "e": 25.897, "t": "and over can stretch"}, {"s": 25.897, "e": 26.835, "t": "the ligaments and make"}, {"s": 26.835, "e": 28.158, "t": "joints less stable."}, {"s": 28.158, "e": 28.755, "t": "And if you feel"}, {"s": 28.755, "e": 29.609, "t": "the urge all the"}, {"s": 29.609, "e": 30.291, "t": "time,"}, {"s": 30.291, "e": 31.187, "t": "tight muscles might be"}, {"s": 31.187, "e": 32.339, "t": "the real problem."}, {"s": 32.339, "e": 33.534, "t": "Doctors say stretching and"}, {"s": 33.534, "e": 34.558, "t": "moving more often can"}, {"s": 34.558, "e": 35.07, "t": "help,"}, {"s": 35.07, "e": 35.753, "t": "and pain is a"}, {"s": 35.753, "e": 36.905, "t": "sign to stop."}, {"s": 41.153, "e": 41.793, "t": "Do you crack your"}, {"s": 41.793, "e": 42.518, "t": "back?"}, {"s": 42.518, "e": 43.542, "t": "Comment below,"}, {"s": 43.542, "e": 44.95, "t": "and subscribe for more!"}]