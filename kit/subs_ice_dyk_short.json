[{"s": 0.0, "e": 1.28, "t": "Why does ice float"}, {"s": 1.44, "e": 2.44, "t": "instead of sink?"}, {"s": 3.233, "e": 4.313, "t": "Most solids sink in"}, {"s": 4.353, "e": 5.553, "t": "their own liquid."}, {"s": 6.226, "e": 7.346, "t": "But here's the surprising"}, {"s": 7.426, "e": 8.066, "t": "part:"}, {"s": 8.186, "e": 9.346, "t": "when water freezes,"}, {"s": 9.466, "e": 10.786, "t": "its molecules lock into"}, {"s": 10.906, "e": 12.146, "t": "an open pattern,"}, {"s": 12.226, "e": 13.346, "t": "so ice is about"}, {"s": 13.466, "e": 14.786, "t": "nine percent lighter."}, {"s": 14.906, "e": 15.906, "t": "That keeps lakes from"}, {"s": 16.026, "e": 17.186, "t": "freezing solid!"}, {"s": 17.859, "e": 18.579, "t": "Knew that?"}, {"s": 18.779, "e": 19.139, "t": "Comment,"}, {"s": 19.179, "e": 20.179, "t": "and subscribe!"}]