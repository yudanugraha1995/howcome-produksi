[{"s": 0.5, "e": 0.78, "t": "Ahh!"}, {"s": 1.02, "e": 1.8, "t": "Freezing water,"}, {"s": 1.98, "e": 2.58, "t": "first thing in the"}, {"s": 2.62, "e": 3.0, "t": "morning."}, {"s": 3.18, "e": 3.74, "t": "What if you took"}, {"s": 3.8, "e": 5.0, "t": "a cold shower every"}, {"s": 5.14, "e": 5.78, "t": "single day?"}, {"s": 5.9, "e": 6.86, "t": "Would it change anything,"}, {"s": 7.02, "e": 7.54, "t": "or is it just"}, {"s": 7.58, "e": 8.38, "t": "pain for nothing?"}, {"s": 25.264, "e": 26.384, "t": "Cold showers are all"}, {"s": 26.444, "e": 27.064, "t": "over the internet."}, {"s": 27.224, "e": 27.904, "t": "More energy,"}, {"s": 28.084, "e": 28.604, "t": "less fat,"}, {"s": 28.764, "e": 29.564, "t": "a tougher mind."}, {"s": 29.684, "e": 30.544, "t": "But what does real"}, {"s": 30.664, "e": 31.324, "t": "science say?"}, {"s": 48.388, "e": 49.268, "t": "The first seconds are"}, {"s": 49.328, "e": 49.848, "t": "a shock."}, {"s": 50.008, "e": 50.568, "t": "You gasp,"}, {"s": 50.708, "e": 51.348, "t": "breathe fast,"}, {"s": 51.428, "e": 52.468, "t": "and your heart races."}, {"s": 52.608, "e": 53.568, "t": "That's the cold shock"}, {"s": 53.608, "e": 54.108, "t": "response,"}, {"s": 54.308, "e": 55.048, "t": "so be careful if"}, {"s": 55.088, "e": 56.008, "t": "you have heart problems."}, {"s": 72.872, "e": 72.873, "t": "Now the real test."}, {"s": 72.912, "e": 72.933, "t": "In the Netherlands,"}, {"s": 72.933, "e": 74.332, "t": "about three thousand people"}, {"s": 74.372, "e": 75.452, "t": "ended their hot shower"}, {"s": 75.492, "e": 76.392, "t": "with cold water for"}, {"s": 76.452, "e": 76.832, "t": "a month."}, {"s": 76.992, "e": 77.892, "t": "The cold groups took"}, {"s": 77.932, "e": 79.252, "t": "about thirty percent fewer"}, {"s": 79.272, "e": 80.312, "t": "sick days off work."}, {"s": 80.412, "e": 81.132, "t": "But they didn't get"}, {"s": 81.212, "e": 82.132, "t": "sick less often."}, {"s": 82.252, "e": 83.072, "t": "They just felt okay"}, {"s": 83.132, "