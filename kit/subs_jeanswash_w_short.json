[{"s": 0.0, "e": 0.803, "t": "What if you never"}, {"s": 0.803, "e": 2.169, "t": "washed your jeans?"}, {"s": 6.473, "e": 7.497, "t": "Most people toss their"}, {"s": 7.497, "e": 8.307, "t": "jeans in the wash"}, {"s": 8.307, "e": 9.118, "t": "after just a few"}, {"s": 9.118, "e": 9.886, "t": "wears."}, {"s": 9.886, "e": 10.611, "t": "Even the boss of"}, {"s": 10.611, "e": 11.849, "t": "Levi's said he almost"}, {"s": 11.849, "e": 13.257, "t": "never washes his!"}, {"s": 13.257, "e": 13.982, "t": "He said it helps"}, {"s": 13.982, "e": 14.921, "t": "jeans keep their shape"}, {"s": 14.921, "e": 15.774, "t": "and color."}, {"s": 20.078, "e": 21.358, "t": "But here's the twist."}, {"s": 21.358, "e": 22.595, "t": "Freezing jeans doesn't really"}, {"s": 22.595, "e": 23.534, "t": "kill the germs,"}, {"s": 23.534, "e": 24.558, "t": "but spot cleaning and"}, {"s": 24.558, "e": 25.411, "t": "airing them out keeps"}, {"s": 25.411, "e": 26.478, "t": "them fresh longer,"}, {"s": 26.478, "e": 27.417, "t": "and they last longer"}, {"s": 27.417, "e": 28.099, "t": "too."}, {"s": 28.099, "e": 29.422, "t": "Washing less also saves"}, {"s": 29.422, "e": 30.019, "t": "water,"}, {"s": 30.019, "e": 30.787, "t": "and jeans take a"}, {"s": 30.787, "e": 31.513, "t": "lot of water to"}, {"s": 31.513, "e": 32.067, "t": "make."}, {"s": 32.067, "e": 32.835, "t": "If they smell or"}, {"s": 32.835, "e": 33.817, "t": "get stained,"}, {"s": 33.817, "e": 34.713, "t": "wash them inside out"}, {"s": 34.713, "e": 35.609, "t": "in cold water to"}, {"s": 35.609, "e": 36.718, "t": "keep the color."}, {"s": 41.022, "e": 41.619, "t": "How often do you"}, {"s": 41.619, "e": 42.729, "t": "wash your jeans?"}, {"s": 42.729, "e": 43.625, "t": "Comment below,"}, {"s": 43.625, "e": 44.947, "t": "and subscribe for more!"}]