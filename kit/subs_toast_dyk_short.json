[{"s": 0.0, "e": 1.12, "t": "Why does toast land"}, {"s": 1.28, "e": 2.4, "t": "butter side down?"}, {"s": 3.153, "e": 4.473, "t": "It's not bad luck."}, {"s": 5.266, "e": 6.386, "t": "But here's the surprising"}, {"s": 6.466, "e": 7.026, "t": "part:"}, {"s": 7.106, "e": 8.226, "t": "a physicist found that"}, {"s": 8.306, "e": 9.826, "t": "from normal table height,"}, {"s": 9.906, "e": 11.026, "t": "toast only has time"}, {"s": 11.106, "e": 11.986, "t": "to flip half a"}, {"s": 12.146, "e": 12.946, "t": "turn before it hits"}, {"s": 13.026, "e": 13.786, "t": "the floor!"}, {"s": 14.579, "e": 15.379, "t": "Has this happened to"}, {"s": 15.459, "e": 15.939, "t": "you?"}, {"s": 16.019, "e": 16.579, "t": "Comment,"}, {"s": 16.619, "e": 17.619, "t": "and subscribe!"}]