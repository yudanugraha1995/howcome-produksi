[{"s": 0.0, "e": 0.88, "t": "Why is the sky"}, {"s": 0.96, "e": 1.44, "t": "blue?"}, {"s": 2.513, "e": 3.953, "t": "Sunlight hits the air,"}, {"s": 4.033, "e": 5.473, "t": "and tiny gas molecules"}, {"s": 5.673, "e": 7.713, "t": "scatter blue light everywhere."}, {"s": 8.346, "e": 9.266, "t": "But here's the surprising"}, {"s": 9.346, "e": 10.066, "t": "part:"}, {"s": 10.146, "e": 11.586, "t": "violet light scatters even"}, {"s": 11.666, "e": 12.946, "t": "more than blue!"}, {"s": 13.066, "e": 13.906, "t": "Our eyes are just"}, {"s": 14.026, "e": 15.666, "t": "more sensitive to blue."}, {"s": 16.339, "e": 18.019, "t": "Sunrise or sunset?"}, {"s": 18.259, "e": 18.579, "t": "Comment,"}, {"s": 18.659, "e": 19.699, "t": "and subscribe!"}]