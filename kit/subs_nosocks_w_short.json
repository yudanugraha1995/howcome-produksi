[{"s": 0.0, "e": 0.803, "t": "What if you wore"}, {"s": 0.803, "e": 2.083, "t": "shoes without socks every"}, {"s": 2.083, "e": 2.937, "t": "day?"}, {"s": 6.497, "e": 7.435, "t": "Lots of people skip"}, {"s": 7.435, "e": 8.459, "t": "socks with sneakers or"}, {"s": 8.459, "e": 9.441, "t": "loafers for a cleaner"}, {"s": 9.441, "e": 10.081, "t": "look."}, {"s": 10.081, "e": 10.849, "t": "Your feet have about"}, {"s": 10.849, "e": 12.001, "t": "a quarter million sweat"}, {"s": 12.001, "e": 12.598, "t": "glands."}, {"s": 12.598, "e": 13.409, "t": "Your feet can sweat"}, {"s": 13.409, "e": 14.518, "t": "a lot every day,"}, {"s": 14.518, "e": 16.31, "t": "especially in closed shoes."}, {"s": 19.87, "e": 21.193, "t": "But here's the twist."}, {"s": 21.193, "e": 22.387, "t": "Without socks,"}, {"s": 22.387, "e": 23.326, "t": "sweat soaks into your"}, {"s": 23.326, "e": 24.009, "t": "shoes,"}, {"s": 24.009, "e": 25.374, "t": "bacteria feast on it,"}, {"s": 25.374, "e": 26.099, "t": "and that's what makes"}, {"s": 26.099, "e": 26.91, "t": "the smell,"}, {"s": 26.91, "e": 27.763, "t": "plus a higher chance"}, {"s": 27.763, "e": 29.299, "t": "of athlete's foot!"}, {"s": 29.299, "e": 30.281, "t": "Rotate your shoes so"}, {"s": 30.281, "e": 30.963, "t": "they dry out for"}, {"s": 30.963, "e": 31.646, "t": "a day,"}, {"s": 31.646, "e": 32.585, "t": "and pick socks that"}, {"s": 32.585, "e": 33.822, "t": "wick sweat away."}, {"s": 33.822, "e": 34.846, "t": "Doctors say wash your"}, {"s": 34.846, "e": 35.955, "t": "feet every day and"}, {"s": 35.955, "e": 36.894, "t": "dry well between your"}, {"s": 36.894, "e": 37.705, "t": "toes."}, {"s": 41.265, "e": 42.673, "t": "Socks or no socks?"}, {"s": 42.673, "e": 43.569, "t": "Comment below,"}, {"s": 43.569, "e": 44.934, "t": "and subscribe for more!"}]