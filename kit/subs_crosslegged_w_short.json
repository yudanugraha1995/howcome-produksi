[{"s": 0.0, "e": 0.803, "t": "What if you sat"}, {"s": 0.803, "e": 1.955, "t": "with your legs crossed"}, {"s": 1.955, "e": 2.937, "t": "every day?"}, {"s": 7.577, "e": 8.473, "t": "Lots of people cross"}, {"s": 8.473, "e": 9.539, "t": "their legs at work,"}, {"s": 9.539, "e": 10.265, "t": "in class or on"}, {"s": 10.265, "e": 11.203, "t": "the couch."}, {"s": 11.203, "e": 12.227, "t": "It feels comfy and"}, {"s": 12.227, "e": 13.166, "t": "polite."}, {"s": 13.166, "e": 13.934, "t": "Most people do it"}, {"s": 13.934, "e": 15.214, "t": "without even thinking."}, {"s": 19.854, "e": 21.134, "t": "But here's the twist."}, {"s": 21.134, "e": 22.414, "t": "It doesn't cause varicose"}, {"s": 22.414, "e": 23.054, "t": "veins,"}, {"s": 23.054, "e": 23.993, "t": "that's a myth,"}, {"s": 23.993, "e": 24.675, "t": "but it can raise"}, {"s": 24.675, "e": 25.529, "t": "your blood pressure for"}, {"s": 25.529, "e": 26.467, "t": "a moment and press"}, {"s": 26.467, "e": 27.363, "t": "on a nerve,"}, {"s": 27.363, "e": 28.985, "t": "making your foot tingle!"}, {"s": 28.985, "e": 30.35, "t": "Doctors say switch sides"}, {"s": 30.35, "e": 31.203, "t": "and stand up every"}, {"s": 31.203, "e": 32.483, "t": "half hour or so."}, {"s": 32.483, "e": 33.337, "t": "If your foot often"}, {"s": 33.337, "e": 34.275, "t": "goes numb,"}, {"s": 34.275, "e": 35.257, "t": "try sitting with both"}, {"s": 35.257, "e": 36.067, "t": "feet flat on the"}, {"s": 36.067, "e": 36.878, "t": "floor."}, {"s": 41.518, "e": 42.115, "t": "Do you cross your"}, {"s": 42.115, "e": 42.883, "t": "legs?"}, {"s": 42.883, "e": 43.737, "t": "Comment below,"}, {"s": 43.737, "e": 44.931, "t": "and subscribe for more!"}]