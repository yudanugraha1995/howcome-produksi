[{"s": 0.0, "e": 0.718, "t": "What if you rubbed"}, {"s": 0.718, "e": 2.211, "t": "your eyes every day?"}, {"s": 5.659, "e": 6.342, "t": "Tired,"}, {"s": 6.342, "e": 7.494, "t": "itchy or dry eyes"}, {"s": 7.494, "e": 8.305, "t": "make people rub them"}, {"s": 8.305, "e": 9.585, "t": "without thinking."}, {"s": 9.585, "e": 10.609, "t": "It feels so good"}, {"s": 10.609, "e": 11.761, "t": "when they're tired."}, {"s": 11.761, "e": 12.699, "t": "Rubbing can trigger a"}, {"s": 12.699, "e": 13.809, "t": "reflex that slows your"}, {"s": 13.809, "e": 14.833, "t": "heartbeat a little,"}, {"s": 14.833, "e": 15.43, "t": "which is why it"}, {"s": 15.43, "e": 16.71, "t": "feels calming."}, {"s": 20.158, "e": 21.523, "t": "But here's the twist."}, {"s": 21.523, "e": 22.547, "t": "Your hands can spread"}, {"s": 22.547, "e": 23.657, "t": "germs to your eyes,"}, {"s": 23.657, "e": 24.553, "t": "and lots of hard"}, {"s": 24.553, "e": 25.449, "t": "rubbing over the years"}, {"s": 25.449, "e": 27.198, "t": "is linked to keratoconus,"}, {"s": 27.198, "e": 28.222, "t": "where the cornea thins"}, {"s": 28.222, "e": 29.801, "t": "into a cone shape!"}, {"s": 29.801, "e": 30.611, "t": "If your eyes itch"}, {"s": 30.611, "e": 31.337, "t": "a lot,"}, {"s": 31.337, "e": 32.531, "t": "allergy drops or a"}, {"s": 32.531, "e": 34.281, "t": "cool compress are better."}, {"s": 34.281, "e": 35.091, "t": "Eye doctors say if"}, {"s": 35.091, "e": 35.646, "t": "you have to touch"}, {"s": 35.646, "e": 36.499, "t": "your eyes,"}, {"s": 36.499, "e": 37.907, "t": "wash your hands first."}, {"s": 41.355, "e": 41.867, "t": "Do you rub your"}, {"s": 41.867, "e": 42.635, "t": "eyes?"}, {"s": 42.635, "e": 43.617, "t": "Comment below,"}, {"s": 43.617, "e": 44.939, "t": "and subscribe for more!"}]