[{"s": 0.0, "e": 1.04, "t": "Why does your stomach"}, {"s": 1.2, "e": 1.84, "t": "growl?"}, {"s": 2.513, "e": 3.393, "t": "Most people think it"}, {"s": 3.473, "e": 4.593, "t": "only happens when you're"}, {"s": 4.673, "e": 5.473, "t": "hungry."}, {"s": 6.146, "e": 7.186, "t": "But here's the surprising"}, {"s": 7.266, "e": 7.906, "t": "part:"}, {"s": 8.026, "e": 9.426, "t": "your gut squeezes and"}, {"s": 9.466, "e": 11.266, "t": "rumbles all the time."}, {"s": 11.346, "e": 12.066, "t": "When your stomach is"}, {"s": 12.146, "e": 12.786, "t": "empty,"}, {"s": 12.866, "e": 14.439, "t": "nothing muffles the sound,"}, {"s": 14.493, "e": 15.826, "t": "so it gets louder!"}, {"s": 16.499, "e": 17.619, "t": "Does yours growl?"}, {"s": 17.819, "e": 18.179, "t": "Comment,"}, {"s": 18.259, "e": 19.299, "t": "and subscribe!"}]