[{"s": 0.12, "e": 1.2, "t": "Look at your fingertips."}, {"s": 2.56, "e": 3.36, "t": "What if those little"}, {"s": 3.42, "e": 5.06, "t": "swirls just disappeared?"}, {"s": 14.687, "e": 15.967, "t": "Some people really are"}, {"s": 15.987, "e": 17.367, "t": "born with no fingerprints."}, {"s": 17.587, "e": 18.447, "t": "It's a very rare"}, {"s": 18.587, "e": 19.267, "t": "gene change."}, {"s": 19.527, "e": 20.607, "t": "Fingerprints may help you"}, {"s": 20.667, "e": 21.967, "t": "grip and feel textures."}, {"s": 31.514, "e": 32.274, "t": "Plot twist!"}, {"s": 32.434, "e": 34.053, "t": "Koalas have fingerprints too,"}, {"s": 34.234, "e": 35.034, "t": "and they look so"}, {"s": 35.074, "e": 35.974, "t": "much like ours they"}, {"s": 35.994, "e": 37.074, "t": "could fool an expert!"}, {"s": 46.841, "e": 47.781, "t": "Loops or whirls?"}, {"s": 47.941, "e": 48.821, "t": "Check your fingers and"}, {"s": 48.861, "e": 49.301, "t": "tell me in the"}, {"s": 49.341, "e": 49.881, "t": "comments!"}]