[{"s": 0.0, "e": 0.761, "t": "What if you held"}, {"s": 0.761, "e": 2.211, "t": "your pee every day?"}, {"s": 4.859, "e": 5.585, "t": "Teachers,"}, {"s": 5.585, "e": 6.438, "t": "nurses,"}, {"s": 6.438, "e": 7.846, "t": "drivers and gamers often"}, {"s": 7.846, "e": 9.425, "t": "hold it for hours."}, {"s": 9.425, "e": 10.619, "t": "Your bladder stretches like"}, {"s": 10.619, "e": 11.729, "t": "a balloon and can"}, {"s": 11.729, "e": 13.563, "t": "hold about two cups."}, {"s": 13.563, "e": 14.331, "t": "When it's about half"}, {"s": 14.331, "e": 14.929, "t": "full,"}, {"s": 14.929, "e": 15.867, "t": "your bladder sends the"}, {"s": 15.867, "e": 17.361, "t": "first signal to go."}, {"s": 20.009, "e": 21.289, "t": "But here's the twist."}, {"s": 21.289, "e": 22.355, "t": "Holding it too often"}, {"s": 22.355, "e": 23.251, "t": "can weaken your bladder"}, {"s": 23.251, "e": 24.574, "t": "muscles over time and"}, {"s": 24.574, "e": 25.342, "t": "raise your risk of"}, {"s": 25.342, "e": 27.262, "t": "urinary tract infections."}, {"s": 27.262, "e": 28.371, "t": "Most adults pee about"}, {"s": 28.371, "e": 29.182, "t": "six to eight times"}, {"s": 29.182, "e": 29.907, "t": "a day,"}, {"s": 29.907, "e": 30.59, "t": "so going when you"}, {"s": 30.59, "e": 31.443, "t": "feel the urge is"}, {"s": 31.443, "e": 32.851, "t": "the healthy choice."}, {"s": 32.851, "e": 33.875, "t": "In rare cases,"}, {"s": 33.875, "e": 34.899, "t": "holding it way too"}, {"s": 34.899, "e": 35.923, "t": "long can stretch the"}, {"s": 35.923, "e": 36.905, "t": "bladder so much that"}, {"s": 36.905, "e": 38.398, "t": "it struggles to empty."}, {"s": 41.046, "e": 41.686, "t": "How long can you"}, {"s": 41.686, "e": 42.71, "t": "hold it?"}, {"s": 42.71, "e": 43.649, "t": "Comment below,"}, {"s": 43.649, "e": 44.928, "t": "and subscribe for more!"}]