[{"s": 0.0, "e": 0.761, "t": "What if you held"}, {"s": 0.761, "e": 2.169, "t": "your pee every day?"}, {"s": 2.715, "e": 3.824, "t": "Your bladder stretches like"}, {"s": 3.824, "e": 4.848, "t": "a balloon and can"}, {"s": 4.848, "e": 6.64, "t": "hold about two cups."}, {"s": 7.186, "e": 8.509, "t": "But here's the twist."}, {"s": 8.509, "e": 9.575, "t": "Holding it too often"}, {"s": 9.575, "e": 10.557, "t": "can weaken your bladder"}, {"s": 10.557, "e": 11.965, "t": "muscles over time and"}, {"s": 11.965, "e": 12.775, "t": "raise your risk of"}, {"s": 12.775, "e": 14.567, "t": "urinary tract infections."}, {"s": 15.113, "e": 15.753, "t": "How long can you"}, {"s": 15.753, "e": 16.777, "t": "hold it?"}, {"s": 16.777, "e": 17.844, "t": "Comment below,"}, {"s": 17.844, "e": 19.166, "t": "and subscribe for more!"}]