[{"s": 0.0, "e": 0.803, "t": "What if you quit"}, {"s": 0.803, "e": 2.51, "t": "sugar for thirty days?"}, {"s": 4.366, "e": 5.689, "t": "The average American eats"}, {"s": 5.689, "e": 7.353, "t": "about seventeen teaspoons of"}, {"s": 7.353, "e": 8.974, "t": "added sugar a day."}, {"s": 8.974, "e": 9.913, "t": "The first few days"}, {"s": 9.913, "e": 10.638, "t": "can be rough,"}, {"s": 10.638, "e": 12.345, "t": "with cravings and headaches."}, {"s": 12.345, "e": 13.497, "t": "Added sugar hides in"}, {"s": 13.497, "e": 14.307, "t": "sauces,"}, {"s": 14.307, "e": 15.331, "t": "bread and even salad"}, {"s": 15.331, "e": 16.227, "t": "dressing."}, {"s": 18.083, "e": 19.491, "t": "But here's the twist."}, {"s": 19.491, "e": 20.771, "t": "Studies suggest that after"}, {"s": 20.771, "e": 21.625, "t": "cutting sugar for a"}, {"s": 21.625, "e": 22.393, "t": "while,"}, {"s": 22.393, "e": 24.185, "t": "sweet foods taste sweeter,"}, {"s": 24.185, "e": 25.806, "t": "because your taste adjusts!"}, {"s": 25.806, "e": 26.787, "t": "Even fruit can taste"}, {"s": 26.787, "e": 27.897, "t": "like candy."}, {"s": 27.897, "e": 29.433, "t": "The American Heart Association"}, {"s": 29.433, "e": 30.755, "t": "suggests no more than"}, {"s": 30.755, "e": 31.694, "t": "about six to nine"}, {"s": 31.694, "e": 32.889, "t": "teaspoons of added sugar"}, {"s": 32.889, "e": 33.827, "t": "a day."}, {"s": 33.827, "e": 35.193, "t": "Cutting back slowly,"}, {"s": 35.193, "e": 36.174, "t": "like halving the sugar"}, {"s": 36.174, "e": 37.155, "t": "in your coffee,"}, {"s": 37.155, "e": 37.881, "t": "can make it much"}, {"s": 37.881, "e": 38.905, "t": "easier."}, {"s": 40.761, "e": 41.614, "t": "Could you quit sugar"}, {"s": 41.614, "e": 42.638, "t": "for a month?"}, {"s": 42.638, "e": 43.534, "t": "Comment below,"}, {"s": 43.534, "e": 44.942, "t": "and subscribe for more!"}]