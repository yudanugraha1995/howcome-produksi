[{"s": 0.7, "e": 1.28, "t": "It's two in the"}, {"s": 1.36, "e": 1.9, "t": "afternoon,"}, {"s": 1.96, "e": 2.62, "t": "and your eyes are"}, {"s": 2.66, "e": 3.1, "t": "closing."}, {"s": 3.7, "e": 4.26, "t": "What if you took"}, {"s": 4.3, "e": 5.52, "t": "a nap every single"}, {"s": 5.62, "e": 6.14, "t": "afternoon?"}, {"s": 6.44, "e": 6.82, "t": "Lazy,"}, {"s": 7.2, "e": 7.92, "t": "or genius?"}, {"s": 8.52, "e": 9.2, "t": "Let's find out what"}, {"s": 9.26, "e": 9.92, "t": "science says."}, {"s": 10.21, "e": 11.27, "t": "But nap too long"}, {"s": 11.29, "e": 12.23, "t": "and you slide into"}, {"s": 12.25, "e": 12.89, "t": "deep sleep."}, {"s": 13.05, "e": 13.79, "t": "Wake up from that,"}, {"s": 13.81, "e": 14.83, "t": "and you feel worse,"}, {"s": 14.99, "e": 16.03, "t": "groggy and slow,"}, {"s": 16.17, "e": 16.81, "t": "for a while."}, {"s": 17.11, "e": 17.93, "t": "Short naps are the"}, {"s": 18.01, "e": 18.47, "t": "secret."}, {"s": 18.67, "e": 19.67, "t": "NASA tested it on"}, {"s": 19.73, "e": 20.59, "t": "airline pilots."}, {"s": 20.79, "e": 21.57, "t": "A nap of about"}, {"s": 21.61, "e": 22.89, "t": "twenty six minutes boosted"}, {"s": 22.91, "e": 23.99, "t": "their performance by thirty"}, {"s": 24.09, "e": 24.77, "t": "four percent,"}, {"s": 24.91, "e": 25.95, "t": "and their alertness by"}, {"s": 25.99, "e": 27.009, "t": "fifty four percent."}, {"s": 27.25, "e": 27.65, "t": "Huge,"}, {"s": 27.73, "e": 28.77, "t": "for a tiny nap!"}, {"s": 28.99, "e": 29.65, "t": "The trick is to"}, {"s": 29.73, "e": 30.97, "t": "stop before deep sleep,"}, {"s": 31.07, "e": 31.91, "t": "so set an alarm"}, {"s": 31.93, "e": 33.03, "t": "for about twenty minutes."}, {"s": 35.036, "e": 35.876, "t": "Plot twist!"}, {"s": 36.096, "e": 37.136, "t": "Try a coffee nap."}, {"s": 37.276, "e": 37.996, "t": "Drink a coffee,"}, {"s": 38.116, "e": 39.096, "t": "then nap right away"}, {"s": 39.136, "e": 40.396, "t": "for about fifteen minutes."}, {"s": 40.596, "e": 41.576, "t": "Caff