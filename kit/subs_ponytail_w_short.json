[{"s": 0.0, "e": 0.675, "t": "What if you wore"}, {"s": 0.675, "e": 2.041, "t": "a tight ponytail every"}, {"s": 2.041, "e": 2.979, "t": "single day?"}, {"s": 6.203, "e": 7.142, "t": "It's quick,"}, {"s": 7.142, "e": 8.166, "t": "neat and keeps hair"}, {"s": 8.166, "e": 9.361, "t": "off your face."}, {"s": 9.361, "e": 10.299, "t": "Pulling your hair back"}, {"s": 10.299, "e": 11.665, "t": "hard puts constant tension"}, {"s": 11.665, "e": 12.689, "t": "on the roots."}, {"s": 12.689, "e": 13.585, "t": "Some people even get"}, {"s": 13.585, "e": 14.651, "t": "headaches from a ponytail"}, {"s": 14.651, "e": 15.761, "t": "that's too tight."}, {"s": 18.985, "e": 20.222, "t": "But here's the twist."}, {"s": 20.222, "e": 21.246, "t": "Over time,"}, {"s": 21.246, "e": 22.313, "t": "that pulling can cause"}, {"s": 22.313, "e": 23.507, "t": "traction alopecia,"}, {"s": 23.507, "e": 24.275, "t": "a type of hair"}, {"s": 24.275, "e": 25.257, "t": "loss along the hairline"}, {"s": 25.257, "e": 26.835, "t": "that can become permanent."}, {"s": 26.835, "e": 28.542, "t": "Doctors suggest loosening it,"}, {"s": 28.542, "e": 29.993, "t": "changing its position often,"}, {"s": 29.993, "e": 31.23, "t": "and using soft scrunchies"}, {"s": 31.23, "e": 33.022, "t": "instead of tight bands."}, {"s": 33.022, "e": 33.875, "t": "The good news is"}, {"s": 33.875, "e": 34.43, "t": "that if you catch"}, {"s": 34.43, "e": 35.113, "t": "it early,"}, {"s": 35.113, "e": 36.222, "t": "the hair usually grows"}, {"s": 36.222, "e": 36.947, "t": "back."}, {"s": 40.171, "e": 41.366, "t": "Are you team ponytail"}, {"s": 41.366, "e": 42.859, "t": "or team hair down?"}, {"s": 42.859, "e": 43.755, "t": "Comment below,"}, {"s": 43.755, "e": 44.95, "t": "and subscribe for more!"}]