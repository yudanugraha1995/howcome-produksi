[{"s": 0.0, "e": 0.846, "t": "What if you breathed"}, {"s": 0.846, "e": 1.657, "t": "through your mouth all"}, {"s": 1.657, "e": 2.467, "t": "night?"}, {"s": 6.883, "e": 7.822, "t": "Your body is built"}, {"s": 7.822, "e": 8.675, "t": "to breathe through your"}, {"s": 8.675, "e": 9.401, "t": "nose,"}, {"s": 9.401, "e": 10.553, "t": "day and night."}, {"s": 10.553, "e": 11.235, "t": "You'd wake up with"}, {"s": 11.235, "e": 12.259, "t": "a dry mouth."}, {"s": 12.259, "e": 13.326, "t": "A stuffy nose or"}, {"s": 13.326, "e": 14.393, "t": "allergies are often the"}, {"s": 14.393, "e": 15.246, "t": "reason."}, {"s": 19.662, "e": 20.985, "t": "But here's the twist."}, {"s": 20.985, "e": 22.35, "t": "Your nose filters,"}, {"s": 22.35, "e": 23.459, "t": "warms and moistens the"}, {"s": 23.459, "e": 24.099, "t": "air,"}, {"s": 24.099, "e": 25.123, "t": "so mouth breathing can"}, {"s": 25.123, "e": 26.403, "t": "lead to bad breath,"}, {"s": 26.403, "e": 27.939, "t": "cavities and snoring!"}, {"s": 27.939, "e": 28.622, "t": "It can also make"}, {"s": 28.622, "e": 30.073, "t": "sleep apnea worse,"}, {"s": 30.073, "e": 30.883, "t": "so a blocked nose"}, {"s": 30.883, "e": 32.121, "t": "is worth checking."}, {"s": 32.121, "e": 33.017, "t": "In kids,"}, {"s": 33.017, "e": 34.126, "t": "long term mouth breathing"}, {"s": 34.126, "e": 35.065, "t": "can even affect how"}, {"s": 35.065, "e": 35.918, "t": "the face and teeth"}, {"s": 35.918, "e": 36.686, "t": "grow."}, {"s": 41.102, "e": 42.723, "t": "Nose or mouth breather?"}, {"s": 42.723, "e": 43.705, "t": "Comment below,"}, {"s": 43.705, "e": 44.942, "t": "and subscribe for more!"}]