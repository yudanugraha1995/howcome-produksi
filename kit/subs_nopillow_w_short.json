[{"s": 0.0, "e": 0.803, "t": "What if you slept"}, {"s": 0.803, "e": 2.169, "t": "without a pillow?"}, {"s": 7.377, "e": 8.273, "t": "Most people have slept"}, {"s": 8.273, "e": 8.955, "t": "with a pillow their"}, {"s": 8.955, "e": 9.894, "t": "whole life."}, {"s": 9.894, "e": 10.747, "t": "Some people swear by"}, {"s": 10.747, "e": 11.302, "t": "it."}, {"s": 11.302, "e": 12.198, "t": "A pillow's job is"}, {"s": 12.198, "e": 12.838, "t": "to keep your head"}, {"s": 12.838, "e": 13.563, "t": "and neck in line"}, {"s": 13.563, "e": 14.63, "t": "with your spine."}, {"s": 19.838, "e": 21.118, "t": "But here's the twist."}, {"s": 21.118, "e": 21.971, "t": "It can help stomach"}, {"s": 21.971, "e": 22.995, "t": "sleepers keep their neck"}, {"s": 22.995, "e": 23.806, "t": "straighter,"}, {"s": 23.806, "e": 24.531, "t": "but for back and"}, {"s": 24.531, "e": 25.427, "t": "side sleepers,"}, {"s": 25.427, "e": 26.153, "t": "it can bend your"}, {"s": 26.153, "e": 26.963, "t": "neck the wrong way"}, {"s": 26.963, "e": 28.499, "t": "and leave you stiff!"}, {"s": 28.499, "e": 29.651, "t": "Side sleepers usually need"}, {"s": 29.651, "e": 30.761, "t": "the thickest pillow,"}, {"s": 30.761, "e": 31.486, "t": "to fill the gap"}, {"s": 31.486, "e": 32.553, "t": "by the shoulder."}, {"s": 32.553, "e": 33.449, "t": "The right pillow should"}, {"s": 33.449, "e": 34.345, "t": "keep your nose lined"}, {"s": 34.345, "e": 34.942, "t": "up with the middle"}, {"s": 34.942, "e": 35.881, "t": "of your chest."}, {"s": 41.089, "e": 42.753, "t": "Pillow or no pillow?"}, {"s": 42.753, "e": 43.691, "t": "Comment below,"}, {"s": 43.691, "e": 44.928, "t": "and subscribe for more!"}]