[{"s": 0.0, "e": 0.846, "t": "What if you didn't"}, {"s": 0.846, "e": 2.51, "t": "sleep for three days?"}, {"s": 6.126, "e": 7.406, "t": "Most adults need about"}, {"s": 7.406, "e": 8.387, "t": "seven to nine hours"}, {"s": 8.387, "e": 9.838, "t": "of sleep every night."}, {"s": 9.838, "e": 10.819, "t": "After one night,"}, {"s": 10.819, "e": 11.886, "t": "you'd feel slow and"}, {"s": 11.886, "e": 12.611, "t": "moody."}, {"s": 12.611, "e": 13.977, "t": "Your reaction time slows"}, {"s": 13.977, "e": 14.702, "t": "down like you've been"}, {"s": 14.702, "e": 15.513, "t": "drinking."}, {"s": 19.129, "e": 20.494, "t": "But here's the twist."}, {"s": 20.494, "e": 21.561, "t": "After a few days,"}, {"s": 21.561, "e": 22.627, "t": "people can start seeing"}, {"s": 22.627, "e": 24.078, "t": "things that aren't there."}, {"s": 24.078, "e": 24.974, "t": "The record is about"}, {"s": 24.974, "e": 26.041, "t": "eleven days,"}, {"s": 26.041, "e": 26.979, "t": "set by a teenager"}, {"s": 26.979, "e": 28.729, "t": "in nineteen sixty four!"}, {"s": 28.729, "e": 29.923, "t": "Doctors say never try"}, {"s": 29.923, "e": 30.435, "t": "this,"}, {"s": 30.435, "e": 31.203, "t": "because sleep is when"}, {"s": 31.203, "e": 32.782, "t": "your brain cleans itself."}, {"s": 32.782, "e": 33.891, "t": "Even one night without"}, {"s": 33.891, "e": 34.787, "t": "sleep can affect you"}, {"s": 34.787, "e": 35.47, "t": "about as much as"}, {"s": 35.47, "e": 36.409, "t": "being over the legal"}, {"s": 36.409, "e": 37.603, "t": "alcohol limit."}, {"s": 41.219, "e": 41.817, "t": "How long have you"}, {"s": 41.817, "e": 42.755, "t": "stayed awake?"}, {"s": 42.755, "e": 43.651, "t": "Comment below,"}, {"s": 43.651, "e": 44.931, "t": "and subscribe for more!"}]