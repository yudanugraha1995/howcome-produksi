[{"s": 0.26, "e": 1.02, "t": "No haircut."}, {"s": 1.74, "e": 2.46, "t": "Ever again."}, {"s": 2.66, "e": 3.36, "t": "What if you never"}, {"s": 3.5, "e": 4.18, "t": "cut your hair?"}, {"s": 13.82, "e": 14.86, "t": "Hair grows about one"}, {"s": 14.96, "e": 15.76, "t": "centimeter a month."}, {"s": 15.98, "e": 17.04, "t": "But each hair only"}, {"s": 17.08, "e": 17.8, "t": "grows for a few"}, {"s": 17.92, "e": 18.3, "t": "years,"}, {"s": 18.46, "e": 19.26, "t": "then falls out."}, {"s": 19.46, "e": 20.42, "t": "So for most people,"}, {"s": 20.58, "e": 21.8, "t": "it stops somewhere around"}, {"s": 21.84, "e": 22.32, "t": "the waist."}, {"s": 32.02, "e": 32.64, "t": "Plot twist!"}, {"s": 32.92, "e": 33.92, "t": "One woman grew her"}, {"s": 33.98, "e": 35.78, "t": "hair over five meters"}, {"s": 35.84, "e": 36.18, "t": "long."}, {"s": 36.44, "e": 37.62, "t": "That's the world record!"}, {"s": 47.4, "e": 48.48, "t": "Long hair or short"}, {"s": 48.54, "e": 48.74, "t": "hair?"}, {"s": 49.0, "e": 49.42, "t": "Tell me in the"}, {"s": 49.46, "e": 49.92, "t": "comments!"}]