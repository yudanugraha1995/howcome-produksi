[{"s": 0.46, "e": 1.08, "t": "Move back!"}, {"s": 1.14, "e": 1.88, "t": "You're sitting way too"}, {"s": 1.9, "e": 2.82, "t": "close to the TV!"}, {"s": 3.06, "e": 3.76, "t": "Sound familiar?"}, {"s": 4.019, "e": 4.96, "t": "What if you really"}, {"s": 5.02, "e": 5.96, "t": "sat super close to"}, {"s": 6.0, "e": 7.18, "t": "the screen every single"}, {"s": 7.28, "e": 7.56, "t": "day?"}, {"s": 7.74, "e": 8.46, "t": "Would it ruin your"}, {"s": 8.56, "e": 8.88, "t": "eyes?"}, {"s": 24.916, "e": 26.036, "t": "Almost every kid has"}, {"s": 26.076, "e": 26.896, "t": "heard this warning from"}, {"s": 26.936, "e": 27.516, "t": "their parents."}, {"s": 27.736, "e": 28.416, "t": "Some were told they"}, {"s": 28.436, "e": 29.356, "t": "would need glasses,"}, {"s": 29.496, "e": 30.616, "t": "or even go blind."}, {"s": 46.372, "e": 47.611, "t": "Here's what really happens."}, {"s": 47.852, "e": 48.632, "t": "Staring at a screen"}, {"s": 48.672, "e": 49.572, "t": "up close makes you"}, {"s": 49.592, "e": 50.212, "t": "blink less,"}, {"s": 50.392, "e": 51.032, "t": "so your eyes can"}, {"s": 51.072, "e": 51.712, "t": "feel dry,"}, {"s": 51.852, "e": 52.212, "t": "tired,"}, {"s": 52.252, "e": 52.792, "t": "and itchy."}, {"s": 52.952, "e": 54.072, "t": "Kids also focus up"}, {"s": 54.112, "e": 55.172, "t": "close more easily than"}, {"s": 55.212, "e": 55.892, "t": "adults do."}, {"s": 71.688, "e": 72.608, "t": "But eye doctors say"}, {"s": 72.648, "e": 73.388, "t": "sitting close to the"}, {"s": 73.428, "e": 75.048, "t": "TV won't permanently damage"}, {"s": 75.088, "e": 75.648, "t": "your eyes."}, {"s": 75.828, "e": 76.668, "t": "It can cause eye"}, {"s": 76.768, "e": 77.008, "t": "strain,"}, {"s": 77.068, "e": 77.888, "t": "but that goes away"}, {"s": 77.928, "e": 78.568, "t": "with rest."}, {"s": 78.708, "e": 79.688, "t": "What really matters for"}, {"s": 79.728, "e": 81.208, "t": "kids is time outside."}, {"s": 81.328, "e": 82.148, "t": "In one big school"}, {"s": 82.268, "e": 82.508, "t": "study,"}, {"s": 82.668, "e": 83.808, "t": "adding about forty minutes"}, {"s": 83.848, "e": 84.728, "t": "of outdoor time a"}, {"s": 84.768, "e": 85.768, "t": "day lowered the number"}, {"s": 85.828, "e": 86.688, "t": "of kids who became"}, {"s": 86.748, "e": 87.428, "t": "nearsighted."}, {"s": 103.704, "e": 104.504, "t": "Plot twist!"}, {"s": 104.664, "e": 105.504, "t": "The warning came from"}, {"s": 105.564, "e": 106.524, "t": "a real problem."}, {"s": 106.684, "e": 107.664, "t": "In the nineteen sixties,"}, {"s": 107.804, "e": 108.824, "t": "some TVs gave off"}, {"s": 108.884, "e": 110.004, "t": "extra radiation,"}, {"s": 110.044, "e": 111.064, "t": "and they were recalled."}, {"s": 111.204, "e": 112.524, "t": "Today's screens are safe."}, {"s": 112.644, "e": 113.384, "t": "For tired eyes,"}, {"s": 113.464, "e": 114.684, "t": "try twenty twenty twenty:"}, {"s": 114.884, "e": 115.664, "t": "every twenty minutes,"}, {"s": 115.744, "e": 116.724, "t": "look twenty feet away"}, {"s": 116.744, "e": 117.704, "t": "for twenty seconds."}, {"s": 133.64, "e": 134.2, "t": "Were you told to"}, {"s": 134.24, "e": 134.88, "t": "move back from the"}, {"s": 134.92, "e": 135.34, "t": "TV?"}, {"s": 135.52, "e": 135.94, "t": "Tell me in the"}, {"s": 136.0, "e": 136.4, "t": "comments,"}, {"s": 136.44, "e": 137.34, "t": "and subscribe for more"}, {"s": 137.38, "e": 137.94, "t": "HowCome!"}]