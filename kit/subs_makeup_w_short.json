[{"s": 0.0, "e": 0.803, "t": "What if you slept"}, {"s": 0.803, "e": 1.699, "t": "with your makeup on"}, {"s": 1.699, "e": 2.553, "t": "every night?"}, {"s": 5.945, "e": 6.798, "t": "Foundation,"}, {"s": 6.798, "e": 8.249, "t": "concealer and mascara sit"}, {"s": 8.249, "e": 9.23, "t": "on your skin all"}, {"s": 9.23, "e": 10.211, "t": "day long."}, {"s": 10.211, "e": 11.321, "t": "It feels harmless after"}, {"s": 11.321, "e": 12.515, "t": "a long day."}, {"s": 12.515, "e": 13.667, "t": "Many people skip washing"}, {"s": 13.667, "e": 14.777, "t": "when they're tired."}, {"s": 18.169, "e": 19.577, "t": "But here's the twist."}, {"s": 19.577, "e": 20.601, "t": "Makeup can clog your"}, {"s": 20.601, "e": 21.838, "t": "pores overnight and lead"}, {"s": 21.838, "e": 22.734, "t": "to breakouts,"}, {"s": 22.734, "e": 23.843, "t": "and mascara left on"}, {"s": 23.843, "e": 25.337, "t": "can irritate your eyes."}, {"s": 25.337, "e": 26.617, "t": "Your skin repairs itself"}, {"s": 26.617, "e": 27.641, "t": "while you sleep!"}, {"s": 27.641, "e": 28.622, "t": "Even a quick wipe"}, {"s": 28.622, "e": 29.475, "t": "or a gentle cleanser"}, {"s": 29.475, "e": 30.499, "t": "before bed makes a"}, {"s": 30.499, "e": 31.694, "t": "big difference."}, {"s": 31.694, "e": 32.803, "t": "Makeup on your pillowcase"}, {"s": 32.803, "e": 34.041, "t": "can also spread oil"}, {"s": 34.041, "e": 35.193, "t": "and bacteria back onto"}, {"s": 35.193, "e": 36.259, "t": "your face night after"}, {"s": 36.259, "e": 37.07, "t": "night."}, {"s": 40.462, "e": 41.273, "t": "Do you always wash"}, {"s": 41.273, "e": 42.681, "t": "your face before bed?"}, {"s": 42.681, "e": 43.662, "t": "Comment below,"}, {"s": 43.662, "e": 44.942, "t": "and subscribe for more!"}]