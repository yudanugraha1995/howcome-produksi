[{"s": 0.7, "e": 2.0, "t": "Your toothbrush sits right"}, {"s": 2.04, "e": 3.06, "t": "next to the toilet."}, {"s": 3.28, "e": 4.1, "t": "What if it stayed"}, {"s": 4.14, "e": 4.84, "t": "there every day?"}, {"s": 14.24, "e": 15.84, "t": "Every flush sprays tiny"}, {"s": 15.88, "e": 16.999, "t": "droplets into the air."}, {"s": 17.24, "e": 18.06, "t": "In one study of"}, {"s": 18.1, "e": 18.94, "t": "shared bathrooms,"}, {"s": 19.16, "e": 20.64, "t": "most toothbrushes had poop"}, {"s": 20.68, "e": 21.44, "t": "germs on them."}, {"s": 21.72, "e": 22.16, "t": "Yuck!"}, {"s": 31.66, "e": 32.42, "t": "Plot twist!"}, {"s": 32.62, "e": 33.66, "t": "A closed case can"}, {"s": 33.68, "e": 34.299, "t": "make it worse,"}, {"s": 34.38, "e": 35.48, "t": "because it stays wet."}, {"s": 35.72, "e": 36.5, "t": "Let it air dry,"}, {"s": 36.58, "e": 37.52, "t": "and close the lid."}, {"s": 47.42, "e": 48.52, "t": "Where's your toothbrush?"}, {"s": 48.82, "e": 49.26, "t": "Tell me in the"}, {"s": 49.3, "e": 49.82, "t": "comments!"}]