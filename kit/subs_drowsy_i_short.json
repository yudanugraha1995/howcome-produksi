[{"s": 0.0, "e": 1.04, "t": "What if you drove"}, {"s": 1.16, "e": 2.24, "t": "after staying awake all"}, {"s": 2.32, "e": 2.88, "t": "night?"}, {"s": 3.553, "e": 4.833, "t": "You might feel fine."}, {"s": 5.506, "e": 6.386, "t": "But being awake for"}, {"s": 6.546, "e": 7.906, "t": "twenty-four hours can affect"}, {"s": 7.986, "e": 8.946, "t": "your driving about like"}, {"s": 9.026, "e": 10.146, "t": "a blood alcohol level"}, {"s": 10.226, "e": 11.186, "t": "of zero point one"}, {"s": 11.346, "e": 12.146, "t": "percent,"}, {"s": 12.346, "e": 13.266, "t": "above the legal limit"}, {"s": 13.386, "e": 15.026, "t": "in every US state!"}, {"s": 15.859, "e": 17.139, "t": "Ever driven tired?"}, {"s": 17.219, "e": 17.779, "t": "Comment,"}, {"s": 17.859, "e": 18.899, "t": "and subscribe!"}]