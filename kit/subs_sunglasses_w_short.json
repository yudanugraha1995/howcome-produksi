[{"s": 0.0, "e": 0.803, "t": "What if you never"}, {"s": 0.803, "e": 2.211, "t": "wore sunglasses?"}, {"s": 6.339, "e": 7.406, "t": "Lots of people only"}, {"s": 7.406, "e": 8.558, "t": "wear sunglasses to look"}, {"s": 8.558, "e": 9.454, "t": "cool."}, {"s": 9.454, "e": 10.563, "t": "Squinting works fine,"}, {"s": 10.563, "e": 11.289, "t": "right?"}, {"s": 11.289, "e": 12.739, "t": "Light bouncing off snow,"}, {"s": 12.739, "e": 13.721, "t": "sand and water makes"}, {"s": 13.721, "e": 15.043, "t": "it even stronger."}, {"s": 19.171, "e": 20.494, "t": "But here's the twist."}, {"s": 20.494, "e": 21.859, "t": "UV rays can actually"}, {"s": 21.859, "e": 23.011, "t": "sunburn your eyes,"}, {"s": 23.011, "e": 23.865, "t": "and years of sun"}, {"s": 23.865, "e": 25.273, "t": "are linked to cataracts,"}, {"s": 25.273, "e": 26.467, "t": "so the best sunglasses"}, {"s": 26.467, "e": 27.662, "t": "block one hundred percent"}, {"s": 27.662, "e": 28.771, "t": "of UV!"}, {"s": 28.771, "e": 30.265, "t": "Dark lenses alone don't"}, {"s": 30.265, "e": 31.587, "t": "mean UV protection,"}, {"s": 31.587, "e": 32.995, "t": "so check the label."}, {"s": 32.995, "e": 34.659, "t": "Kids need sunglasses too,"}, {"s": 34.659, "e": 35.427, "t": "because their eyes let"}, {"s": 35.427, "e": 36.963, "t": "in more UV light."}, {"s": 41.091, "e": 42.755, "t": "Do you wear sunglasses?"}, {"s": 42.755, "e": 43.609, "t": "Comment below,"}, {"s": 43.609, "e": 44.931, "t": "and subscribe for more!"}]