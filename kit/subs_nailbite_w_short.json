[{"s": 0.0, "e": 0.675, "t": "What if you bit"}, {"s": 0.675, "e": 2.553, "t": "your nails every day?"}, {"s": 3.841, "e": 5.035, "t": "Nail biting is super"}, {"s": 5.035, "e": 5.718, "t": "common,"}, {"s": 5.718, "e": 6.657, "t": "and it often starts"}, {"s": 6.657, "e": 7.979, "t": "in childhood when people"}, {"s": 7.979, "e": 9.857, "t": "feel bored or stressed."}, {"s": 9.857, "e": 11.009, "t": "Your fingers carry tons"}, {"s": 11.009, "e": 11.99, "t": "of germs,"}, {"s": 11.99, "e": 13.142, "t": "and biting moves them"}, {"s": 13.142, "e": 14.849, "t": "straight into your mouth."}, {"s": 14.849, "e": 16.001, "t": "Germs love hiding under"}, {"s": 16.001, "e": 16.769, "t": "your nails,"}, {"s": 16.769, "e": 18.091, "t": "where washing often misses"}, {"s": 18.091, "e": 18.859, "t": "them."}, {"s": 20.147, "e": 21.683, "t": "But here's the twist."}, {"s": 21.683, "e": 22.75, "t": "Years of nail biting"}, {"s": 22.75, "e": 23.774, "t": "can chip and wear"}, {"s": 23.774, "e": 25.054, "t": "down your front teeth,"}, {"s": 25.054, "e": 26.121, "t": "and even damage the"}, {"s": 26.121, "e": 26.931, "t": "nail bed,"}, {"s": 26.931, "e": 28.083, "t": "so nails grow back"}, {"s": 28.083, "e": 29.278, "t": "bumpy."}, {"s": 29.278, "e": 30.089, "t": "Some people paint on"}, {"s": 30.089, "e": 31.283, "t": "a bitter tasting nail"}, {"s": 31.283, "e": 32.094, "t": "polish to break the"}, {"s": 32.094, "e": 33.033, "t": "habit!"}, {"s": 33.033, "e": 34.398, "t": "Doctors call severe nail"}, {"s": 34.398, "e": 35.934, "t": "biting onychophagia,"}, {"s": 35.934, "e": 36.745, "t": "and a stress ball"}, {"s": 36.745, "e": 37.854, "t": "or fidget toy can"}, {"s": 37.854, "e": 38.707, "t": "help keep your hands"}, {"s": 38.707, "e": 39.689, "t": "busy."}, {"s": 40.977, "e": 41.574, "t": "Are you a nail"}, {"s": 41.574, "e": 42.513, "t": "biter?"}, {"s": 42.513, "e": 43.579, "t": "Comment below,"}, {"s": 43.579, "e": 44.944, "t": "and subscribe for more!"}]