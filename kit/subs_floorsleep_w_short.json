[{"s": 0.0, "e": 0.675, "t": "What if you slept"}, {"s": 0.675, "e": 1.486, "t": "on the floor every"}, {"s": 1.486, "e": 2.254, "t": "night?"}, {"s": 6.67, "e": 7.353, "t": "Some people say it"}, {"s": 7.353, "e": 8.291, "t": "helps their back,"}, {"s": 8.291, "e": 9.102, "t": "others just like a"}, {"s": 9.102, "e": 10.638, "t": "cool floor in summer."}, {"s": 10.638, "e": 11.491, "t": "Sounds uncomfortable,"}, {"s": 11.491, "e": 12.131, "t": "right?"}, {"s": 12.131, "e": 12.942, "t": "You'd have no soft"}, {"s": 12.942, "e": 14.563, "t": "mattress to sink into."}, {"s": 18.979, "e": 20.217, "t": "But here's the twist."}, {"s": 20.217, "e": 21.07, "t": "In Japan,"}, {"s": 21.07, "e": 22.051, "t": "many people sleep on"}, {"s": 22.051, "e": 23.331, "t": "futons on the floor,"}, {"s": 23.331, "e": 24.142, "t": "and some people with"}, {"s": 24.142, "e": 24.953, "t": "back pain say a"}, {"s": 24.953, "e": 26.275, "t": "firm surface helps,"}, {"s": 26.275, "e": 27.214, "t": "though science isn't sure"}, {"s": 27.214, "e": 28.025, "t": "yet!"}, {"s": 28.025, "e": 28.75, "t": "The floor can be"}, {"s": 28.75, "e": 30.073, "t": "cold and dusty though,"}, {"s": 30.073, "e": 30.713, "t": "so a good mat"}, {"s": 30.713, "e": 31.566, "t": "matters."}, {"s": 31.566, "e": 32.846, "t": "People with joint pain,"}, {"s": 32.846, "e": 33.699, "t": "older adults,"}, {"s": 33.699, "e": 34.595, "t": "or anyone who gets"}, {"s": 34.595, "e": 35.747, "t": "cold easily might do"}, {"s": 35.747, "e": 36.942, "t": "better with a bed."}, {"s": 41.358, "e": 42.638, "t": "Bed or floor?"}, {"s": 42.638, "e": 43.577, "t": "Comment below,"}, {"s": 43.577, "e": 44.942, "t": "and subscribe for more!"}]