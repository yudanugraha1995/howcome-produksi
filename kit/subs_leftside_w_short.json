[{"s": 0.0, "e": 0.803, "t": "What if you slept"}, {"s": 0.803, "e": 1.742, "t": "on your left side"}, {"s": 1.742, "e": 2.766, "t": "every night?"}, {"s": 6.67, "e": 7.95, "t": "Most adults already sleep"}, {"s": 7.95, "e": 9.059, "t": "on their side."}, {"s": 9.059, "e": 9.699, "t": "Because of the way"}, {"s": 9.699, "e": 10.937, "t": "your stomach sits,"}, {"s": 10.937, "e": 11.79, "t": "lying on your left"}, {"s": 11.79, "e": 12.771, "t": "can help keep acid"}, {"s": 12.771, "e": 14.265, "t": "from flowing back up."}, {"s": 14.265, "e": 15.331, "t": "That's why some studies"}, {"s": 15.331, "e": 16.739, "t": "found fewer heartburn symptoms"}, {"s": 16.739, "e": 18.062, "t": "on the left side."}, {"s": 21.966, "e": 23.417, "t": "But here's the twist."}, {"s": 23.417, "e": 24.739, "t": "Doctors often recommend the"}, {"s": 24.739, "e": 26.446, "t": "left side during pregnancy,"}, {"s": 26.446, "e": 27.385, "t": "because it can improve"}, {"s": 27.385, "e": 28.067, "t": "blood flow to the"}, {"s": 28.067, "e": 29.091, "t": "baby."}, {"s": 29.091, "e": 30.286, "t": "Side sleeping can also"}, {"s": 30.286, "e": 31.566, "t": "reduce snoring compared with"}, {"s": 31.566, "e": 32.931, "t": "sleeping on your back."}, {"s": 32.931, "e": 33.998, "t": "But the best position"}, {"s": 33.998, "e": 34.723, "t": "is still the one"}, {"s": 34.723, "e": 35.534, "t": "that lets you sleep"}, {"s": 35.534, "e": 37.027, "t": "well without pain."}, {"s": 40.931, "e": 41.657, "t": "Which side do you"}, {"s": 41.657, "e": 42.553, "t": "sleep on?"}, {"s": 42.553, "e": 43.534, "t": "Comment below,"}, {"s": 43.534, "e": 44.942, "t": "and subscribe for more!"}]