[{"s": 0.46, "e": 1.08, "t": "Move back!"}, {"s": 1.14, "e": 1.88, "t": "You're sitting way too"}, {"s": 1.9, "e": 2.82, "t": "close to the TV!"}, {"s": 3.06, "e": 3.76, "t": "Sound familiar?"}, {"s": 4.019, "e": 4.96, "t": "What if you really"}, {"s": 5.02, "e": 5.96, "t": "sat super close to"}, {"s": 6.0, "e": 7.18, "t": "the screen every single"}, {"s": 7.28, "e": 7.56, "t": "day?"}, {"s": 7.74, "e": 8.46, "t": "Would it ruin your"}, {"s": 8.56, "e": 8.88, "t": "eyes?"}, {"s": 9.16, "e": 10.399, "t": "Here's what really happens."}, {"s": 10.64, "e": 11.42, "t": "Staring at a screen"}, {"s": 11.46, "e": 12.36, "t": "up close makes you"}, {"s": 12.38, "e": 13.0, "t": "blink less,"}, {"s": 13.18, "e": 13.82, "t": "so your eyes can"}, {"s": 13.86, "e": 14.5, "t": "feel dry,"}, {"s": 14.64, "e": 15.0, "t": "tired,"}, {"s": 15.04, "e": 15.58, "t": "and itchy."}, {"s": 15.74, "e": 16.86, "t": "Kids also focus up"}, {"s": 16.9, "e": 17.96, "t": "close more easily than"}, {"s": 18.0, "e": 18.68, "t": "adults do."}, {"s": 18.86, "e": 19.78, "t": "But eye doctors say"}, {"s": 19.82, "e": 20.56, "t": "sitting close to the"}, {"s": 20.6, "e": 22.22, "t": "TV won't permanently damage"}, {"s": 22.26, "e": 22.82, "t": "your eyes."}, {"s": 23.0, "e": 23.84, "t": "It can cause eye"}, {"s": 23.94, "e": 24.18, "t": "strain,"}, {"s": 24.24, "e": 25.06, "t": "but that goes away"}, {"s": 25.1, "e": 25.74, "t": "with rest."}, {"s": 25.88, "e": 26.86, "t": "What really matters for"}, {"s": 26.9, "e": 28.38, "t": "kids is time outside."}, {"s": 28.5, "e": 29.32, "t": "In one big school"}, {"s": 29.44, "e": 29.68, "t": "study,"}, {"s": 29.84, "e": 30.98, "t": "adding about forty minutes"}, {"s": 31.02, "e": 31.9, "t": "of outdoor time a"}, {"s": 31.94, "e": 32.94, "t": "day lowered the number"}, {"s": 33.0, "e": 33.86, "t": "of kids who became"}, {"s": 33.92, "e": 34.6, "t": "nearsighted."}, {"s": 35.896, "e": 36.696, "t": "Plot twist!"}, {"s": 36.856, "e": 37.696, "t": "The warning came from"}, {"s": 37.756, "e": 38.716, "t": "a real problem."}, {"s": 38.876, "e": 39.856, "t": "In the nineteen sixties,"}, {"s": 39.996, "e": 41.016, "t": "some TVs gave off"}, {"s": 41.076, "e": 42.196, "t": "extra radiation,"}, {"s": 42.236, "e": 43.256, "t": "and they were recalled."}, {"s": 43.396, "e": 44.716, "t": "Today's screens are safe."}, {"s": 44.836, "e": 45.576, "t": "For tired eyes,"}, {"s": 45.656, "e": 46.876, "t": "try twenty twenty twenty:"}, {"s": 47.076, "e": 47.856, "t": "every twenty minutes,"}, {"s": 47.936, "e": 48.916, "t": "look twenty feet away"}, {"s": 48.936, "e": 49.896, "t": "for twenty seconds."}, {"s": 50.216, "e": 50.776, "t": "Were you told to"}, {"s": 50.816, "e": 51.456, "t": "move back from the"}, {"s": 51.496, "e": 51.916, "t": "TV?"}, {"s": 52.096, "e": 52.516, "t": "Tell me in the"}, {"s": 52.576, "e": 52.976, "t": "comments,"}, {"s": 53.016, "e": 53.916, "t": "and subscribe for more"}, {"s": 53.956, "e": 54.516, "t": "HowCome!"}]