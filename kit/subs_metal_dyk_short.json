[{"s": 0.0, "e": 1.12, "t": "Why does metal feel"}, {"s": 1.28, "e": 2.56, "t": "colder than wood?"}, {"s": 3.407, "e": 4.207, "t": "Most people think the"}, {"s": 4.287, "e": 6.087, "t": "metal really is colder."}, {"s": 6.894, "e": 8.014, "t": "But here's the surprising"}, {"s": 8.094, "e": 8.734, "t": "part:"}, {"s": 8.774, "e": 9.934, "t": "in the same room,"}, {"s": 9.974, "e": 11.374, "t": "they're the same temperature!"}, {"s": 11.774, "e": 12.814, "t": "Metal just pulls heat"}, {"s": 12.894, "e": 13.854, "t": "from your hand much"}, {"s": 13.934, "e": 14.574, "t": "faster,"}, {"s": 14.654, "e": 15.614, "t": "so your skin feels"}, {"s": 15.694, "e": 16.374, "t": "the chill."}, {"s": 17.181, "e": 17.861, "t": "Fooled you?"}, {"s": 18.061, "e": 18.461, "t": "Comment,"}, {"s": 18.501, "e": 19.581, "t": "and subscribe!"}]