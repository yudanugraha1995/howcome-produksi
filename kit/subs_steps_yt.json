[{"s": 0.18, "e": 1.56, "t": "Ten thousand steps."}, {"s": 2.42, "e": 2.82, "t": "Every."}, {"s": 3.54, "e": 4.019, "t": "Single."}, {"s": 4.66, "e": 4.96, "t": "Day."}, {"s": 5.78, "e": 6.62, "t": "Your watch says it's"}, {"s": 6.66, "e": 7.46, "t": "the magic number,"}, {"s": 7.6, "e": 8.5, "t": "and it buzzes when"}, {"s": 8.52, "e": 8.94, "t": "you hit it."}, {"s": 9.24, "e": 9.84, "t": "But what would it"}, {"s": 10.08, "e": 10.92, "t": "really do to your"}, {"s": 10.96, "e": 11.3, "t": "body?"}, {"s": 26.24, "e": 27.14, "t": "Many of us walk"}, {"s": 27.18, "e": 27.8, "t": "far less,"}, {"s": 28.1, "e": 28.98, "t": "often just a few"}, {"s": 29.06, "e": 30.18, "t": "thousand steps a day."}, {"s": 30.52, "e": 30.88, "t": "Couch,"}, {"s": 31.08, "e": 31.44, "t": "car,"}, {"s": 31.62, "e": 32.0, "t": "desk,"}, {"s": 32.2, "e": 32.84, "t": "couch again."}, {"s": 47.72, "e": 48.58, "t": "Walking gets your heart"}, {"s": 48.68, "e": 49.66, "t": "pumping and helps your"}, {"s": 49.7, "e": 50.98, "t": "muscles pull sugar out"}, {"s": 51.02, "e": 51.62, "t": "of your blood."}, {"s": 51.96, "e": 52.92, "t": "Even a short walk"}, {"s": 53.0, "e": 53.84, "t": "after a meal can"}, {"s": 53.9, "e": 54.98, "t": "lower the sugar spike."}, {"s": 69.96, "e": 70.9, "t": "And the big one."}, {"s": 71.26, "e": 72.18, "t": "A huge study of"}, {"s": 72.26, "e": 73.84, "t": "about fifty thousand adults"}, {"s": 73.88, "e": 74.94, "t": "found that more steps"}, {"s": 75.04, "e": 76.12, "t": "meant a lower risk"}, {"s": 76.16, "e": 76.98, "t": "of dying early."}, {"s": 77.28, "e": 78.28, "t": "But the benefit leveled"}, {"s": 78.38, "e": 78.62, "t": "off,"}, {"s": 78.88, "e": 79.78, "t": "around six to eight"}, {"s": 79.82, "e": 80.96, "t": "thousand steps for people"}, {"s": 81.02, "e": 81.68, "t": "over sixty,"}, {"s": 81.96, "e": 82.66, "t": "and eight to ten"}, {"s": 82.72, "e": 84.2, "t": "thousand for younger adults."}, {"s": 84.68, "e": 85.9, "t": "So more is better,"}, {"s": 86.2, "e": 86.86, "t": "but only up to"}, {"s": 86.9, "e": 87.38, "t": "a point."}, {"s": 102.74, "e": 103.44, "t": "Plot twist!"}, {"s": 103.8, "e": 104.96, "t": "Ten thousand didn't come"}, {"s": 105.0, "e": 105.68, "t": "from science."}, {"s": 106.02, "e": 106.6, "t": "It came from a"}, {"s": 106.64, "e": 108.1, "t": "Japanese pedometer sold in"}, {"s": 108.14, "e": 109.28, "t": "the nineteen sixties,"}, {"s": 109.52, "e": 110.56, "t": "whose name meant ten"}, {"s": 110.66, "e": 111.84, "t": "thousand steps meter."}, {"s": 112.26, "e": 113.04, "t": "Great marketing,"}, {"s": 113.16, "e": 114.48, "t": "but every extra step"}, {"s": 114.52, "e": 114.94, "t": "helps!"}, {"s": 115.42, "e": 116.24, "t": "Even going from two"}, {"s": 116.32, "e": 117.54, "t": "thousand to four thousand"}, {"s": 117.62, "e": 118.7, "t": "makes a real difference."}, {"s": 133.56, "e": 134.32, "t": "How many steps did"}, {"s": 134.34, "e": 135.0, "t": "you walk today?"}, {"s": 135.28, "e": 135.72, "t": "Tell me in the"}, {"s": 135.76, "e": 136.18, "t": "comments,"}, {"s": 136.22, "e": 137.319, "t": "and subscribe for more"}, {"s": 137.36, "e": 137.94, "t": "HowCome!"}]