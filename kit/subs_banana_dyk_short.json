[{"s": 0.0, "e": 1.2, "t": "Why do bananas turn"}, {"s": 1.28, "e": 1.76, "t": "brown?"}, {"s": 2.753, "e": 3.953, "t": "Ripe bananas release a"}, {"s": 4.033, "e": 5.473, "t": "gas called ethylene that"}, {"s": 5.553, "e": 6.913, "t": "speeds up ripening."}, {"s": 7.746, "e": 8.706, "t": "But here's the surprising"}, {"s": 8.786, "e": 9.506, "t": "part:"}, {"s": 9.546, "e": 10.386, "t": "in the fridge,"}, {"s": 10.466, "e": 11.906, "t": "the peel turns black,"}, {"s": 11.986, "e": 12.946, "t": "but the fruit inside"}, {"s": 13.026, "e": 14.626, "t": "stays fresh longer!"}, {"s": 15.459, "e": 17.379, "t": "Green or spotty bananas?"}, {"s": 17.539, "e": 17.939, "t": "Comment,"}, {"s": 18.019, "e": 19.059, "t": "and subscribe!"}]