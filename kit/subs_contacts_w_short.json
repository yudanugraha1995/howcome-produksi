[{"s": 0.0, "e": 0.803, "t": "What if you slept"}, {"s": 0.803, "e": 2.254, "t": "in your contact lenses"}, {"s": 2.254, "e": 3.278, "t": "every night?"}, {"s": 5.022, "e": 6.003, "t": "Millions of people wear"}, {"s": 6.003, "e": 7.283, "t": "contact lenses every day"}, {"s": 7.283, "e": 8.691, "t": "instead of glasses."}, {"s": 8.691, "e": 9.673, "t": "Your eyes would feel"}, {"s": 9.673, "e": 10.782, "t": "dry in the morning."}, {"s": 10.782, "e": 12.233, "t": "Your cornea gets oxygen"}, {"s": 12.233, "e": 13.257, "t": "straight from the air,"}, {"s": 13.257, "e": 13.939, "t": "and a lens on"}, {"s": 13.939, "e": 14.75, "t": "top blocks some of"}, {"s": 14.75, "e": 15.518, "t": "it."}, {"s": 17.262, "e": 18.67, "t": "But here's the twist."}, {"s": 18.67, "e": 20.035, "t": "Sleeping in contacts makes"}, {"s": 20.035, "e": 21.401, "t": "eye infections about six"}, {"s": 21.401, "e": 22.382, "t": "to eight times more"}, {"s": 22.382, "e": 23.193, "t": "likely,"}, {"s": 23.193, "e": 24.003, "t": "because your eyes get"}, {"s": 24.003, "e": 25.155, "t": "less oxygen,"}, {"s": 25.155, "e": 26.307, "t": "and some infections can"}, {"s": 26.307, "e": 27.715, "t": "damage your vision!"}, {"s": 27.715, "e": 28.995, "t": "Even lenses approved for"}, {"s": 28.995, "e": 29.977, "t": "overnight wear raise the"}, {"s": 29.977, "e": 30.617, "t": "risk,"}, {"s": 30.617, "e": 31.641, "t": "so eye doctors say"}, {"s": 31.641, "e": 32.537, "t": "take them out before"}, {"s": 32.537, "e": 33.347, "t": "bed."}, {"s": 33.347, "e": 34.585, "t": "One rare infection comes"}, {"s": 34.585, "e": 35.779, "t": "from a tiny amoeba"}, {"s": 35.779, "e": 36.803, "t": "found in water,"}, {"s": 36.803, "e": 37.699, "t": "so never rinse your"}, {"s": 37.699, "e": 39.15, "t": "lenses with tap water."}, {"s": 40.894, "e": 42.729, "t": "Glasses or contacts?"}, {"s": 42.729, "e": 43.582, "t": "Comment below,"}, {"s": 43.582, "e": 44.947, "t": "and subscribe for more!"}]