[{"s": 0.1, "e": 0.74, "t": "One cup in the"}, {"s": 0.8, "e": 1.26, "t": "morning,"}, {"s": 1.6, "e": 2.5, "t": "one after lunch,"}, {"s": 2.8, "e": 3.58, "t": "maybe one more at"}, {"s": 3.72, "e": 4.04, "t": "four."}, {"s": 4.9, "e": 5.54, "t": "What if you drank"}, {"s": 5.58, "e": 7.1, "t": "coffee every single day?"}, {"s": 7.5, "e": 8.54, "t": "Is it slowly hurting"}, {"s": 8.6, "e": 8.72, "t": "you,"}, {"s": 9.04, "e": 10.4, "t": "or quietly helping you?"}, {"s": 10.82, "e": 12.08, "t": "Caffeine blocks a sleepy"}, {"s": 12.18, "e": 13.12, "t": "signal in your brain"}, {"s": 13.22, "e": 14.22, "t": "called adenosine."}, {"s": 14.4, "e": 15.3, "t": "But it stays around"}, {"s": 15.34, "e": 16.02, "t": "for hours."}, {"s": 16.28, "e": 16.94, "t": "Half of it can"}, {"s": 17.0, "e": 17.56, "t": "still be in your"}, {"s": 17.6, "e": 19.02, "t": "body five hours later."}, {"s": 19.42, "e": 20.32, "t": "Now the big news."}, {"s": 20.6, "e": 21.5, "t": "A huge review of"}, {"s": 21.54, "e": 22.38, "t": "more than two hundred"}, {"s": 22.54, "e": 23.56, "t": "studies found that people"}, {"s": 23.58, "e": 24.52, "t": "who drank about three"}, {"s": 24.56, "e": 25.26, "t": "to four cups a"}, {"s": 25.28, "e": 26.42, "t": "day had a lower"}, {"s": 26.52, "e": 27.58, "t": "risk of dying early"}, {"s": 27.92, "e": 28.86, "t": "and of heart disease,"}, {"s": 28.96, "e": 29.78, "t": "compared to people who"}, {"s": 29.82, "e": 30.48, "t": "drank none."}, {"s": 30.74, "e": 31.32, "t": "That's a link,"}, {"s": 31.46, "e": 32.04, "t": "not proof,"}, {"s": 32.14, "e": 32.82, "t": "but it's a strong"}, {"s": 32.92, "e": 33.26, "t": "clue."}, {"s": 33.6, "e": 34.24, "t": "Just don't load it"}, {"s": 34.28, "e": 35.06, "t": "with tons of sugar"}, {"s": 35.1, "e": 35.68, "t": "and cream."}, {"s": 37.18, "e": 37.92, "t": "Plot twist!"}, {"s": 38.18, "e": 39.3, "t": "Coffee doesn't really dry"}, {"s": 39.34, "e": 39.78, "t": "you out."}, {"s": 40.06, "e": 40.72, "t": "In one study,"}, {"s": 40.84, "e": 42.0, "t": "men drank either coffee"}, {"s": 42.04, "e": 43.1, "t": "or water for days,"}, {"s": 43.2, "e": 44.12, "t": "and their hydration was"}, {"s": 44.16, "e": 44.94, "t": "about the same."}, {"s": 45.22, "e": 45.98, "t": "So your morning cup"}, {"s": 46.06, "e": 46.74, "t": "still counts as a"}, {"s": 46.76, "e": 47.1, "t": "drink."}, {"s": 47.36, "e": 48.14, "t": "Just stop by mid"}, {"s": 48.22, "e": 49.04, "t": "afternoon if you want"}, {"s": 49.06, "e": 50.02, "t": "to sleep well tonight."}, {"s": 50.44, "e": 51.08, "t": "How many cups do"}, {"s": 51.1, "e": 51.78, "t": "you drink a day?"}, {"s": 52.06, "e": 52.46, "t": "Tell me in the"}, {"s": 52.5, "e": 52.94, "t": "comments,"}, {"s": 53.02, "e": 53.98, "t": "and subscribe for more"}, {"s": 54.02, "e": 54.6, "t": "HowCome!"}]