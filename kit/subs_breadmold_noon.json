[{"s": 0.6, "e": 1.44, "t": "A green spot on"}, {"s": 1.46, "e": 2.0, "t": "your bread!"}, {"s": 2.38, "e": 3.1, "t": "What if you just"}, {"s": 3.16, "e": 3.92, "t": "cut it off and"}, {"s": 3.98, "e": 4.78, "t": "ate the rest?"}, {"s": 14.413, "e": 15.233, "t": "Bad idea."}, {"s": 15.493, "e": 16.533, "t": "Mold has thin roots"}, {"s": 16.573, "e": 17.693, "t": "that spread deep into"}, {"s": 17.733, "e": 18.353, "t": "soft bread,"}, {"s": 18.533, "e": 19.413, "t": "far past the spot"}, {"s": 19.453, "e": 19.833, "t": "you see."}, {"s": 20.033, "e": 21.393, "t": "Experts say moldy soft"}, {"s": 21.513, "e": 22.193, "t": "foods go in the"}, {"s": 22.233, "e": 22.713, "t": "trash."}, {"s": 32.226, "e": 32.946, "t": "Plot twist!"}, {"s": 33.166, "e": 34.166, "t": "Some mold is great."}, {"s": 34.386, "e": 35.346, "t": "Blue cheese gets its"}, {"s": 35.386, "e": 36.166, "t": "flavor from mold,"}, {"s": 36.266, "e": 37.306, "t": "and penicillin came from"}, {"s": 37.346, "e": 37.926, "t": "mold too!"}, {"s": 47.499, "e": 48.159, "t": "Cut it off or"}, {"s": 48.219, "e": 48.699, "t": "toss it?"}, {"s": 48.859, "e": 49.279, "t": "Tell me in the"}, {"s": 49.339, "e": 49.879, "t": "comments!"}]