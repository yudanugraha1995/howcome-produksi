[{"s": 0.0, "e": 1.92, "t": "Why does popcorn explode?"}, {"s": 2.753, "e": 3.873, "t": "Each kernel hides a"}, {"s": 3.993, "e": 4.913, "t": "drop of water that"}, {"s": 5.033, "e": 6.273, "t": "turns into steam."}, {"s": 7.106, "e": 8.146, "t": "But here's the surprising"}, {"s": 8.226, "e": 8.866, "t": "part:"}, {"s": 8.946, "e": 9.986, "t": "it bursts at about"}, {"s": 10.066, "e": 11.346, "t": "one hundred eighty degrees"}, {"s": 11.426, "e": 12.226, "t": "Celsius,"}, {"s": 12.266, "e": 13.186, "t": "and the starch puffs"}, {"s": 13.306, "e": 14.466, "t": "into foam that sets"}, {"s": 14.546, "e": 15.186, "t": "instantly!"}, {"s": 16.259, "e": 17.459, "t": "Sweet or salty?"}, {"s": 17.779, "e": 18.259, "t": "Comment,"}, {"s": 18.339, "e": 19.379, "t": "and subscribe!"}]