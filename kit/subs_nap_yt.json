[{"s": 0.7, "e": 1.28, "t": "It's two in the"}, {"s": 1.36, "e": 1.9, "t": "afternoon,"}, {"s": 1.96, "e": 2.62, "t": "and your eyes are"}, {"s": 2.66, "e": 3.1, "t": "closing."}, {"s": 3.7, "e": 4.26, "t": "What if you took"}, {"s": 4.3, "e": 5.52, "t": "a nap every single"}, {"s": 5.62, "e": 6.14, "t": "afternoon?"}, {"s": 6.44, "e": 6.82, "t": "Lazy,"}, {"s": 7.2, "e": 7.92, "t": "or genius?"}, {"s": 8.52, "e": 9.2, "t": "Let's find out what"}, {"s": 9.26, "e": 9.92, "t": "science says."}, {"s": 26.212, "e": 27.552, "t": "That afternoon dip is"}, {"s": 27.712, "e": 28.012, "t": "real."}, {"s": 28.192, "e": 29.512, "t": "Your body clock naturally"}, {"s": 29.552, "e": 30.592, "t": "lowers your alertness in"}, {"s": 30.612, "e": 31.572, "t": "the early afternoon."}, {"s": 47.604, "e": 48.664, "t": "But nap too long"}, {"s": 48.684, "e": 49.624, "t": "and you slide into"}, {"s": 49.644, "e": 50.284, "t": "deep sleep."}, {"s": 50.444, "e": 51.184, "t": "Wake up from that,"}, {"s": 51.204, "e": 52.224, "t": "and you feel worse,"}, {"s": 52.384, "e": 53.424, "t": "groggy and slow,"}, {"s": 53.564, "e": 54.204, "t": "for a while."}, {"s": 70.376, "e": 71.196, "t": "Short naps are the"}, {"s": 71.276, "e": 71.736, "t": "secret."}, {"s": 71.936, "e": 72.936, "t": "NASA tested it on"}, {"s": 72.996, "e": 73.856, "t": "airline pilots."}, {"s": 74.056, "e": 74.836, "t": "A nap of about"}, {"s": 74.876, "e": 76.156, "t": "twenty six minutes boosted"}, {"s": 76.176, "e": 77.256, "t": "their performance by thirty"}, {"s": 77.356, "e": 78.036, "t": "four percent,"}, {"s": 78.176, "e": 79.216, "t": "and their alertness by"}, {"s": 79.256, "e": 80.275, "t": "fifty four percent."}, {"s": 80.516, "e": 80.916, "t": "Huge,"}, {"s": 80.996, "e": 82.036, "t": "for a tiny nap!"}, {"s": 82.256, "e": 82.916, "t": "The trick is to"}, {"s": 82.996, "e": 84.236, "t": "stop before deep sleep,"}, {"s": 84.336, "e": 85.176, "t": "so set an alarm"}, {"s": 85.196, "e": 86.296, "t": "for about twen