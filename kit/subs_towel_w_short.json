[{"s": 0.0, "e": 0.761, "t": "What if you used"}, {"s": 0.761, "e": 1.827, "t": "the same bath towel"}, {"s": 1.827, "e": 2.979, "t": "for a whole month?"}, {"s": 6.139, "e": 7.291, "t": "A bath towel only"}, {"s": 7.291, "e": 8.657, "t": "touches your clean body,"}, {"s": 8.657, "e": 9.339, "t": "so it seems like"}, {"s": 9.339, "e": 10.662, "t": "it can't get dirty."}, {"s": 10.662, "e": 11.643, "t": "Every time you dry"}, {"s": 11.643, "e": 12.241, "t": "off,"}, {"s": 12.241, "e": 13.606, "t": "dead skin and moisture"}, {"s": 13.606, "e": 14.63, "t": "stay on it."}, {"s": 14.63, "e": 15.739, "t": "Bathrooms are warm and"}, {"s": 15.739, "e": 16.379, "t": "humid,"}, {"s": 16.379, "e": 17.531, "t": "so towels often stay"}, {"s": 17.531, "e": 18.939, "t": "damp for hours."}, {"s": 22.099, "e": 23.379, "t": "But here's the twist."}, {"s": 23.379, "e": 24.318, "t": "A damp towel is"}, {"s": 24.318, "e": 25.299, "t": "a perfect home for"}, {"s": 25.299, "e": 26.707, "t": "bacteria and mold,"}, {"s": 26.707, "e": 27.859, "t": "so experts say wash"}, {"s": 27.859, "e": 29.054, "t": "it about every three"}, {"s": 29.054, "e": 29.865, "t": "uses."}, {"s": 29.865, "e": 30.675, "t": "Hang it spread out"}, {"s": 30.675, "e": 31.87, "t": "so it dries fast,"}, {"s": 31.87, "e": 32.809, "t": "and use hot water"}, {"s": 32.809, "e": 33.79, "t": "when you wash it."}, {"s": 33.79, "e": 34.643, "t": "Wet towels left in"}, {"s": 34.643, "e": 35.71, "t": "a pile can even"}, {"s": 35.71, "e": 36.691, "t": "start to smell musty"}, {"s": 36.691, "e": 37.715, "t": "within a day."}, {"s": 40.875, "e": 41.643, "t": "How often do you"}, {"s": 41.643, "e": 42.795, "t": "wash yours?"}, {"s": 42.795, "e": 43.649, "t": "Comment below,"}, {"s": 43.649, "e": 44.928, "t": "and subscribe for more!"}]