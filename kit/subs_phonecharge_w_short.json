[{"s": 0.0, "e": 0.846, "t": "What if you charged"}, {"s": 0.846, "e": 2.297, "t": "your phone overnight every"}, {"s": 2.297, "e": 3.449, "t": "single night?"}, {"s": 6.161, "e": 7.185, "t": "Most people plug in"}, {"s": 7.185, "e": 8.55, "t": "right before bed."}, {"s": 8.55, "e": 9.958, "t": "Modern phones stop charging"}, {"s": 9.958, "e": 10.939, "t": "once they're full,"}, {"s": 10.939, "e": 12.347, "t": "so it won't explode."}, {"s": 12.347, "e": 13.457, "t": "That's why many phones"}, {"s": 13.457, "e": 14.609, "t": "now have an optimized"}, {"s": 14.609, "e": 15.974, "t": "charging setting that waits"}, {"s": 15.974, "e": 17.126, "t": "to finish until you"}, {"s": 17.126, "e": 18.065, "t": "wake up."}, {"s": 20.777, "e": 22.185, "t": "But here's the twist."}, {"s": 22.185, "e": 23.209, "t": "Sitting at one hundred"}, {"s": 23.209, "e": 24.489, "t": "percent for hours,"}, {"s": 24.489, "e": 26.153, "t": "especially when it's warm,"}, {"s": 26.153, "e": 27.049, "t": "slowly wears out the"}, {"s": 27.049, "e": 28.713, "t": "battery faster."}, {"s": 28.713, "e": 30.121, "t": "Battery experts say keeping"}, {"s": 30.121, "e": 31.187, "t": "it between about twenty"}, {"s": 31.187, "e": 32.553, "t": "and eighty percent helps"}, {"s": 32.553, "e": 33.833, "t": "it last longer."}, {"s": 33.833, "e": 34.643, "t": "And never charge it"}, {"s": 34.643, "e": 35.71, "t": "under your pillow,"}, {"s": 35.71, "e": 36.649, "t": "because trapped heat is"}, {"s": 36.649, "e": 38.057, "t": "the real danger."}, {"s": 40.769, "e": 41.409, "t": "Do you charge at"}, {"s": 41.409, "e": 42.177, "t": "night or during the"}, {"s": 42.177, "e": 42.902, "t": "day?"}, {"s": 42.902, "e": 43.713, "t": "Comment below,"}, {"s": 43.713, "e": 44.95, "t": "and subscribe for more!"}]