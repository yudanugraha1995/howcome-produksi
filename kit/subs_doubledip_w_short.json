[{"s": 0.0, "e": 0.846, "t": "What if you double"}, {"s": 0.846, "e": 1.827, "t": "dipped your chip every"}, {"s": 1.827, "e": 2.851, "t": "single time?"}, {"s": 6.187, "e": 6.785, "t": "It's one of the"}, {"s": 6.785, "e": 8.107, "t": "most argued about snack"}, {"s": 8.107, "e": 9.345, "t": "habits ever."}, {"s": 9.345, "e": 10.497, "t": "It feels harmless,"}, {"s": 10.497, "e": 12.033, "t": "just one more dip."}, {"s": 12.033, "e": 12.971, "t": "Some people even flip"}, {"s": 12.971, "e": 13.825, "t": "the chip around to"}, {"s": 13.825, "e": 15.062, "t": "dip the other side."}, {"s": 18.398, "e": 19.763, "t": "But here's the twist."}, {"s": 19.763, "e": 21.299, "t": "A Clemson University study"}, {"s": 21.299, "e": 22.366, "t": "found that double dipping"}, {"s": 22.366, "e": 23.347, "t": "can move thousands of"}, {"s": 23.347, "e": 24.542, "t": "bacteria from your mouth"}, {"s": 24.542, "e": 25.566, "t": "into the dip,"}, {"s": 25.566, "e": 27.017, "t": "especially into thin dips"}, {"s": 27.017, "e": 28.254, "t": "like salsa."}, {"s": 28.254, "e": 29.278, "t": "Thick dips like cheese"}, {"s": 29.278, "e": 30.217, "t": "dip picked up fewer"}, {"s": 30.217, "e": 31.07, "t": "bacteria,"}, {"s": 31.07, "e": 31.71, "t": "because less of it"}, {"s": 31.71, "e": 32.478, "t": "drips back into the"}, {"s": 32.478, "e": 33.417, "t": "bowl."}, {"s": 33.417, "e": 34.483, "t": "Most mouth germs are"}, {"s": 34.483, "e": 35.209, "t": "harmless,"}, {"s": 35.209, "e": 35.934, "t": "but if someone is"}, {"s": 35.934, "e": 36.403, "t": "sick,"}, {"s": 36.403, "e": 37.897, "t": "it can spread illness."}, {"s": 41.233, "e": 41.873, "t": "Are you a double"}, {"s": 41.873, "e": 42.641, "t": "dipper?"}, {"s": 42.641, "e": 43.665, "t": "Comment below,"}, {"s": 43.665, "e": 44.944, "t": "and subscribe for more!"}]