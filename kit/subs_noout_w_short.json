[{"s": 0.0, "e": 0.803, "t": "What if you never"}, {"s": 0.803, "e": 2.126, "t": "went outside?"}, {"s": 5.23, "e": 6.211, "t": "Between work,"}, {"s": 6.211, "e": 7.534, "t": "school and screens,"}, {"s": 7.534, "e": 8.473, "t": "lots of people spend"}, {"s": 8.473, "e": 10.051, "t": "whole days indoors."}, {"s": 10.051, "e": 10.563, "t": "You'd miss a lot"}, {"s": 10.563, "e": 11.843, "t": "of sunshine."}, {"s": 11.843, "e": 12.91, "t": "Many people now spend"}, {"s": 12.91, "e": 13.891, "t": "about ninety percent of"}, {"s": 13.891, "e": 15.513, "t": "their time indoors."}, {"s": 18.617, "e": 20.025, "t": "But here's the twist."}, {"s": 20.025, "e": 21.177, "t": "Your skin makes vitamin"}, {"s": 21.177, "e": 22.371, "t": "D from sunlight,"}, {"s": 22.371, "e": 23.353, "t": "and studies show kids"}, {"s": 23.353, "e": 24.206, "t": "who spend more time"}, {"s": 24.206, "e": 25.486, "t": "outdoors are less likely"}, {"s": 25.486, "e": 27.15, "t": "to become nearsighted!"}, {"s": 27.15, "e": 28.345, "t": "Even fifteen to thirty"}, {"s": 28.345, "e": 29.326, "t": "minutes of daylight can"}, {"s": 29.326, "e": 30.435, "t": "boost your mood and"}, {"s": 30.435, "e": 31.246, "t": "help you sleep better"}, {"s": 31.246, "e": 32.313, "t": "at night."}, {"s": 32.313, "e": 33.337, "t": "Time in green spaces"}, {"s": 33.337, "e": 34.489, "t": "and parks is also"}, {"s": 34.489, "e": 35.769, "t": "linked to lower stress"}, {"s": 35.769, "e": 37.219, "t": "and a better mood."}, {"s": 40.323, "e": 40.921, "t": "How much time do"}, {"s": 40.921, "e": 42.713, "t": "you spend outside?"}, {"s": 42.713, "e": 43.737, "t": "Comment below,"}, {"s": 43.737, "e": 44.931, "t": "and subscribe for more!"}]