[{"s": 0.0, "e": 1.36, "t": "Why does soda fizz"}, {"s": 1.44, "e": 2.32, "t": "when you open it?"}, {"s": 3.073, "e": 4.113, "t": "It's packed with carbon"}, {"s": 4.193, "e": 5.753, "t": "dioxide under pressure."}, {"s": 5.953, "e": 6.593, "t": "Open it,"}, {"s": 6.633, "e": 7.873, "t": "and the gas escapes."}, {"s": 8.626, "e": 9.746, "t": "But here's the surprising"}, {"s": 9.826, "e": 10.466, "t": "part:"}, {"s": 10.506, "e": 11.746, "t": "bubbles don't just appear"}, {"s": 11.906, "e": 12.706, "t": "anywhere."}, {"s": 12.786, "e": 13.746, "t": "They grow on tiny"}, {"s": 13.826, "e": 14.946, "t": "scratches and specks of"}, {"s": 15.106, "e": 15.706, "t": "dust!"}, {"s": 16.499, "e": 17.619, "t": "Can or bottle?"}, {"s": 17.939, "e": 18.419, "t": "Comment,"}, {"s": 18.499, "e": 19.539, "t": "and subscribe!"}]