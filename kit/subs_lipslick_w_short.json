[{"s": 0.0, "e": 0.675, "t": "What if you licked"}, {"s": 0.675, "e": 2.211, "t": "your lips all day?"}, {"s": 5.491, "e": 6.003, "t": "Cold,"}, {"s": 6.003, "e": 7.369, "t": "dry winter air makes"}, {"s": 7.369, "e": 8.563, "t": "chapped lips even more"}, {"s": 8.563, "e": 9.374, "t": "common."}, {"s": 9.374, "e": 10.099, "t": "It feels like it"}, {"s": 10.099, "e": 11.465, "t": "helps when they're dry."}, {"s": 11.465, "e": 12.446, "t": "Lips have no oil"}, {"s": 12.446, "e": 13.001, "t": "glands,"}, {"s": 13.001, "e": 13.854, "t": "so they dry out"}, {"s": 13.854, "e": 14.579, "t": "faster than the rest"}, {"s": 14.579, "e": 15.731, "t": "of your skin."}, {"s": 19.011, "e": 20.462, "t": "But here's the twist."}, {"s": 20.462, "e": 22.254, "t": "Saliva evaporates fast and"}, {"s": 22.254, "e": 23.662, "t": "takes moisture with it,"}, {"s": 23.662, "e": 24.43, "t": "so your lips end"}, {"s": 24.43, "e": 25.667, "t": "up even drier and"}, {"s": 25.667, "e": 26.99, "t": "can crack."}, {"s": 26.99, "e": 27.971, "t": "Doctors call it lip"}, {"s": 27.971, "e": 29.507, "t": "licker's dermatitis."}, {"s": 29.507, "e": 30.659, "t": "A plain lip balm"}, {"s": 30.659, "e": 32.067, "t": "or petroleum jelly works"}, {"s": 32.067, "e": 33.091, "t": "much better."}, {"s": 33.091, "e": 33.987, "t": "Kids often get a"}, {"s": 33.987, "e": 34.841, "t": "red ring around their"}, {"s": 34.841, "e": 35.993, "t": "mouth from licking,"}, {"s": 35.993, "e": 37.059, "t": "and doctors see it"}, {"s": 37.059, "e": 38.083, "t": "every winter."}, {"s": 41.363, "e": 41.918, "t": "Do you lick your"}, {"s": 41.918, "e": 42.729, "t": "lips?"}, {"s": 42.729, "e": 43.667, "t": "Comment below,"}, {"s": 43.667, "e": 44.947, "t": "and subscribe for more!"}]