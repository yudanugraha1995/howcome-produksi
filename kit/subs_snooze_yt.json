[{"s": 0.72, "e": 1.62, "t": "Beep beep beep."}, {"s": 2.04, "e": 2.76, "t": "Snooze."}, {"s": 3.14, "e": 3.98, "t": "Beep beep beep."}, {"s": 4.34, "e": 5.12, "t": "Snooze again."}, {"s": 5.36, "e": 5.84, "t": "What if you hit"}, {"s": 5.94, "e": 7.32, "t": "snooze every single morning?"}, {"s": 7.46, "e": 8.14, "t": "Is it ruining your"}, {"s": 8.16, "e": 8.48, "t": "brain,"}, {"s": 8.64, "e": 9.32, "t": "or is it totally"}, {"s": 9.36, "e": 9.66, "t": "fine?"}, {"s": 26.316, "e": 26.996, "t": "You're not alone."}, {"s": 27.116, "e": 27.876, "t": "In one survey,"}, {"s": 27.996, "e": 28.876, "t": "about seven in ten"}, {"s": 28.956, "e": 29.976, "t": "people said they snooze"}, {"s": 30.016, "e": 30.956, "t": "at least sometimes,"}, {"s": 31.116, "e": 32.196, "t": "often for twenty minutes"}, {"s": 32.235, "e": 32.716, "t": "or more."}, {"s": 49.272, "e": 50.172, "t": "Snoozing gets a bad"}, {"s": 50.212, "e": 51.172, "t": "name because your sleep"}, {"s": 51.212, "e": 51.912, "t": "keeps breaking."}, {"s": 52.032, "e": 53.092, "t": "And that groggy feeling"}, {"s": 53.132, "e": 53.612, "t": "is real."}, {"s": 53.752, "e": 55.052, "t": "It's called sleep inertia."}, {"s": 71.548, "e": 72.768, "t": "But scientists tested it."}, {"s": 72.888, "e": 73.908, "t": "People snoozed for thirty"}, {"s": 74.008, "e": 74.288, "t": "minutes,"}, {"s": 74.428, "e": 75.468, "t": "then took brain tests."}, {"s": 75.608, "e": 77.008, "t": "Their sleep barely changed,"}, {"s": 77.068, "e": 77.868, "t": "and their thinking was"}, {"s": 77.948, "e": 78.628, "t": "just as good,"}, {"s": 78.768, "e": 79.588, "t": "sometimes even a bit"}, {"s": 79.708, "e": 80.088, "t": "sharper,"}, {"s": 80.188, "e": 80.868, "t": "than people who got"}, {"s": 80.928, "e": 81.608, "t": "up right away."}, {"s": 81.788, "e": 82.768, "t": "Their stress hormone in"}, {"s": 82.808, "e": 83.808, "t": "the morning looked normal"}, {"s": 83.848, "e": 84.148, "t": "too."}, {"s": 84.348, "e": 85.408, "t": "So thos