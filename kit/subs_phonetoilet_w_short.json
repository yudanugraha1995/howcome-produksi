[{"s": 0.0, "e": 0.761, "t": "What if you used"}, {"s": 0.761, "e": 1.486, "t": "your phone on the"}, {"s": 1.486, "e": 2.979, "t": "toilet every day?"}, {"s": 5.803, "e": 7.083, "t": "Surveys suggest more than"}, {"s": 7.083, "e": 8.065, "t": "half of people take"}, {"s": 8.065, "e": 8.875, "t": "their phone into the"}, {"s": 8.875, "e": 9.771, "t": "bathroom."}, {"s": 9.771, "e": 10.411, "t": "It's how a lot"}, {"s": 10.411, "e": 11.265, "t": "of people pass the"}, {"s": 11.265, "e": 12.246, "t": "time."}, {"s": 12.246, "e": 13.057, "t": "People who bring their"}, {"s": 13.057, "e": 14.379, "t": "phone often sit several"}, {"s": 14.379, "e": 16.299, "t": "minutes longer without noticing."}, {"s": 19.123, "e": 20.446, "t": "But here's the twist."}, {"s": 20.446, "e": 21.939, "t": "Sitting longer puts extra"}, {"s": 21.939, "e": 22.75, "t": "pressure on the veins"}, {"s": 22.75, "e": 23.731, "t": "down there and can"}, {"s": 23.731, "e": 24.499, "t": "raise your risk of"}, {"s": 24.499, "e": 25.31, "t": "hemorrhoids,"}, {"s": 25.31, "e": 26.377, "t": "and every flush can"}, {"s": 26.377, "e": 28.297, "t": "spray tiny germs around!"}, {"s": 28.297, "e": 29.577, "t": "Doctors suggest leaving the"}, {"s": 29.577, "e": 30.985, "t": "phone outside and getting"}, {"s": 30.985, "e": 32.051, "t": "up after about five"}, {"s": 32.051, "e": 32.905, "t": "minutes."}, {"s": 32.905, "e": 34.014, "t": "Studies have found phones"}, {"s": 34.014, "e": 35.251, "t": "can carry more bacteria"}, {"s": 35.251, "e": 36.659, "t": "than many toilet seats,"}, {"s": 36.659, "e": 37.641, "t": "so wipe yours down"}, {"s": 37.641, "e": 38.451, "t": "often."}, {"s": 41.275, "e": 41.873, "t": "Do you bring your"}, {"s": 41.873, "e": 42.641, "t": "phone?"}, {"s": 42.641, "e": 43.622, "t": "Comment below,"}, {"s": 43.622, "e": 44.944, "t": "and subscribe for more!"}]