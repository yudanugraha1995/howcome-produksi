[{"s": 0.0, "e": 0.803, "t": "What if you slept"}, {"s": 0.803, "e": 1.785, "t": "with a fan on"}, {"s": 1.785, "e": 2.553, "t": "every night?"}, {"s": 6.289, "e": 6.801, "t": "Fans are one of"}, {"s": 6.801, "e": 7.953, "t": "the most popular sleep"}, {"s": 7.953, "e": 9.361, "t": "hacks on hot nights."}, {"s": 9.361, "e": 10.299, "t": "The breeze and white"}, {"s": 10.299, "e": 11.195, "t": "noise help a lot"}, {"s": 11.195, "e": 12.39, "t": "of people sleep."}, {"s": 12.39, "e": 13.371, "t": "Cool air helps your"}, {"s": 13.371, "e": 14.737, "t": "body drop its temperature,"}, {"s": 14.737, "e": 15.931, "t": "which makes falling asleep"}, {"s": 15.931, "e": 16.913, "t": "easier."}, {"s": 20.649, "e": 21.843, "t": "But here's the twist."}, {"s": 21.843, "e": 22.91, "t": "Moving air can dry"}, {"s": 22.91, "e": 23.849, "t": "out your nose,"}, {"s": 23.849, "e": 24.83, "t": "eyes and throat,"}, {"s": 24.83, "e": 26.281, "t": "and blow dust around,"}, {"s": 26.281, "e": 27.305, "t": "so allergies can get"}, {"s": 27.305, "e": 28.03, "t": "worse."}, {"s": 28.03, "e": 29.139, "t": "And fan death?"}, {"s": 29.139, "e": 30.462, "t": "That's just a myth!"}, {"s": 30.462, "e": 31.486, "t": "Clean the fan blades"}, {"s": 31.486, "e": 32.297, "t": "and point it away"}, {"s": 32.297, "e": 33.406, "t": "from your face."}, {"s": 33.406, "e": 34.643, "t": "If you have allergies,"}, {"s": 34.643, "e": 35.326, "t": "a fan with a"}, {"s": 35.326, "e": 36.222, "t": "filter or an air"}, {"s": 36.222, "e": 37.673, "t": "purifier can help."}, {"s": 41.409, "e": 42.731, "t": "Fan or no fan?"}, {"s": 42.731, "e": 43.585, "t": "Comment below,"}, {"s": 43.585, "e": 44.95, "t": "and subscribe for more!"}]