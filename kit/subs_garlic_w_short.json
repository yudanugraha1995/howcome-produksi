[{"s": 0.0, "e": 0.846, "t": "What if you ate"}, {"s": 0.846, "e": 2.553, "t": "garlic every day?"}, {"s": 6.801, "e": 7.825, "t": "Garlic is related to"}, {"s": 7.825, "e": 8.422, "t": "onions,"}, {"s": 8.422, "e": 9.83, "t": "leeks and chives."}, {"s": 9.83, "e": 10.811, "t": "Your breath might scare"}, {"s": 10.811, "e": 12.049, "t": "people away."}, {"s": 12.049, "e": 12.902, "t": "Garlic has been used"}, {"s": 12.902, "e": 14.139, "t": "in cooking and medicine"}, {"s": 14.139, "e": 15.718, "t": "for thousands of years."}, {"s": 19.966, "e": 21.374, "t": "But here's the twist."}, {"s": 21.374, "e": 22.526, "t": "Garlic smell comes from"}, {"s": 22.526, "e": 23.635, "t": "compounds that get into"}, {"s": 23.635, "e": 24.958, "t": "your blood and lungs,"}, {"s": 24.958, "e": 25.513, "t": "so you breathe it"}, {"s": 25.513, "e": 26.707, "t": "out for hours,"}, {"s": 26.707, "e": 27.561, "t": "even after brushing your"}, {"s": 27.561, "e": 28.457, "t": "teeth!"}, {"s": 28.457, "e": 29.395, "t": "Eating an apple or"}, {"s": 29.395, "e": 30.675, "t": "drinking milk with garlic"}, {"s": 30.675, "e": 32.297, "t": "may reduce the smell."}, {"s": 32.297, "e": 32.723, "t": "Raw,"}, {"s": 32.723, "e": 33.961, "t": "chopped garlic gives off"}, {"s": 33.961, "e": 34.729, "t": "even more of those"}, {"s": 34.729, "e": 36.094, "t": "smelly compounds than cooked"}, {"s": 36.094, "e": 36.905, "t": "garlic."}, {"s": 41.153, "e": 42.518, "t": "Do you love garlic?"}, {"s": 42.518, "e": 43.542, "t": "Comment below,"}, {"s": 43.542, "e": 44.95, "t": "and subscribe for more!"}]