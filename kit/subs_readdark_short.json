[{"s": 0.24, "e": 0.84, "t": "What if you read"}, {"s": 0.86, "e": 1.66, "t": "in the dark every"}, {"s": 1.74, "e": 1.98, "t": "night?"}, {"s": 2.38, "e": 3.3, "t": "Mom always said you'd"}, {"s": 3.36, "e": 4.24, "t": "ruin your eyes!"}, {"s": 5.705, "e": 6.325, "t": "Good news."}, {"s": 6.645, "e": 7.825, "t": "Eye doctors say dim"}, {"s": 7.885, "e": 8.965, "t": "light won't damage your"}, {"s": 9.005, "e": 9.705, "t": "eyes for good."}, {"s": 9.965, "e": 10.585, "t": "It just makes them"}, {"s": 10.625, "e": 11.145, "t": "work harder,"}, {"s": 11.265, "e": 12.165, "t": "so they feel tired"}, {"s": 12.185, "e": 12.745, "t": "and blurry."}, {"s": 14.07, "e": 15.11, "t": "You also blink less"}, {"s": 15.13, "e": 15.89, "t": "when you focus,"}, {"s": 15.99, "e": 16.83, "t": "so your eyes dry"}, {"s": 16.91, "e": 17.07, "t": "out."}, {"s": 17.33, "e": 18.25, "t": "Rest them every twenty"}, {"s": 18.35, "e": 19.29, "t": "minutes and they bounce"}, {"s": 19.33, "e": 19.87, "t": "right back."}, {"s": 21.195, "e": 21.975, "t": "Plot twist!"}, {"s": 22.235, "e": 23.195, "t": "The real risk is"}, {"s": 23.275, "e": 24.255, "t": "staying indoors."}, {"s": 24.535, "e": 25.475, "t": "Kids who play outside"}, {"s": 25.535, "e": 26.415, "t": "every day are less"}, {"s": 26.475, "e": 27.775, "t": "likely to need glasses!"}, {"s": 29.16, "e": 29.72, "t": "Lamp on,"}, {"s": 30.0, "e": 30.68, "t": "or reading in the"}, {"s": 30.7, "e": 31.04, "t": "dark?"}, {"s": 31.34, "e": 31.76, "t": "Tell me in the"}, {"s": 31.8, "e": 32.28, "t": "comments!"}]