[{"s": 0.0, "e": 0.803, "t": "What if you used"}, {"s": 0.803, "e": 2.297, "t": "hand sanitizer all day"}, {"s": 2.297, "e": 3.107, "t": "long?"}, {"s": 7.179, "e": 7.99, "t": "Lots of people keep"}, {"s": 7.99, "e": 8.843, "t": "a little bottle in"}, {"s": 8.843, "e": 9.697, "t": "every bag."}, {"s": 9.697, "e": 11.531, "t": "Alcohol based sanitizer kills"}, {"s": 11.531, "e": 12.299, "t": "most germs on your"}, {"s": 12.299, "e": 13.366, "t": "hands in about thirty"}, {"s": 13.366, "e": 14.262, "t": "seconds."}, {"s": 14.262, "e": 15.286, "t": "Experts say look for"}, {"s": 15.286, "e": 15.969, "t": "one with at least"}, {"s": 15.969, "e": 17.505, "t": "sixty percent alcohol."}, {"s": 21.577, "e": 22.857, "t": "But here's the twist."}, {"s": 22.857, "e": 23.753, "t": "It doesn't work well"}, {"s": 23.753, "e": 24.734, "t": "on greasy or dirty"}, {"s": 24.734, "e": 25.374, "t": "hands,"}, {"s": 25.374, "e": 26.355, "t": "and it struggles against"}, {"s": 26.355, "e": 28.147, "t": "some germs like norovirus,"}, {"s": 28.147, "e": 28.958, "t": "so soap and water"}, {"s": 28.958, "e": 30.153, "t": "is still better."}, {"s": 30.153, "e": 31.305, "t": "Using it constantly can"}, {"s": 31.305, "e": 32.329, "t": "also dry out and"}, {"s": 32.329, "e": 33.523, "t": "crack your skin."}, {"s": 33.523, "e": 34.462, "t": "Washing with soap for"}, {"s": 34.462, "e": 35.998, "t": "twenty seconds physically rinses"}, {"s": 35.998, "e": 37.193, "t": "germs away."}, {"s": 41.265, "e": 42.758, "t": "Sanitizer or soap?"}, {"s": 42.758, "e": 43.611, "t": "Comment below,"}, {"s": 43.611, "e": 44.934, "t": "and subscribe for more!"}]