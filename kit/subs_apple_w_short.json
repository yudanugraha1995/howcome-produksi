[{"s": 0.0, "e": 0.675, "t": "What if you ate"}, {"s": 0.675, "e": 2.339, "t": "an apple every day?"}, {"s": 7.323, "e": 8.049, "t": "Apples are one of"}, {"s": 8.049, "e": 9.201, "t": "the most popular fruits"}, {"s": 9.201, "e": 10.225, "t": "in America."}, {"s": 10.225, "e": 11.035, "t": "Does it really keep"}, {"s": 11.035, "e": 12.273, "t": "the doctor away?"}, {"s": 12.273, "e": 13.126, "t": "The saying comes from"}, {"s": 13.126, "e": 14.278, "t": "an old Welsh rhyme"}, {"s": 14.278, "e": 15.771, "t": "from the eighteen hundreds."}, {"s": 20.755, "e": 22.078, "t": "But here's the twist."}, {"s": 22.078, "e": 23.145, "t": "A study of thousands"}, {"s": 23.145, "e": 24.339, "t": "of adults found apple"}, {"s": 24.339, "e": 25.363, "t": "eaters didn't visit the"}, {"s": 25.363, "e": 26.643, "t": "doctor much less,"}, {"s": 26.643, "e": 27.582, "t": "but they did use"}, {"s": 27.582, "e": 29.246, "t": "fewer prescription medicines!"}, {"s": 29.246, "e": 30.227, "t": "Apples are packed with"}, {"s": 30.227, "e": 30.782, "t": "fiber,"}, {"s": 30.782, "e": 31.55, "t": "and the skin holds"}, {"s": 31.55, "e": 32.19, "t": "a lot of the"}, {"s": 32.19, "e": 33.171, "t": "good stuff."}, {"s": 33.171, "e": 34.195, "t": "It doesn't prove apples"}, {"s": 34.195, "e": 35.049, "t": "are magic,"}, {"s": 35.049, "e": 35.731, "t": "but they're still a"}, {"s": 35.731, "e": 36.67, "t": "great snack."}, {"s": 41.654, "e": 42.635, "t": "Apple a day?"}, {"s": 42.635, "e": 43.531, "t": "Comment below,"}, {"s": 43.531, "e": 44.939, "t": "and subscribe for more!"}]